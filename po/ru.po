msgid "Cancel"
msgstr "Отмена"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Оценка возможностей"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Обнаружены протоколы захвата, виртуальной клавиатуры и виртуального указателя."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Закрыть"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Настройка"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Подтвердите пароль"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Подключение с другого устройства"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Подключите эту машину к Wi-Fi или Ethernet и откройте окно снова"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Копировать"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "В файле учётных данных отсутствует имя пользователя или пароль"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Рабочий стол"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Службы рабочего стола"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Диагностика"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Каждый параметр здесь меняет реальную конфигурацию или установленную службу."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Всё, что нужно этому рабочему столу; не установлено: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Сервер GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Собственная служба GNOME Удалённый рабочий стол слушает во всех сетях; установите wayland-vnc-grd, чтобы управлять этим"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Захват экрана GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Общие"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "В RealVNC Viewer добавьте подключение к одному из этих адресов. Они работают, пока включён доступ из локальной сети, для любого устройства в той же сети. Не пробрасывайте порт из Интернета."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Установите пакет wayland-vnc, чтобы получить пользовательский юнит systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Обнаружены KWin и интерфейсы порталов захвата/ввода."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin требует оба портальных интерфейса: ScreenCast и RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Комбинации клавиш"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Комбинации клавиш"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Язык"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Разрешить подключение устройствам в той же сети Wi-Fi или LAN. Выключено: только этот компьютер."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Лицензия"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Доступ из локальной сети"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Доступ из локальной сети выключен"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Доступ из локальной сети включён"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Главное меню"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Делает этот рабочий стол Wayland доступным из RealVNC Viewer на телефоне или другом компьютере. Пока вы не включите «Доступ из локальной сети», он слушает только на этом компьютере."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Обнаружены службы захвата и удалённого ввода Mutter; требуется приватная сборка."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Нет"

