#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), аутентификация %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "Интерфейсов захвата/ввода: %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "Рабочих столов: %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s ОТСУТСТВУЕТ, а этому рабочему столу он нужен"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: только этот компьютер. 0.0.0.0: все сети, к которым подключён этот компьютер, без какой-либо другой защиты. Порты 1024 и ниже отклоняются."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Требуется нативный сеанс Wayland; переход на X11 запрещён."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "О программе Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Адрес"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Объявлен"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Все присутствуют"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Применить"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Автоматически (как в системе)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Бэкенд"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Кандидат в бэкенды"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Бэкенд на этом рабочем столе"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Исполняемые файлы"

