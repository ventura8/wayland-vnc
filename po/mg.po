msgid "Yes"
msgstr "Eny"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "ny tambajotra rehetra ifandraisan'ity solosaina ity"

#: src/wayland_vnc/settings_app.py
