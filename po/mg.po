#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), fanamarinana %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d fitaovana fakana/fampidirana"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d birao"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "TSY HITA ny %s ary mila azy ity birao ity"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: ity solosaina ity ihany. 0.0.0.0: ny tambajotra rehetra ifandraisan'ity solosaina ity, tsy misy fefy hafa. Lavina ny seranana 1024 sy ambany."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Ilaina ny fotoam-piasana Wayland tena izy; voarara ny fiverenana amin'ny X11."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Momba ny Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adiresy"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Nambara"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Misy avokoa"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Ampihatra"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Mandeha ho azy (manaraka ny birao)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Backend kandidà"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Backend amin'ity birao ity"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Rakitra binary"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Adiresy sy seranana hihainoana"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Nampiharina ny adiresy sy ny seranana"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Foano"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Fanapahan-kevitra momba ny fahaiza-manao"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Hita ny protokoly fakana, fitendry virtoaly ary tondro virtoaly."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Akatona"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Fikirakirana"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Hamafiso ny teny miafina"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Mifandray avy amin'ny fitaovana hafa"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Ampifandraiso amin'ny Wi-Fi na Ethernet ity milina ity, dia sokafy indray"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Adikao"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Tsy misy anaran'ny mpampiasa na teny miafina ao amin'ny rakitra fanamarinana"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Birao"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Serivisy birao"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Fitiliana"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Ny safidy rehetra eto dia manova ny fikirakirana tena izy na ny serivisy napetraka."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Izay rehetra ilain'ity birao ity; tsy napetraka: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Mpizara GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Ny daemon-an'ny GNOME Birao lavitra mihitsy no mihaino amin'ny tambajotra rehetra; ametraho wayland-vnc-grd mba hifehezana izany"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Fampitana efijery GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Ankapobeny"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Ao amin'ny RealVNC Viewer, ampio fifandraisana amin'ny iray amin'ireto adiresy ireto. Mandeha izy ireo raha mbola velona ny fidirana avy amin'ny tambajotra eo an-toerana, ho an'ny fitaovana rehetra ao amin'ny tambajotra iray. Aza mampita ny seranana avy amin'ny Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Apetraho ny fonosana wayland-vnc mba hahazoana ny singa mpampiasa systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Hita ny KWin sy ny fitaovana vavahady fakana/fampidirana."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "Mila ireo tambajotra portal roa ny KWin: ScreenCast sy RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Hitsin-dàlana fitendry"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Hitsin-dàlana fitendry"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Fiteny"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Avelao hifandray ny fitaovana ao amin'ny Wi-Fi na LAN iray. Vonoina: ity solosaina ity ihany."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Fahazoan-dàlana"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Fidirana avy amin'ny tambajotra eo an-toerana"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Novonoina ny fidirana avy amin'ny tambajotra eo an-toerana"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Navelona ny fidirana avy amin'ny tambajotra eo an-toerana"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menio lehibe"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Mampahazo ity birao Wayland ity avy amin'ny RealVNC Viewer ao amin'ny findainao na solosaina hafa. Mihaino eto amin'ity solosaina ity ihany izy mandra-pandrehitrao ny Fidirana avy amin'ny tambajotra eo an-toerana."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Hita ny serivisy fakana sy fampidirana lavitra Mutter; ilaina ny fananganana manokana."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Tsia"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Tsy nahitana valiny"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Tsy nahitana adiresy tambajotra eo an-toerana"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Tsy misy backend tohanana"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Tsy misy fandikan-teny napetraka, ka mijanona amin'ny teny anglisy ny varavarankely."

