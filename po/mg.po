#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Voatahiry (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Nokendrena"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Mila GTK4 sy libadwaita ny varavarankelin'ny fikirakirana (apetraho ny python3-gi, gir1.2-gtk-4.0 ary gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Mila libadwaita %(needed)s na vaovao kokoa ny varavarankelin'ny fikirakirana; manana %(found)s ity rafitra ity"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Manaraka ny fitenin'ny biraonao ny varavarankely raha tsy misafidy hafa ianao."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Ity desktop ity dia manome VNC amin'ny alalan'ny GNOME Remote Desktop, izay manaiky tenimiafina tsy mihoatra ny 8 tarehintsoratra"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Ny rafitra ao ambadik'ity birao ity dia mihaino amin'ity solosaina ity ihany foana"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Mpizara TigerVNC, ho an'ny KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Andramo fikarohana hafa."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Soraty ireto ao amin'ny RealVNC Viewer amin'ny fitaovana hafa. Ampiasao ny maso mba hampisehoana ny teny miafina ankehitriny. Voatahiry amin'ny fomba 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Anaran'ny mpampiasa"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Tsy maintsy ASCII azo atonta ny anaran'ny mpampiasa"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Fanapahan-kevitra"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Fanamarinana mpijery"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Voatahiry ny teny miafin'ny mpijery"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Mpizara WayVNC, ho an'ny mpanangona wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Protokoly Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Izay ambaran'ity birao ity, ary ny dikan'izany ho an'ny fidirana lavitra."

