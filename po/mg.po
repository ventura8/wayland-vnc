#, python-format
msgid "mode %s (too open)"
msgstr "fomba %s (misokatra loatra)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "fomba 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "ity milina ity ihany"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "tsy napetraka ny singa"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "tsy fantatra"

#: src/wayland_vnc/settings.py
