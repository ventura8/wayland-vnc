msgid "Password"
msgstr "Teny miafina"

#: src/wayland_vnc/runtime.py
msgid "Password must be 6-64 ASCII characters"
msgstr "Tsy maintsy 6–64 tarehintsoratra ASCII ny teny miafina"

#: src/wayland_vnc/settings_dialogs.py src/wayland_vnc/runtime.py
msgid "Passwords did not match"
msgstr "Tsy mifanaraka ny teny miafina"

#: src/wayland_vnc/settings_dialogs.py
msgid "Port"
msgstr "Seranana"

#: src/wayland_vnc/runtime.py
msgid "Port must be an unprivileged TCP port"
msgstr "Tsy maintsy seranana TCP tsy manana tombontsoa ny seranana"

#: src/wayland_vnc/settings.py
msgid "Portals"
msgstr "Vavahady"

#: src/wayland_vnc/settings_dialogs.py
msgid "Project Website"
msgstr "Tranonkalan'ny tetikasa"

