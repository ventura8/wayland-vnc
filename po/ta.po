msgid "Reason"
msgstr "காரணம்"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "வெளியீட்டு இலக்குகள்"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "RemoteDesktop போர்ட்டல்"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "சிக்கலைப் புகாரளிக்கவும்"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "தேவையான பிடிப்பு மற்றும் உள்ளீட்டுத் திறன்கள் கண்டறியப்படவில்லை."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "இப்போது இயங்குகிறது"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "சேமி"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "ScreenCast போர்ட்டல்"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
msgstr "தேடு"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search diagnostics"
msgstr "பிழையறிதலைத் தேடு"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search languages"
msgstr "மொழிகளைத் தேடு"

#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "GNOME Remote Desktop VNC (போர்ட் 5900) மூலம் வழங்கப்படுகிறது; வெளிப்பாடு GNOME Settings > Sharing-ஐப் பின்பற்றும்"

#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "சேவையக கட்டமைப்பு"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "சேவை"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "அமர்வு"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "அமர்வு வகை"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "கடவுச்சொல்லை அமை"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "பார்வையாளர் கடவுச்சொல்லை அமை"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "முதலில் பார்வையாளர் கடவுச்சொல்லை அமைக்கவும்"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "உள்நுழையும்போது தொடங்கு"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "நிலை"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "சேமிக்கப்பட்டது (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "இலக்கிடப்பட்டது"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "அமைப்புகள் சாளரத்திற்கு GTK4 மற்றும் libadwaita தேவை (python3-gi, gir1.2-gtk-4.0 மற்றும் gir1.2-adw-1 ஐ நிறுவவும்)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "அமைப்புகள் சாளரத்திற்கு libadwaita %(needed)s அல்லது புதியது தேவை; இந்த கணினியில் %(found)s உள்ளது"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "நீங்கள் வேறொன்றைத் தேர்ந்தெடுக்காத வரை சாளரம் உங்கள் டெஸ்க்டாப்பின் மொழியைப் பின்பற்றும்."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "இந்த டெஸ்க்டாப் GNOME Remote Desktop வழியாக VNC-ஐ வழங்குகிறது, அது அதிகபட்சம் 8 எழுத்துகள் கொண்ட கடவுச்சொற்களை மட்டுமே ஏற்கும்"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "இந்தப் பணிமேசையின் பின்புலம் எப்போதும் இந்தக் கணினியில் மட்டுமே கேட்கிறது"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC சேவையகம், KDE Plasma-விற்கு"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "வேறு தேடலை முயற்சிக்கவும்."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "இவற்றை மற்ற சாதனத்தில் உள்ள RealVNC Viewer-இல் தட்டச்சு செய்யவும். தற்போதைய கடவுச்சொல்லைக் காட்ட கண்ணைப் பயன்படுத்தவும். முறை 600 உடன் சேமிக்கப்பட்டது."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "பயனர்பெயர்"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "பயனர்பெயர் அச்சிடக்கூடிய ASCII ஆக இருக்க வேண்டும்"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "தீர்ப்பு"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "பார்வையாளர் சான்று"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "பார்வையாளர் கடவுச்சொல் சேமிக்கப்பட்டது"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC சேவையகம், wlroots கம்போசிட்டர்களுக்கு"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland நெறிமுறைகள்"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "இந்த டெஸ்க்டாப் எதை அறிவிக்கிறது, தொலை அணுகலுக்கு அதன் பொருள் என்ன."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "ஆம்"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "இந்தக் கணினி இணைந்துள்ள ஒவ்வொரு பிணையமும்"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "உள் பிணையம் மட்டும்"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS பெயர்"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "முறை %s (மிகவும் திறந்தது)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "முறை 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "இந்த கணினி மட்டும்"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "யூனிட் நிறுவப்படவில்லை"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "தெரியவில்லை"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "Wayland நெறிமுறைகளை ஆய்வு செய்யப் பயன்படுகிறது"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "D-Bus வழியாக போர்ட்டல்களை ஆய்வு செய்யப் பயன்படுகிறது"

#~ msgid "Qualification"
#~ msgstr "தகுதி"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "0.0.0.0 உங்கள் உள்ளூர் பிணையத்தில் உள்ள சாதனங்களுக்கு சேவையகத்தை அணுகக்கூடியதாக்கும்; சேவை இணையத்தை இன்னும் தடுக்கும். 127.0.0.1 இதை இந்த கணினிக்கு மட்டும் வரையறுக்கும். 1024 அல்லது அதற்குக் கீழுள்ள போர்ட்டுகள் நிராகரிக்கப்படும்."

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "உள்ளூர் பிணையம் மட்டும்; யூனிட் இணையத்தைத் தடுக்கிறது"
