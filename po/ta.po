#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), அங்கீகாரம் %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d பிடிப்பு/உள்ளீட்டு இடைமுகங்கள்"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d டெஸ்க்டாப்புகள்"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s இல்லை, இந்த டெஸ்க்டாப்பிற்கு அது தேவை"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: இந்தக் கணினி மட்டும். 0.0.0.0: இந்தக் கணினி இணைந்துள்ள ஒவ்வொரு பிணையமும், வேறு எந்த வேலியும் இல்லாமல். 1024 மற்றும் அதற்குக் கீழுள்ள துறைகள் நிராகரிக்கப்படும்."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "ஒரு நேட்டிவ் Wayland அமர்வு தேவை; X11 மாற்று தடைசெய்யப்பட்டுள்ளது."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Wayland VNC பற்றி"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "முகவரி"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "அறிவிக்கப்பட்டது"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "அனைத்தும் உள்ளன"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "பயன்படுத்து"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "தானியங்கி (டெஸ்க்டாப்பிற்கு ஏற்ப)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "பின்புலம்"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "பின்புல வேட்பாளர்"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "இந்த டெஸ்க்டாப்பில் பின்புலம்"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "பைனரிகள்"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "பிணைப்பு முகவரி மற்றும் போர்ட்"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "பிணைப்பு முகவரி மற்றும் போர்ட் பயன்படுத்தப்பட்டன"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "ரத்துசெய்"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "திறன் தீர்ப்பு"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "பிடிப்பு, மெய்நிகர் விசைப்பலகை மற்றும் மெய்நிகர் சுட்டி நெறிமுறைகள் கண்டறியப்பட்டன."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "மூடு"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "கட்டமைப்பு"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "கடவுச்சொல்லை உறுதிப்படுத்து"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "மற்றொரு சாதனத்திலிருந்து இணைக்கவும்"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "இந்த கணினியை Wi-Fi அல்லது ஈதர்நெட்டுடன் இணைத்து, பின்னர் மீண்டும் திறக்கவும்"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "நகலெடு"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "சான்று கோப்பில் பயனர்பெயர் அல்லது கடவுச்சொல் இல்லை"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "டெஸ்க்டாப்"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "டெஸ்க்டாப் சேவைகள்"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "பிழையறிதல்"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "இங்குள்ள ஒவ்வொரு விருப்பமும் உண்மையான கட்டமைப்பை அல்லது நிறுவப்பட்ட சேவையை மாற்றும்."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "இந்த டெஸ்க்டாப்பிற்குத் தேவையான அனைத்தும்; நிறுவப்படாதவை: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop சேவையகம்"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME தொலை பணிமேசையின் சொந்த டீமன் ஒவ்வொரு பிணையத்திலும் கேட்கிறது; இதைக் கட்டுப்படுத்த wayland-vnc-grd ஐ நிறுவவும்"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME Screencast"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "பொது"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "RealVNC Viewer இல் இந்த முகவரிகளில் ஒன்றுக்கு இணைப்பைச் சேர்க்கவும். உள் பிணைய அணுகல் இயக்கத்தில் இருக்கும் வரை, அதே பிணையத்தில் உள்ள எந்தச் சாதனத்திற்கும் இவை வேலை செய்யும். துறையை இணையத்திலிருந்து முன்னனுப்ப வேண்டாம்."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "systemd பயனர் யூனிட்டைப் பெற wayland-vnc தொகுப்பை நிறுவவும்"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin மற்றும் பிடிப்பு/உள்ளீட்டு போர்ட்டல் இடைமுகங்கள் கண்டறியப்பட்டன."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin-க்கு ScreenCast மற்றும் RemoteDesktop ஆகிய இரு போர்ட்டல் இடைமுகங்களும் தேவை."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "விசைப்பலகை குறுக்குவழிகள்"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "விசைப்பலகை குறுக்குவழிகள்"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "மொழி"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "அதே Wi-Fi அல்லது LAN இல் உள்ள சாதனங்களை இணைய அனுமதிக்கவும். அணைக்கப்பட்டது: இந்தக் கணினி மட்டும்."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "உரிமம்"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "உள் பிணையத்திலிருந்து அணுகல்"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "உள் பிணையத்திலிருந்து அணுகல் அணைக்கப்பட்டது"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "உள் பிணையத்திலிருந்து அணுகல் இயக்கப்பட்டது"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "முதன்மை மெனு"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "இந்த Wayland டெஸ்க்டாப்பை உங்கள் தொலைபேசி அல்லது மற்றொரு கணினியில் உள்ள RealVNC Viewer-இலிருந்து அணுகக்கூடியதாக்கும். நீங்கள் உள் பிணையத்திலிருந்து அணுகலை இயக்கும் வரை, இது இந்தக் கணினியில் மட்டுமே கேட்கிறது."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter பிடிப்பு மற்றும் தொலை-உள்ளீட்டு சேவைகள் கண்டறியப்பட்டன; தனிப்பட்ட கட்டமைப்பு தேவை."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "இல்லை"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "முடிவுகள் எதுவும் இல்லை"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "உள்ளூர் பிணைய முகவரி எதுவும் இல்லை"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "ஆதரிக்கப்படும் பின்புலம் இல்லை"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "மொழிபெயர்ப்புகள் எதுவும் நிறுவப்படவில்லை, எனவே சாளரம் ஆங்கிலத்திலேயே இருக்கும்."

