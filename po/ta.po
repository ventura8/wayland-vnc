msgid "Quit"
msgstr "வெளியேறு"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "நிறுவத் தயார்"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, ஒரு கிளையன்ட்; சேவை வழங்கத் தேவையில்லை"

