#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "ਟੀਚਾਬੱਧ"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "ਸੈਟਿੰਗਾਂ ਵਿੰਡੋ ਨੂੰ GTK4 ਅਤੇ libadwaita ਦੀ ਲੋੜ ਹੈ (python3-gi, gir1.2-gtk-4.0 ਅਤੇ gir1.2-adw-1 ਇੰਸਟਾਲ ਕਰੋ)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "ਸੈਟਿੰਗਾਂ ਵਿੰਡੋ ਨੂੰ libadwaita %(needed)s ਜਾਂ ਨਵਾਂ ਚਾਹੀਦਾ ਹੈ; ਇਸ ਸਿਸਟਮ 'ਤੇ %(found)s ਹੈ"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਕੋਈ ਹੋਰ ਨਹੀਂ ਚੁਣਦੇ, ਵਿੰਡੋ ਤੁਹਾਡੇ ਡੈਸਕਟਾਪ ਦੀ ਭਾਸ਼ਾ ਵਰਤਦੀ ਹੈ।"

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "ਇਹ ਡੈਸਕਟਾਪ GNOME Remote Desktop ਰਾਹੀਂ VNC ਦਿੰਦਾ ਹੈ, ਜੋ ਵੱਧ ਤੋਂ ਵੱਧ 8 ਅੱਖਰਾਂ ਦੇ ਪਾਸਵਰਡ ਸਵੀਕਾਰ ਕਰਦਾ ਹੈ"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "ਇਸ ਡੈਸਕਟਾਪ ਦਾ ਬੈਕਐਂਡ ਹਮੇਸ਼ਾ ਸਿਰਫ਼ ਇਸੇ ਕੰਪਿਊਟਰ 'ਤੇ ਸੁਣਦਾ ਹੈ"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC ਸਰਵਰ, KDE Plasma ਲਈ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "ਕੋਈ ਹੋਰ ਖੋਜ ਅਜ਼ਮਾਓ।"

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "ਇਹ ਦੂਜੇ ਡਿਵਾਈਸ 'ਤੇ RealVNC Viewer ਵਿੱਚ ਟਾਈਪ ਕਰੋ। ਮੌਜੂਦਾ ਪਾਸਵਰਡ ਦਿਖਾਉਣ ਲਈ ਅੱਖ ਵਰਤੋ। ਮੋਡ 600 ਨਾਲ ਸਟੋਰ ਕੀਤਾ।"

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "ਵਰਤੋਂਕਾਰ ਨਾਮ"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "ਵਰਤੋਂਕਾਰ ਨਾਮ ਛਪਣਯੋਗ ASCII ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "ਫ਼ੈਸਲਾ"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "ਵਿਊਅਰ ਕ੍ਰੈਡੈਂਸ਼ੀਅਲ"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "ਵਿਊਅਰ ਪਾਸਵਰਡ ਸੰਭਾਲਿਆ"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC ਸਰਵਰ, wlroots ਕੰਪੋਜ਼ੀਟਰਾਂ ਲਈ"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland ਪ੍ਰੋਟੋਕੋਲ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "ਇਹ ਡੈਸਕਟਾਪ ਕੀ ਐਲਾਨਦਾ ਹੈ, ਅਤੇ ਰਿਮੋਟ ਪਹੁੰਚ ਲਈ ਇਸਦਾ ਕੀ ਮਤਲਬ ਹੈ।"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "ਹਾਂ"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "ਹਰ ਉਹ ਨੈੱਟਵਰਕ ਜਿਸ ਨਾਲ ਇਹ ਕੰਪਿਊਟਰ ਜੁੜਿਆ ਹੈ"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "ਸਿਰਫ਼ ਲੋਕਲ ਨੈੱਟਵਰਕ"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS ਨਾਂ"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "ਮੋਡ %s (ਬਹੁਤ ਖੁੱਲ੍ਹਾ)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "ਮੋਡ 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "ਸਿਰਫ਼ ਇਹ ਮਸ਼ੀਨ"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "ਯੂਨਿਟ ਇੰਸਟਾਲ ਨਹੀਂ"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "ਅਣਜਾਣ"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "Wayland ਪ੍ਰੋਟੋਕੋਲ ਜਾਂਚਣ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "D-Bus ਰਾਹੀਂ ਪੋਰਟਲ ਜਾਂਚਣ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ"

#~ msgid "Qualification"
#~ msgstr "ਯੋਗਤਾ"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "0.0.0.0 ਸਰਵਰ ਨੂੰ ਤੁਹਾਡੇ ਸਥਾਨਕ ਨੈੱਟਵਰਕ ਦੇ ਡਿਵਾਈਸਾਂ ਲਈ ਪਹੁੰਚਯੋਗ ਬਣਾਉਂਦਾ ਹੈ; ਸੇਵਾ ਅਜੇ ਵੀ ਇੰਟਰਨੈੱਟ ਰੋਕਦੀ ਹੈ। 127.0.0.1 ਇਸਨੂੰ ਇਸ ਮਸ਼ੀਨ ਤੱਕ ਸੀਮਤ ਕਰਦਾ ਹੈ। ਪੋਰਟ 1024 ਅਤੇ ਹੇਠਲੇ ਰੱਦ ਕੀਤੇ ਜਾਂਦੇ ਹਨ।"

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "ਸਿਰਫ਼ ਸਥਾਨਕ ਨੈੱਟਵਰਕ; ਯੂਨਿਟ ਨੇ ਇੰਟਰਨੈੱਟ ਰੋਕਿਆ"
