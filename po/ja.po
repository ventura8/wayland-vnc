msgid "mDNS name"
msgstr "mDNS 名"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "モード %s（権限が緩すぎます）"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "モード 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "このマシンのみ"

#: src/wayland_vnc/settings.py
