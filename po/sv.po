#, python-format
msgid "Stored (%s)"
msgstr "Sparat (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Målsatt"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Inställningsfönstret behöver GTK4 och libadwaita (installera python3-gi, gir1.2-gtk-4.0 och gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Inställningsfönstret behöver libadwaita %(needed)s eller nyare; det här systemet har %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Fönstret följer ditt skrivbords språk om du inte väljer ett annat."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Detta skrivbord serverar VNC via GNOME Remote Desktop, som godtar lösenord på högst 8 tecken"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Det här skrivbordets bakände lyssnar alltid bara på den här datorn"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC-server, för KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Prova en annan sökning."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Skriv in dessa i RealVNC Viewer på den andra enheten. Använd ögat för att visa det nuvarande lösenordet. Sparat med läge 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Användarnamn"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Användarnamnet måste vara utskrivbar ASCII"

