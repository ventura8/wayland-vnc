#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autentisering %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d gränssnitt för inspelning/inmatning"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d skrivbord"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s SAKNAS och det här skrivbordet behöver det"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: endast den här datorn. 0.0.0.0: alla nätverk som den här datorn är ansluten till, utan något annat skydd. Portar på 1024 och lägre avvisas."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "En inbyggd Wayland-session krävs; återgång till X11 är förbjuden."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Om Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adress"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Annonserad"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Alla finns"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Verkställ"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatiskt (följ skrivbordet)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Bakände"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Kandidat till bakände"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Bakände på det här skrivbordet"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binärfiler"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Lyssningsadress och -port"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adress och port verkställda"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Avbryt"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Bedömning av funktioner"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Protokoll för inspelning, virtuellt tangentbord och virtuell pekare hittades."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Stäng"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Konfiguration"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Bekräfta lösenord"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Anslut från en annan enhet"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Anslut den här datorn till wifi eller Ethernet och öppna sedan igen"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopiera"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Filen med inloggningsuppgifter saknar användarnamn eller lösenord"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Skrivbord"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Skrivbordstjänster"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostik"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Varje alternativ här ändrar verklig konfiguration eller den installerade tjänsten."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Allt det här skrivbordet behöver; inte installerat: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop-server"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME Fjärrskrivbords egen demon lyssnar på alla nätverk; installera wayland-vnc-grd för att styra detta"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME-skärmsändning"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Allmänt"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Lägg i RealVNC Viewer till en anslutning till en av dessa adresser. De fungerar så länge åtkomst från det lokala nätverket är på, för alla enheter i samma nätverk. Vidarebefordra inte porten från internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installera paketet wayland-vnc för att få systemd-användarenheten"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin och portalgränssnitt för inspelning/inmatning hittades."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin kräver båda portalgränssnitten: ScreenCast och RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Tangentbordsgenvägar"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Tangentbordsgenvägar"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Språk"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Låt enheter på samma Wi-Fi eller LAN ansluta. Av: endast den här datorn."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licens"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Åtkomst från lokalt nätverk"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Åtkomst från lokalt nätverk avstängd"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Åtkomst från lokalt nätverk påslagen"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Huvudmeny"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Gör det här Wayland-skrivbordet nåbart från RealVNC Viewer på din telefon eller en annan dator. Den lyssnar bara på den här datorn tills du slår på Åtkomst från lokalt nätverk."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter-tjänster för inspelning och fjärrinmatning hittades; privat bygge krävs."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Nej"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Inga resultat hittades"

