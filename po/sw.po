#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), uthibitishaji %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "Miingiliano %d ya kunasa/kuingiza"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "Eneo-kazi %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s HAIPO na eneo-kazi hili linaihitaji"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: kompyuta hii pekee. 0.0.0.0: mitandao yote ambayo kompyuta hii imeunganishwa nayo, bila uzio mwingine wowote. Milango 1024 na chini yake inakataliwa."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Kipindi asilia cha Wayland kinahitajika; kurudi kwa X11 kumepigwa marufuku."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Kuhusu Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Anwani"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Imetangazwa"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Zote zipo"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Tumia"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Kiotomatiki (fuata eneo-kazi)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Injini"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Injini mtarajiwa"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Injini kwenye eneo-kazi hili"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Faili za kutekelezwa"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Anwani na mlango wa kusikiliza"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Anwani na mlango vimetumika"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Ghairi"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Uamuzi wa uwezo"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Itifaki za kunasa, kibodi pepe na kielekezi pepe zimegunduliwa."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Funga"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Usanidi"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Thibitisha nenosiri"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Unganisha kutoka kifaa kingine"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Unganisha mashine hii kwenye Wi-Fi au Ethaneti, kisha fungua tena"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Nakili"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Faili la vitambulisho halina jina la mtumiaji au nenosiri"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Eneo-kazi"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Huduma za eneo-kazi"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Uchunguzi"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Kila chaguo hapa hubadilisha usanidi halisi au huduma iliyosakinishwa."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Kila kitu eneo-kazi hili linahitaji; hakijasakinishwa: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Seva ya GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Daemon ya GNOME Eneo-kazi la Mbali yenyewe inasikiliza kwenye kila mtandao; sakinisha wayland-vnc-grd ili kudhibiti hili"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Utangazaji skrini wa GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Jumla"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Katika RealVNC Viewer, ongeza muunganisho kwa mojawapo ya anwani hizi. Zinafanya kazi wakati ufikiaji kutoka mtandao wa ndani umewashwa, kwa kifaa chochote kwenye mtandao huo huo. Usipeleke mlango kutoka kwenye Intaneti."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Sakinisha kifurushi cha wayland-vnc ili kupata kitengo cha mtumiaji cha systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin na violesura vya lango la kunasa/kuingiza vimegunduliwa."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin inahitaji violesura vyote viwili vya lango: ScreenCast na RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Njia za Mkato za Kibodi"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Njia za mkato za kibodi"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Lugha"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Ruhusu vifaa kwenye Wi-Fi au LAN ile ile kuunganisha. Imezimwa: kompyuta hii pekee."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Leseni"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Ufikiaji kutoka mtandao wa ndani"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Ufikiaji kutoka mtandao wa ndani umezimwa"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Ufikiaji kutoka mtandao wa ndani umewashwa"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menyu Kuu"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Hufanya eneo-kazi hili la Wayland lifikike kutoka RealVNC Viewer kwenye simu yako au kompyuta nyingine. Husikiliza kwenye kompyuta hii pekee hadi uwashe Ufikiaji kutoka mtandao wa ndani."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Huduma za kunasa na kuingiza kwa mbali za Mutter zimegunduliwa; muundo wa faragha unahitajika."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Hapana"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Hakuna matokeo yaliyopatikana"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Hakuna anwani ya mtandao wa ndani iliyopatikana"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Hakuna injini inayoungwa mkono"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Hakuna tafsiri zilizosakinishwa, hivyo dirisha linabaki Kiingereza."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "None"
msgstr "Hakuna"

#: src/wayland_vnc/settings.py
msgid "None advertised"
msgstr "Hakuna iliyotangazwa"

#: src/wayland_vnc/settings.py
msgid "None available"
msgstr "Hakuna inayopatikana"

#: src/wayland_vnc/settings.py
msgid "None checked"
msgstr "Hakuna iliyokaguliwa"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "None detected"
msgstr "Hakuna iliyogunduliwa"

#: src/wayland_vnc/settings.py
msgid "Not advertised"
msgstr "Haijatangazwa"

#: src/wayland_vnc/settings.py
msgid "Not checked"
msgstr "Haijakaguliwa"

