msgid "Open the main menu"
msgstr "Fungua menyu kuu"

#: src/wayland_vnc/settings_app.py
msgid "PUBLIC ADDRESS - reachable beyond the local network"
msgstr "ANWANI YA UMMA - inafikika nje ya mtandao wa ndani"

#: src/wayland_vnc/settings_dialogs.py
msgid "Password"
msgstr "Nenosiri"

#: src/wayland_vnc/runtime.py
msgid "Password must be 6-64 ASCII characters"
msgstr "Nenosiri lazima liwe na herufi 6 hadi 64 za ASCII"

#: src/wayland_vnc/settings_dialogs.py src/wayland_vnc/runtime.py
msgid "Passwords did not match"
msgstr "Manenosiri hayalingani"

#: src/wayland_vnc/settings_dialogs.py
msgid "Port"
msgstr "Mlango"

#: src/wayland_vnc/runtime.py
msgid "Port must be an unprivileged TCP port"
msgstr "Mlango lazima uwe mlango wa TCP usio na upendeleo"

#: src/wayland_vnc/settings.py
msgid "Portals"
msgstr "Lango"

#: src/wayland_vnc/settings_dialogs.py
msgid "Project Website"
msgstr "Tovuti ya mradi"

#: src/wayland_vnc/settings_app.py
msgid "Quit"
msgstr "Toka"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Tayari kusakinishwa"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, mteja; haihitajiki kutoa huduma"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Sababu"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Shabaha za toleo"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "Lango la RemoteDesktop"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Ripoti tatizo"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "Uwezo unaohitajika wa kunasa NA kuingiza haukugunduliwa."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "Inaendesha sasa"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "Hifadhi"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "Lango la ScreenCast"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
msgstr "Tafuta"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search diagnostics"
msgstr "Tafuta katika uchunguzi"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search languages"
msgstr "Tafuta lugha"

#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "Inahudumiwa na GNOME Remote Desktop VNC (mlango 5900); ufikiaji hufuata Mipangilio ya GNOME > Kushiriki"

#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "Usanidi wa seva"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "Huduma"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "Kipindi"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "Aina ya kipindi"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "Weka Nenosiri"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "Weka nenosiri la kitazamaji"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "Weka nenosiri la kitazamaji kwanza"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "Anza unapoingia"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Hali"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Limehifadhiwa (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Imelengwa"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Dirisha la mipangilio linahitaji GTK4 na libadwaita (sakinisha python3-gi, gir1.2-gtk-4.0 na gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Dirisha la mipangilio linahitaji libadwaita %(needed)s au mpya zaidi; mfumo huu una %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Dirisha hufuata lugha ya eneo-kazi lako isipokuwa uchague nyingine."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Eneo-kazi hili hutoa VNC kupitia GNOME Remote Desktop, inayokubali nywila za herufi 8 kwa juu zaidi"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Sehemu ya nyuma ya eneo-kazi hili husikiliza kwenye kompyuta hii pekee daima"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Seva ya TigerVNC, kwa KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Jaribu utafutaji mwingine."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Andika haya katika RealVNC Viewer kwenye kifaa kingine. Tumia alama ya jicho kuonyesha nenosiri la sasa. Limehifadhiwa kwa hali ya 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Jina la mtumiaji"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Jina la mtumiaji lazima liwe ASCII inayochapishika"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Uamuzi"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Vitambulisho vya kitazamaji"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Nenosiri la kitazamaji limehifadhiwa"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Seva ya WayVNC, kwa vitunzi vya wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Itifaki za Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Kile eneo-kazi hili hutangaza, na maana yake kwa ufikiaji wa mbali."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ndiyo"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "mitandao yote ambayo kompyuta hii imeunganishwa nayo"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "mtandao wa ndani pekee"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "Jina la mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "hali %s (wazi mno)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "hali 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "mashine hii pekee"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "kitengo hakijasakinishwa"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "haijulikani"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "hutumika kuchunguza itifaki za Wayland"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "hutumika kuchunguza lango kupitia D-Bus"

