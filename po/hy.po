#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Կարգավորումների պատուհանին անհրաժեշտ է libadwaita %(needed)s կամ ավելի նոր. այս համակարգն ունի %(found)s"

