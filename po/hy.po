msgstr "Գլխավոր ընտրացանկ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Այս Wayland աշխատասեղանը հասանելի է դարձնում ձեր հեռախոսի կամ այլ համակարգչի RealVNC Viewer-ից։ Քանի դեռ չեք միացրել «Մուտք տեղային ցանցից»-ը, այն լսում է միայն այս համակարգչում։"

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Հայտնաբերվել են Mutter-ի նկարահանման և հեռավոր մուտքագրման ծառայությունները. պահանջվում է մասնավոր կառուցում։"

