#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Այս աշխատասեղանը VNC է սպասարկում GNOME Remote Desktop-ի միջոցով, որն ընդունում է առավելագույնը 8 նիշանոց գաղտնաբառեր"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Այս աշխատասեղանի հետնամասը միշտ լսում է միայն այս համակարգչում"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC սերվեր՝ KDE Plasma-ի համար"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Փորձեք այլ որոնում։"

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Մուտքագրեք սրանք RealVNC Viewer-ում մյուս սարքի վրա։ Օգտագործեք աչքը՝ ընթացիկ գաղտնաբառը ցուցադրելու համար։ Պահպանված է 600 ռեժիմով։"

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Օգտանուն"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Օգտանունը պետք է լինի տպելի ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Գնահատական"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Դիտողի հավատարմագրեր"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Դիտողի գաղտնաբառը պահպանված է"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC սերվեր՝ wlroots կոմպոզիտորների համար"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland արձանագրություններ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Ինչ է հայտարարում այս աշխատասեղանը, և ինչ է դա նշանակում հեռավար մուտքի համար։"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Այո"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "բոլոր ցանցերը, որոնց միացված է այս համակարգիչը"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "միայն տեղային ցանցը"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS անուն"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "%s ռեժիմ (չափազանց բաց)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "600 ռեժիմ"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "միայն այս մեքենան"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "միավորը տեղադրված չէ"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "անհայտ"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "օգտագործվում է Wayland արձանագրությունները ստուգելու համար"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "օգտագործվում է պորտալները D-Bus-ով ստուգելու համար"

#~ msgid "Qualification"
#~ msgstr "Որակավորում"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "0.0.0.0-ն սերվերը հասանելի է դարձնում ձեր տեղային ցանցի սարքերին. ծառայությունը շարունակում է արգելափակել ինտերնետը։ 127.0.0.1-ը սահմանափակում է այն այս մեքենայով։ 1024 և ցածր պորտերը մերժվում են։"

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "միայն տեղային ցանց. ինտերնետն արգելափակված է միավորով"
