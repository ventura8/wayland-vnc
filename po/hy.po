msgid "Diagnostics"
msgstr "Ախտորոշում"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Այստեղ ամեն տարբերակ փոխում է իրական կազմաձևումը կամ տեղադրված ծառայությունը։"

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Այն ամենը, ինչ պետք է այս աշխատասեղանին. տեղադրված չէ. "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop սերվեր"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME Հեռավոր աշխատասեղանի սեփական դեմոնը լսում է բոլոր ցանցերում. սա կառավարելու համար տեղադրեք wayland-vnc-grd"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME էկրանի հեռարձակում"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Ընդհանուր"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "RealVNC Viewer-ում ավելացրեք միացում այս հասցեներից մեկին։ Դրանք աշխատում են, քանի դեռ տեղային ցանցից մուտքը միացված է, նույն ցանցի ցանկացած սարքի համար։ Մի փոխանցեք պորտը համացանցից։"

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Տեղադրեք wayland-vnc փաթեթը՝ systemd օգտատիրոջ միավորը ստանալու համար"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Հայտնաբերվել են KWin-ը և նկարահանման/մուտքագրման պորտալի միջերեսները։"

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin-ը պահանջում է երկու պորտալ միջերեսներն էլ՝ ScreenCast և RemoteDesktop:"

#: src/wayland_vnc/settings_app.py
