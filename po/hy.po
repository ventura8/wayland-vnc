msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Թույլատրել նույն Wi-Fi-ի կամ LAN-ի սարքերին միանալ։ Անջատված․ միայն այս համակարգիչը։"

