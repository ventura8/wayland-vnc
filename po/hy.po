#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), նույնականացում %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d նկարահանման/մուտքագրման միջերես"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d աշխատասեղան"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s ԲԱՑԱԿԱՅՈՒՄ Է, իսկ այս աշխատասեղանն այն կարիք ունի"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1․ միայն այս համակարգիչը։ 0.0.0.0․ բոլոր ցանցերը, որոնց միացված է այս համակարգիչը, առանց որևէ այլ պաշտպանության։ 1024 և ցածր պորտերը մերժվում են։"

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Պահանջվում է բնիկ Wayland նիստ. X11-ին վերադառնալն արգելված է։"

