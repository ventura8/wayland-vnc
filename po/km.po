#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "ការកំណត់រចនាសម្ព័ន្ធម៉ាស៊ីនមេ"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "សេវាកម្ម"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "សម័យ"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "ប្រភេទសម័យ"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "កំណត់ពាក្យសម្ងាត់"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "កំណត់ពាក្យសម្ងាត់អ្នកមើល"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "កំណត់ពាក្យសម្ងាត់អ្នកមើលជាមុនសិន"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "ចាប់ផ្តើមពេលចូល"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "ស្ថានភាព"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "បានរក្សាទុក (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "បានកំណត់គោលដៅ"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "បង្អួចការកំណត់ត្រូវការ GTK4 និង libadwaita (ដំឡើង python3-gi, gir1.2-gtk-4.0 និង gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "បង្អួចការកំណត់ត្រូវការ libadwaita %(needed)s ឬថ្មីជាង; ប្រព័ន្ធនេះមាន %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "បង្អួចធ្វើតាមភាសាផ្ទៃតុរបស់អ្នក លុះត្រាតែអ្នកជ្រើសរើសផ្សេង។"

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "ផ្ទៃតុនេះផ្ដល់ VNC តាម GNOME Remote Desktop ដែលទទួលពាក្យសម្ងាត់មិនលើសពី 8 តួអក្សរ"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "ផ្នែកខាងក្រោយនៃផ្ទៃតុនេះស្ដាប់តែនៅលើកុំព្យូទ័រនេះជានិច្ច"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "ម៉ាស៊ីនមេ TigerVNC សម្រាប់ KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "សូមសាកល្បងស្វែងរកផ្សេង។"

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "វាយបញ្ចូលទាំងនេះក្នុង RealVNC Viewer នៅលើឧបករណ៍ផ្សេង។ ប្រើភ្នែកដើម្បីបង្ហាញពាក្យសម្ងាត់បច្ចុប្បន្ន។ បានរក្សាទុកជាមួយរបៀប 600។"

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "ឈ្មោះអ្នកប្រើ"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "ឈ្មោះអ្នកប្រើត្រូវតែជា ASCII ដែលអាចបោះពុម្ពបាន"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "ការវិនិច្ឆ័យ"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "ព័ត៌មានសម្គាល់អ្នកមើល"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "បានរក្សាទុកពាក្យសម្ងាត់អ្នកមើល"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "ម៉ាស៊ីនមេ WayVNC សម្រាប់កម្មវិធីតែងចម្លង wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "ពិធីការ Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "អ្វីដែលផ្ទៃតុនេះប្រកាស និងអត្ថន័យរបស់វាសម្រាប់ការចូលដំណើរការពីចម្ងាយ។"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "បាទ/ចាស"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "គ្រប់បណ្ដាញដែលកុំព្យូទ័រនេះបានភ្ជាប់"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "តែបណ្ដាញមូលដ្ឋានប៉ុណ្ណោះ"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "ឈ្មោះ mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "របៀប %s (បើកចំហពេក)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "របៀប 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "ម៉ាស៊ីននេះតែប៉ុណ្ណោះ"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "ឯកតាមិនបានដំឡើង"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "មិនស្គាល់"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "ប្រើដើម្បីស្ទង់ពិធីការ Wayland"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "ប្រើដើម្បីស្ទង់ផតថលតាម D-Bus"

#~ msgid "Qualification"
#~ msgstr "គុណវុឌ្ឍិ"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "0.0.0.0 ធ្វើឱ្យម៉ាស៊ីនមេអាចចូលដំណើរការបានពីឧបករណ៍ក្នុងបណ្តាញមូលដ្ឋានរបស់អ្នក; សេវាកម្មនៅតែរារាំងអ៊ីនធឺណិត។ 127.0.0.1 កំណត់វាត្រឹមម៉ាស៊ីននេះ។ ច្រក 1024 និងទាបជាងត្រូវបានបដិសេធ។"

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "បណ្តាញមូលដ្ឋានតែប៉ុណ្ណោះ; អ៊ីនធឺណិតត្រូវបានរារាំងដោយឯកតា"
