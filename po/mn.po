#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), баталгаажуулалт %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d бичлэг/оролтын интерфейс"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d ажлын тавцан"

