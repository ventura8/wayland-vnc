msgstr "Lykilorð skoðara vistað"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC-þjónn, fyrir wlroots-samsetjara"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland-samskiptareglur"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

