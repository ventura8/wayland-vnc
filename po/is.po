#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), auðkenning %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d upptöku-/inntaksviðmót"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d skjáborð"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s VANTAR og þetta skjáborð þarfnast þess"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: aðeins þessi tölva. 0.0.0.0: öll net sem þessi tölva er tengd við, án annarrar varnar. Gáttum 1024 og lægri er hafnað."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Krafist er innbyggðrar Wayland-setu; að falla aftur í X11 er bannað."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Um Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Vistfang"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Tilkynnt"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Allt til staðar"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Virkja"

