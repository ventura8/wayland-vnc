#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), ověření %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d rozhraní pro záznam/vstup"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d ploch"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s CHYBÍ a tato plocha jej potřebuje"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: pouze tento počítač. 0.0.0.0: každá síť, ke které je tento počítač připojen, bez další ochrany. Porty 1024 a nižší jsou odmítnuty."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Je vyžadováno nativní sezení Wayland; návrat k X11 je zakázán."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "O aplikaci Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adresa"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Ohlášeno"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Vše přítomno"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Použít"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automaticky (podle plochy)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
