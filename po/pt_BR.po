#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autenticação %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d interface(s) de captura/entrada"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d áreas de trabalho"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s está FALTANDO e esta área de trabalho precisa dele"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: somente este computador. 0.0.0.0: todas as redes às quais este computador está conectado, sem nenhuma outra barreira. Portas iguais ou inferiores a 1024 são recusadas."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "É necessária uma sessão Wayland nativa; o recurso ao X11 é proibido."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Sobre o Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Endereço"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Anunciado"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Todos presentes"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Aplicar"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automático (seguir a área de trabalho)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Backend candidato"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Backend nesta área de trabalho"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binários"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Endereço e porta de escuta"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Endereço e porta aplicados"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Cancelar"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Veredito de capacidades"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Detectados os protocolos de captura, teclado virtual e ponteiro virtual."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Fechar"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Configuração"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Confirmar senha"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Conectar de outro dispositivo"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Conecte esta máquina ao Wi-Fi ou Ethernet e abra novamente"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Copiar"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Falta um nome de usuário ou uma senha no arquivo de credenciais"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Área de trabalho"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Serviços da área de trabalho"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnóstico"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Cada opção aqui altera configuração real ou o serviço instalado."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Tudo o que esta área de trabalho precisa; não instalado: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Servidor GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "O daemon do próprio GNOME Área de Trabalho Remota escuta em todas as redes; instale o wayland-vnc-grd para controlar isso"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Captura de tela do GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Geral"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "No RealVNC Viewer, adicione uma conexão a um destes endereços. Eles funcionam enquanto o acesso pela rede local estiver ativado, para qualquer dispositivo na mesma rede. Não encaminhe a porta a partir da Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instale o pacote wayland-vnc para obter a unidade de usuário do systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Detectados o KWin e as interfaces de portal de captura/entrada."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "O KWin precisa das duas interfaces de portal: ScreenCast e RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Atalhos de teclado"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Atalhos de teclado"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Idioma"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Permitir que dispositivos na mesma Wi-Fi ou LAN se conectem. Desativado: somente este computador."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licença"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Acesso pela rede local"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Acesso pela rede local desativado"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Acesso pela rede local ativado"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menu principal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Torna esta área de trabalho Wayland acessível pelo RealVNC Viewer no seu celular ou em outro computador. Só escuta neste computador até você ativar “Acesso pela rede local”."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Detectados os serviços Mutter de captura e entrada remota; é necessária uma compilação privada."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Não"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Nenhum resultado encontrado"

