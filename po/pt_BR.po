msgstr "A senha deve ter de 6 a 64 caracteres ASCII"

#: src/wayland_vnc/settings_dialogs.py src/wayland_vnc/runtime.py
msgid "Passwords did not match"
msgstr "As senhas não coincidem"

#: src/wayland_vnc/settings_dialogs.py
msgid "Port"
msgstr "Porta"

#: src/wayland_vnc/runtime.py
msgid "Port must be an unprivileged TCP port"
msgstr "A porta deve ser uma porta TCP não privilegiada"

