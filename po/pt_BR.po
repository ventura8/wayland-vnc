msgstr "Iniciar ao fazer login"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Status"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Armazenada (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Previsto"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "A janela de configurações precisa de GTK4 e libadwaita (instale python3-gi, gir1.2-gtk-4.0 e gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "A janela de configurações precisa de libadwaita %(needed)s ou mais recente; este sistema tem %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "A janela segue o idioma da sua área de trabalho, a menos que você escolha outro."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Esta área de trabalho serve VNC pelo GNOME Remote Desktop, que aceita senhas de no máximo 8 caracteres"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "O backend deste ambiente sempre escuta somente neste computador"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Servidor TigerVNC, para o KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Tente outra pesquisa."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Digite isto no RealVNC Viewer no outro dispositivo. Use o olho para revelar a senha atual. Armazenada com modo 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Nome de usuário"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "O nome de usuário deve ser ASCII imprimível"

