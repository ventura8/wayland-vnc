msgid "Diagnostics"
msgstr "Diagnostic"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Option nyonso awa ebongolaka configuration ya solo to service oyo etiami."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Nyonso oyo desktop oyo esengeli; etiami te: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Serveur GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Daemon ya GNOME Biro ya mosika yango moko ezali koyoka na nsinga nyonso; tyá wayland-vnc-grd mpo na kotambwisa yango"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Kobimisa écran ya GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Ya minene"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Na RealVNC Viewer, bakisá bokangami na moko ya baadrɛsi oyo. Esalaka ntango nzela ya nsinga ya mboka efungwami, mpo na esaleli nyonso na nsinga moko. Kotinda porte te uta na Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Tia paquet wayland-vnc mpo na kozwa unité ya mosaleli ya systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin mpe bisaleli ya portail ya kozwa/kokɔtisa emonani."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin esengeli na ba interface ya portail nyonso mibale: ScreenCast na RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Ba raccourci ya clavier"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Ba raccourci ya clavier"

