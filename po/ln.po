msgid "Username"
msgstr "Nkombo ya mosaleli"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Nkombo ya mosaleli esengeli kozala ASCII oyo ekoki kobimisama"

