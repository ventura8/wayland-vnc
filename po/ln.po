msgid "Language"
msgstr "Lokota"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Tiká bisaleli ya Wi-Fi to LAN moko ekangama. Ekangami: kaka ordinatɛlɛ oyo."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Nzela ya kosalela"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Nzela uta na nsinga ya mboka"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Nzela uta na nsinga ya mboka ekangami"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Nzela uta na nsinga ya mboka efungwami"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menu ya monene"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Esalaka ete desktop Wayland oyo ekoma na RealVNC Viewer na téléphone na yo to ordinateur mosusu. Eyokaka kaka na ordinateur oyo tii okofungola Nzela uta na nsinga ya mboka."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Ba service ya Mutter ya kozwa mpe kokɔtisa na mosika emonani; build privé esengeli."

