msgstr "Ebombami (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Etalelami"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Fenêtre ya ba paramètre esengeli na GTK4 mpe libadwaita (tia python3-gi, gir1.2-gtk-4.0 mpe gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Fenêtre ya ba paramètre esengeli na libadwaita %(needed)s to ya sika koleka; système oyo ezali na %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Fenêtre elandaka lokota ya desktop na yo soki oponi mosusu te."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Desktop oyo epesaka VNC na nzela ya GNOME Remote Desktop, oyo endimaka ba mot de passe ya bilembo 8 to na nse"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Motɛlɛ ya biro oyo eyokaka ntango nyonso kaka na ordinatɛlɛ oyo"

