msgid "Diagnostics"
msgstr "Diagnostics"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Chaque option ici modifie une vraie configuration ou le service installé."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Tout ce dont ce bureau a besoin ; non installé : "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Serveur GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Le démon propre à GNOME Bureau à distance écoute sur tous les réseaux ; installez wayland-vnc-grd pour contrôler cela"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Capture d'écran GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Général"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Dans RealVNC Viewer, ajoutez une connexion vers l'une de ces adresses. Elles fonctionnent tant que l'accès depuis le réseau local est activé, pour tout appareil du même réseau. Ne redirigez pas le port depuis Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installez le paquet wayland-vnc pour obtenir l'unité utilisateur systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin et les interfaces de portail de capture/saisie détectés."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin nécessite les deux interfaces de portail : ScreenCast et RemoteDesktop."

