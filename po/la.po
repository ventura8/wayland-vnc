msgstr "Aditus e rete locali clausus est"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Aditus e rete locali apertus est"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Index principalis"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Hanc mensam Wayland ex RealVNC Viewer in telephono tuo vel alio computatro accessibilem reddit. In hoc computatro tantum auscultat, donec Aditum e rete locali accendas."

