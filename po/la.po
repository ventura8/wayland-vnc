msgstr "Fenestra configurationum GTK4 et libadwaita requirit (institue python3-gi, gir1.2-gtk-4.0 et gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Fenestra configurationum libadwaita %(needed)s vel recentiorem requirit; hoc systema %(found)s habet"

