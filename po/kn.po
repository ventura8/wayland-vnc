msgid "Main Menu"
msgstr "ಮುಖ್ಯ ಮೆನು"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "ಈ Wayland ಡೆಸ್ಕ್‌ಟಾಪ್ ಅನ್ನು ನಿಮ್ಮ ಫೋನ್ ಅಥವಾ ಇನ್ನೊಂದು ಕಂಪ್ಯೂಟರ್‌ನ RealVNC Viewer ನಿಂದ ತಲುಪುವಂತೆ ಮಾಡುತ್ತದೆ. ನೀವು ಸ್ಥಳೀಯ ಜಾಲದಿಂದ ಪ್ರವೇಶವನ್ನು ಆನ್ ಮಾಡುವವರೆಗೆ ಅದು ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಮಾತ್ರ ಆಲಿಸುತ್ತದೆ."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter ಸೆರೆಹಿಡಿಯುವ ಮತ್ತು ದೂರಸ್ಥ ಇನ್‌ಪುಟ್ ಸೇವೆಗಳು ಪತ್ತೆಯಾಗಿವೆ; ಖಾಸಗಿ ನಿರ್ಮಾಣ ಅಗತ್ಯ."

