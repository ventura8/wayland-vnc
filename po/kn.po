#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "ಸೇವೆ"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "ಸೆಷನ್"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "ಸೆಷನ್ ಪ್ರಕಾರ"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "ಪಾಸ್‌ವರ್ಡ್ ಹೊಂದಿಸಿ"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "ವೀಕ್ಷಕ ಪಾಸ್‌ವರ್ಡ್ ಹೊಂದಿಸಿ"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "ಮೊದಲು ವೀಕ್ಷಕ ಪಾಸ್‌ವರ್ಡ್ ಹೊಂದಿಸಿ"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "ಲಾಗಿನ್‌ನಲ್ಲಿ ಪ್ರಾರಂಭಿಸಿ"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "ಸ್ಥಿತಿ"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "ಸಂಗ್ರಹಿಸಲಾಗಿದೆ (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "ಗುರಿಯಿಡಲಾಗಿದೆ"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳ ವಿಂಡೋಗೆ GTK4 ಮತ್ತು libadwaita ಬೇಕು (python3-gi, gir1.2-gtk-4.0 ಮತ್ತು gir1.2-adw-1 ಸ್ಥಾಪಿಸಿ)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳ ವಿಂಡೋಗೆ libadwaita %(needed)s ಅಥವಾ ಹೊಸದು ಬೇಕು; ಈ ಸಿಸ್ಟಮ್‌ನಲ್ಲಿ %(found)s ಇದೆ"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "ನೀವು ಬೇರೆಯದನ್ನು ಆರಿಸದ ಹೊರತು ವಿಂಡೋ ನಿಮ್ಮ ಡೆಸ್ಕ್‌ಟಾಪ್‌ನ ಭಾಷೆಯನ್ನು ಅನುಸರಿಸುತ್ತದೆ."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "ಈ ಡೆಸ್ಕ್‌ಟಾಪ್ GNOME Remote Desktop ಮೂಲಕ VNC ಸೇವೆ ನೀಡುತ್ತದೆ, ಅದು ಗರಿಷ್ಠ 8 ಅಕ್ಷರಗಳ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸುತ್ತದೆ"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "ಈ ಡೆಸ್ಕ್‌ಟಾಪ್‌ನ ಬ್ಯಾಕೆಂಡ್ ಯಾವಾಗಲೂ ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಮಾತ್ರ ಆಲಿಸುತ್ತದೆ"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC ಸರ್ವರ್, KDE Plasma ಗಾಗಿ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "ಬೇರೆ ಹುಡುಕಾಟ ಪ್ರಯತ್ನಿಸಿ."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "ಇವುಗಳನ್ನು ಇನ್ನೊಂದು ಸಾಧನದ RealVNC Viewer ನಲ್ಲಿ ಟೈಪ್ ಮಾಡಿ. ಪ್ರಸ್ತುತ ಪಾಸ್‌ವರ್ಡ್ ತೋರಿಸಲು ಕಣ್ಣನ್ನು ಬಳಸಿ. ಮೋಡ್ 600 ನೊಂದಿಗೆ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "ಬಳಕೆದಾರ ಹೆಸರು"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "ಬಳಕೆದಾರ ಹೆಸರು ಮುದ್ರಿಸಬಹುದಾದ ASCII ಆಗಿರಬೇಕು"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "ತೀರ್ಪು"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "ವೀಕ್ಷಕ ರುಜುವಾತು"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "ವೀಕ್ಷಕ ಪಾಸ್‌ವರ್ಡ್ ಉಳಿಸಲಾಗಿದೆ"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC ಸರ್ವರ್, wlroots ಕಂಪೋಸಿಟರ್‌ಗಳಿಗಾಗಿ"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland ಪ್ರೋಟೋಕಾಲ್‌ಗಳು"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "ಈ ಡೆಸ್ಕ್‌ಟಾಪ್ ಏನನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ, ಮತ್ತು ದೂರಸ್ಥ ಪ್ರವೇಶಕ್ಕೆ ಅದರ ಅರ್ಥವೇನು."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "ಹೌದು"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "ಈ ಕಂಪ್ಯೂಟರ್ ಸಂಪರ್ಕಗೊಂಡಿರುವ ಪ್ರತಿಯೊಂದು ಜಾಲ"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "ಸ್ಥಳೀಯ ಜಾಲ ಮಾತ್ರ"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS ಹೆಸರು"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "ಮೋಡ್ %s (ತುಂಬಾ ತೆರೆದಿದೆ)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "ಮೋಡ್ 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "ಈ ಯಂತ್ರ ಮಾತ್ರ"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "ಘಟಕ ಸ್ಥಾಪಿಸಿಲ್ಲ"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "ಅಜ್ಞಾತ"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "Wayland ಪ್ರೋಟೋಕಾಲ್‌ಗಳನ್ನು ಪರೀಕ್ಷಿಸಲು ಬಳಸಲಾಗುತ್ತದೆ"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "D-Bus ಮೂಲಕ ಪೋರ್ಟಲ್‌ಗಳನ್ನು ಪರೀಕ್ಷಿಸಲು ಬಳಸಲಾಗುತ್ತದೆ"

#~ msgid "Qualification"
#~ msgstr "ಅರ್ಹತೆ"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "0.0.0.0 ನಿಮ್ಮ ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ನ ಸಾಧನಗಳಿಂದ ಸರ್ವರ್ ತಲುಪುವಂತೆ ಮಾಡುತ್ತದೆ; ಸೇವೆಯು ಇನ್ನೂ ಇಂಟರ್ನೆಟ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತದೆ. 127.0.0.1 ಅದನ್ನು ಈ ಯಂತ್ರಕ್ಕೆ ಸೀಮಿತಗೊಳಿಸುತ್ತದೆ. 1024 ಅಥವಾ ಕೆಳಗಿನ ಪೋರ್ಟ್‌ಗಳನ್ನು ನಿರಾಕರಿಸಲಾಗುತ್ತದೆ."

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್ ಮಾತ್ರ; ಇಂಟರ್ನೆಟ್ ಅನ್ನು ಘಟಕ ನಿರ್ಬಂಧಿಸಿದೆ"
