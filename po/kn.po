msgid "Language"
msgstr "ಭಾಷೆ"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "ಅದೇ Wi-Fi ಅಥವಾ LAN ನಲ್ಲಿರುವ ಸಾಧನಗಳು ಸಂಪರ್ಕಗೊಳ್ಳಲು ಅನುಮತಿಸಿ. ಆಫ್: ಈ ಕಂಪ್ಯೂಟರ್ ಮಾತ್ರ."

