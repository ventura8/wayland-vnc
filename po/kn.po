msgid "Diagnostics"
msgstr "ರೋಗನಿರ್ಣಯ"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "ಇಲ್ಲಿನ ಪ್ರತಿಯೊಂದು ಆಯ್ಕೆಯು ನೈಜ ಸಂರಚನೆ ಅಥವಾ ಸ್ಥಾಪಿತ ಸೇವೆಯನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "ಈ ಡೆಸ್ಕ್‌ಟಾಪ್‌ಗೆ ಬೇಕಾದ ಎಲ್ಲವೂ; ಸ್ಥಾಪಿಸಿಲ್ಲ: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop ಸರ್ವರ್"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME ದೂರಸ್ಥ ಡೆಸ್ಕ್‌ಟಾಪ್‌ನ ಸ್ವಂತ ಡೀಮನ್ ಪ್ರತಿಯೊಂದು ಜಾಲದಲ್ಲಿ ಆಲಿಸುತ್ತದೆ; ಇದನ್ನು ನಿಯಂತ್ರಿಸಲು wayland-vnc-grd ಅನ್ನು ಸ್ಥಾಪಿಸಿ"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME ಸ್ಕ್ರೀನ್‌ಕಾಸ್ಟ್"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "ಸಾಮಾನ್ಯ"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "RealVNC Viewer ನಲ್ಲಿ ಈ ವಿಳಾಸಗಳಲ್ಲಿ ಒಂದಕ್ಕೆ ಸಂಪರ್ಕವನ್ನು ಸೇರಿಸಿ. ಸ್ಥಳೀಯ ಜಾಲದಿಂದ ಪ್ರವೇಶ ಆನ್ ಆಗಿರುವವರೆಗೆ ಅದೇ ಜಾಲದಲ್ಲಿರುವ ಯಾವುದೇ ಸಾಧನಕ್ಕೆ ಇವು ಕೆಲಸ ಮಾಡುತ್ತವೆ. ಪೋರ್ಟ್ ಅನ್ನು ಇಂಟರ್ನೆಟ್‌ನಿಂದ ಫಾರ್ವರ್ಡ್ ಮಾಡಬೇಡಿ."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "systemd ಬಳಕೆದಾರ ಘಟಕ ಪಡೆಯಲು wayland-vnc ಪ್ಯಾಕೇಜ್ ಸ್ಥಾಪಿಸಿ"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin ಮತ್ತು ಸೆರೆಹಿಡಿಯುವ/ಇನ್‌ಪುಟ್ ಪೋರ್ಟಲ್ ಇಂಟರ್‌ಫೇಸ್‌ಗಳು ಪತ್ತೆಯಾಗಿವೆ."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin ಗೆ ScreenCast ಮತ್ತು RemoteDesktop ಎರಡೂ ಪೋರ್ಟಲ್ ಇಂಟರ್‌ಫೇಸ್‌ಗಳು ಬೇಕು."

