#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), ದೃಢೀಕರಣ %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d ಸೆರೆಹಿಡಿಯುವ/ಇನ್‌ಪುಟ್ ಇಂಟರ್‌ಫೇಸ್‌ಗಳು"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d ಡೆಸ್ಕ್‌ಟಾಪ್‌ಗಳು"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s ಇಲ್ಲ ಮತ್ತು ಈ ಡೆಸ್ಕ್‌ಟಾಪ್‌ಗೆ ಅದು ಬೇಕು"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: ಈ ಕಂಪ್ಯೂಟರ್ ಮಾತ್ರ. 0.0.0.0: ಈ ಕಂಪ್ಯೂಟರ್ ಸಂಪರ್ಕಗೊಂಡಿರುವ ಪ್ರತಿಯೊಂದು ಜಾಲ, ಬೇರೆ ಯಾವುದೇ ಬೇಲಿ ಇಲ್ಲದೆ. ಪೋರ್ಟ್ 1024 ಮತ್ತು ಅದಕ್ಕಿಂತ ಕೆಳಗಿನವು ನಿರಾಕರಿಸಲ್ಪಡುತ್ತವೆ."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "ಸ್ಥಳೀಯ Wayland ಸೆಷನ್ ಅಗತ್ಯ; X11 ಗೆ ಹಿಂತಿರುಗುವುದು ನಿಷಿದ್ಧ."

