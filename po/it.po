msgid "Language"
msgstr "Lingua"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Consenti ai dispositivi della stessa Wi-Fi o LAN di connettersi. Disattivato: solo questo computer."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licenza"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Accesso dalla rete locale"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Accesso dalla rete locale disattivato"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Accesso dalla rete locale attivato"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menu principale"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Rende questo desktop Wayland raggiungibile da RealVNC Viewer sul telefono o su un altro computer. Resta in ascolto solo su questo computer finché non attivi «Accesso dalla rete locale»."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Rilevati i servizi Mutter di cattura e input remoto; è richiesta una build privata."

