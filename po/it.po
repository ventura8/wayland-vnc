msgstr "La finestra delle impostazioni richiede GTK4 e libadwaita (installa python3-gi, gir1.2-gtk-4.0 e gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "La finestra delle impostazioni richiede libadwaita %(needed)s o successiva; questo sistema ha %(found)s"

