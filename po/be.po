msgid "Targeted"
msgstr "Мэтавы"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Акну налад патрэбныя GTK4 і libadwaita (усталюйце python3-gi, gir1.2-gtk-4.0 і gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Акну налад патрэбна libadwaita %(needed)s або навейшая; у гэтай сістэме %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Акно прытрымліваецца мовы вашага працоўнага стала, калі вы не выбераце іншую."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Гэты працоўны стол абслугоўвае VNC праз GNOME Remote Desktop, які прымае паролі не даўжэйшыя за 8 знакаў"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Сервер гэтага працоўнага стала заўсёды слухае толькі на гэтым камп’ютары"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Сервер TigerVNC, для KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Паспрабуйце іншы пошук."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Увядзіце гэта ў RealVNC Viewer на іншай прыладзе. Націсніце на вока, каб паказаць бягучы пароль. Захавана з рэжымам 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Імя карыстальніка"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Імя карыстальніка павінна быць друкавальным ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Вердыкт"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Уліковыя даныя праглядальніка"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Пароль праглядальніка захаваны"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Сервер WayVNC, для кампазітараў wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Пратаколы Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Што абвяшчае гэты працоўны стол і што гэта значыць для аддаленага доступу."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Так"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "усе сеткі, да якіх падключаны гэты камп’ютар"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "толькі лакальная сетка"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "Імя mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "рэжым %s (занадта адкрыты)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "рэжым 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "толькі гэтая машына"

#: src/wayland_vnc/settings.py
