#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), аўтэнтыфікацыя %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d інтэрфейсаў захопу/уводу"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d працоўных сталоў"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s АДСУТНІЧАЕ, а гэтаму працоўнаму сталу ён патрэбны"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: толькі гэты камп’ютар. 0.0.0.0: усе сеткі, да якіх падключаны гэты камп’ютар, без якой-небудзь іншай абароны. Парты 1024 і ніжэй адхіляюцца."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Патрабуецца родны сеанс Wayland; вяртанне да X11 забаронена."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Пра Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Адрас"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Абвешчаны"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Усе прысутныя"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Ужыць"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Аўтаматычна (паводле працоўнага стала)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Бэкенд"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Кандыдат у бэкенды"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Бэкенд на гэтым працоўным стале"

