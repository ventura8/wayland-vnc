msgstr "выкарыстоўваецца для праверкі пратаколаў Wayland"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "выкарыстоўваецца для праверкі парталаў праз D-Bus"

