#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Пацвердзіце пароль"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Падключыцца з іншай прылады"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Падключыце гэтую машыну да Wi-Fi або Ethernet, потым адкрыйце зноў"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Капіяваць"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "У файле ўліковых даных адсутнічае імя карыстальніка або пароль"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Працоўны стол"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Службы працоўнага стала"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Дыягностыка"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Кожны параметр тут змяняе рэальную канфігурацыю або ўсталяваную службу."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Усё, што патрэбна гэтаму працоўнаму сталу; не ўсталявана: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Сервер GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Уласная служба GNOME Аддалены працоўны стол слухае ва ўсіх сетках; усталюйце wayland-vnc-grd, каб кіраваць гэтым"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Трансляцыя экрана GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Агульныя"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "У RealVNC Viewer дадайце падключэнне да аднаго з гэтых адрасоў. Яны працуюць, пакуль уключаны доступ з лакальнай сеткі, для любой прылады ў той жа сетцы. Не перанакіроўвайце порт з Інтэрнэту."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Усталюйце пакет wayland-vnc, каб атрымаць карыстальніцкі юніт systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Выяўлены KWin і партальныя інтэрфейсы захопу/уводу."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin патрабуе абодвух партальных інтэрфейсаў: ScreenCast і RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Спалучэнні клавіш"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Спалучэнні клавіш"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Мова"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Дазволіць падключэнне прыладам у той жа сетцы Wi-Fi або LAN. Выключана: толькі гэты камп’ютар."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Ліцэнзія"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Доступ з лакальнай сеткі"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Доступ з лакальнай сеткі выключаны"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Доступ з лакальнай сеткі ўключаны"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Галоўнае меню"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Робіць гэты працоўны стол Wayland даступным з RealVNC Viewer на вашым тэлефоне або іншым камп'ютары. Пакуль вы не ўключыце «Доступ з лакальнай сеткі», ён слухае толькі на гэтым камп'ютары."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Выяўлены службы Mutter для захопу і аддаленага ўводу; патрабуецца прыватная зборка."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Не"

