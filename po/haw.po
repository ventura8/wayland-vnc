msgid "Everything this desktop needs; not installed: "
msgstr "Nā mea a pau e pono ai kēia pākaukau; ʻaʻole i hoʻokomo ʻia: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Kikowaena GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Ke hoʻolohe nei ka daemon ponoʻī o GNOME Pākaukau Mamao ma nā pūnaewele a pau; e hoʻokomo iā wayland-vnc-grd e hoʻomalu ai i kēia"

