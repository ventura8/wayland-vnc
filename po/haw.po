msgid "GNOME Screencast"
msgstr "Hoʻolaha pale GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Laulā"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Ma RealVNC Viewer, e hoʻohui i kahi pili i kekahi o kēia mau helu wahi. Hana lākou i ka wā e ʻā ana ke komo mai ka pūnaewele kūloko, no kēlā me kēia mea hana ma ka pūnaewele hoʻokahi. Mai hoʻouna i ke awa mai ka Pūnaewele puni honua."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "E hoʻokomo i ka pūʻolo wayland-vnc e loaʻa ai ka ʻāpana mea hoʻohana systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Loaʻa ʻo KWin a me nā ʻōnaehana ʻīpuka hopu/hoʻokomo."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "Pono iā KWin nā ʻōnaehana ʻīpuka ʻelua: ScreenCast a me RemoteDesktop."

