#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Pono ka puka makani hoʻonohonoho iā libadwaita %(needed)s a i ʻole hou aʻe; loaʻa i kēia ʻōnaehana ʻo %(found)s"

