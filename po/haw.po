msgstr "Hahai ka puka makani i ka ʻōlelo o kāu pākaukau ke koho ʻole ʻoe i kekahi ʻē aʻe."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Lawelawe kēia pākaukau i ka VNC ma o GNOME Remote Desktop, e ʻae ana i nā ʻōlelo huna he 8 huapalapala ka nui loa"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Hoʻolohe mau ka ʻōnaehana hope o kēia pākaukau ma kēia kamepiula wale nō"

