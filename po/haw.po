msgid "Username"
msgstr "Inoa mea hoʻohana"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Pono ka inoa mea hoʻohana he ASCII hiki ke paʻi ʻia"

