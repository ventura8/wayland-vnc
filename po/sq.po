msgid "Open the main menu"
msgstr "Hap menunë kryesore"

#: src/wayland_vnc/settings_app.py
msgid "PUBLIC ADDRESS - reachable beyond the local network"
msgstr "ADRESË PUBLIKE - e arritshme përtej rrjetit lokal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Password"
msgstr "Fjalëkalim"

#: src/wayland_vnc/runtime.py
msgid "Password must be 6-64 ASCII characters"
msgstr "Fjalëkalimi duhet të ketë 6–64 shenja ASCII"

#: src/wayland_vnc/settings_dialogs.py src/wayland_vnc/runtime.py
msgid "Passwords did not match"
msgstr "Fjalëkalimet nuk përputhen"

#: src/wayland_vnc/settings_dialogs.py
msgid "Port"
msgstr "Portë"

#: src/wayland_vnc/runtime.py
msgid "Port must be an unprivileged TCP port"
msgstr "Porta duhet të jetë një portë TCP e paprivilegjuar"

#: src/wayland_vnc/settings.py
msgid "Portals"
msgstr "Portale"

#: src/wayland_vnc/settings_dialogs.py
msgid "Project Website"
msgstr "Sajti i projektit"

#: src/wayland_vnc/settings_app.py
msgid "Quit"
msgstr "Dil"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Gati për instalim"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, një klient; s'nevojitet për të shërbyer"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Arsye"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Objektivat e hedhjes në qarkullim"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "Portali RemoteDesktop"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Njoftoni një problem"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "Aftësitë e kërkuara të kapjes DHE hyrjes nuk u zbuluan."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "Në punë tani"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "Ruaje"

