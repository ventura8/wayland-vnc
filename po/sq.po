msgid "Server Configuration"
msgstr "Formësimi i shërbyesit"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "Shërbim"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "Sesion"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "Lloj sesioni"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "Caktoni fjalëkalimin"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "Caktoni fjalëkalimin e shikuesit"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "Caktoni së pari një fjalëkalim shikuesi"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "Nis në hyrje"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Gjendje"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "E ruajtur (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "E synuar"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Dritarja e rregullimeve kërkon GTK4 dhe libadwaita (instaloni python3-gi, gir1.2-gtk-4.0 dhe gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Dritarja e rregullimeve kërkon libadwaita %(needed)s ose më të ri; ky sistem ka %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Dritarja ndjek gjuhën e desktopit tuaj, veç në zgjodhët një tjetër."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Ky desktop shërben VNC përmes GNOME Remote Desktop, i cili pranon fjalëkalime prej më së shumti 8 shenjash"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Motori i këtij desktopi dëgjon gjithmonë vetëm në këtë kompjuter"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Shërbyes TigerVNC, për KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Provoni një kërkim tjetër."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Shtypini këto në RealVNC Viewer në pajisjen tjetër. Përdorni syrin për të shfaqur fjalëkalimin aktual. Ruajtur me mënyrën 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Emër përdoruesi"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Emri i përdoruesit duhet të jetë ASCII i shtypshëm"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Verdikt"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Kredencialet e shikuesit"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Fjalëkalimi i shikuesit u ruajt"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Shërbyes WayVNC, për kompozitorët wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Protokollet Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Ç'njofton ky desktop dhe ç'do të thotë kjo për hyrjen në distancë."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Po"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "çdo rrjet me të cilin është lidhur ky kompjuter"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "vetëm rrjeti lokal"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "Emër mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "mënyra %s (tepër e hapur)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "mënyra 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "vetëm kjo makinë"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "njësia s'është e instaluar"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "e panjohur"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "përdoret për të hetuar protokollet Wayland"

#: src/wayland_vnc/settings.py
