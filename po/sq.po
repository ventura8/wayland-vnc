#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), mirëfilltësim %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d ndërfaqe kapjeje/hyrjeje"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d desktopë"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s MUNGON dhe ky desktop e kërkon"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: vetëm ky kompjuter. 0.0.0.0: çdo rrjet me të cilin është lidhur ky kompjuter, pa asnjë mbrojtje tjetër. Portat 1024 e më poshtë refuzohen."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Kërkohet një sesion Wayland i lindur; kthimi te X11 është i ndaluar."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Rreth Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adresa"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "E njoftuar"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Të gjitha të pranishme"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Zbato"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatike (sipas desktopit)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Mekanizmi"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Mekanizmi kandidat"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Mekanizmi në këtë desktop"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Dyorë"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Adresa dhe porta e dëgjimit"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adresa dhe porta u zbatuan"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Anulo"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Verdikti i aftësive"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "U zbuluan protokollet e kapjes, tastierës virtuale dhe treguesit virtual."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Mbyll"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Formësim"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Ripohoni fjalëkalimin"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Lidhu nga një pajisje tjetër"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Lidheni këtë makinë me Wi-Fi ose Ethernet, pastaj rihapeni"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopjo"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Kartelës së kredencialeve i mungon emri i përdoruesit ose fjalëkalimi"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Desktop"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Shërbime desktopi"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostikim"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Çdo mundësi këtu ndryshon formësimin real ose shërbimin e instaluar."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Gjithçka që i duhet këtij desktopi; e painstaluar: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Shërbyes GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Daemon-i i vetë GNOME Desktop në largësi dëgjon në çdo rrjet; instaloni wayland-vnc-grd për ta kontrolluar këtë"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Transmetim ekrani GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Të përgjithshme"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Në RealVNC Viewer shtoni një lidhje me një nga këto adresa. Ato funksionojnë sa kohë që hyrja nga rrjeti lokal është e aktivizuar, për çdo pajisje në të njëjtin rrjet. Mos e përcillni portën nga Interneti."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instaloni paketën wayland-vnc për të marrë njësinë e përdoruesit systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "U zbuluan KWin dhe ndërfaqet e portalit të kapjes/hyrjes."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin kërkon të dyja ndërfaqet e portalit: ScreenCast dhe RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Shkurtore tastiere"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Shkurtore tastiere"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Gjuhë"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Lejo pajisjet në të njëjtin Wi-Fi ose LAN të lidhen. Çaktivizuar: vetëm ky kompjuter."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licencë"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Hyrja nga rrjeti lokal"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Hyrja nga rrjeti lokal u çaktivizua"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Hyrja nga rrjeti lokal u aktivizua"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menuja kryesore"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "E bën këtë desktop Wayland të arritshëm nga RealVNC Viewer në telefonin tuaj ose në një kompjuter tjetër. Dëgjon vetëm në këtë kompjuter derisa të aktivizoni Hyrjen nga rrjeti lokal."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "U zbuluan shërbimet e Mutter për kapje dhe hyrje në distancë; kërkohet një version privat."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Jo"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "S'u gjetën përfundime"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "S'u gjet adresë rrjeti lokal"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "S'ka mekanizëm të mbuluar"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "S'ka përkthime të instaluara, ndaj dritarja mbetet në anglisht."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "None"
msgstr "Asnjë"

#: src/wayland_vnc/settings.py
msgid "None advertised"
msgstr "Asnjë e njoftuar"

#: src/wayland_vnc/settings.py
msgid "None available"
msgstr "Asnjë e passhme"

#: src/wayland_vnc/settings.py
msgid "None checked"
msgstr "Asnjë e kontrolluar"

