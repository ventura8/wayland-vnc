msgid "GNOME Screencast"
msgstr "GNOME pantaila-igorpena"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Orokorra"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "RealVNC Viewer-en, gehitu konexio bat helbide hauetako batera. Sare lokaleko sarbidea aktibatuta dagoen bitartean funtzionatzen dute, sare bereko edozein gailurentzat. Ez birbidali ataka Internetetik."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instalatu wayland-vnc paketea systemd erabiltzaile-unitatea lortzeko"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin eta kaptura/sarrera atariko interfazeak detektatu dira."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin-ek bi atari-interfazeak behar ditu: ScreenCast eta RemoteDesktop."

