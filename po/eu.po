msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop zerbitzaria"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOMEren Urruneko mahaigainaren daemon propioak sare guztietan entzuten du; instalatu wayland-vnc-grd hori kontrolatzeko"

