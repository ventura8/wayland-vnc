msgid "Copy"
msgstr "Kopiëren"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "In het inloggegevensbestand ontbreekt een gebruikersnaam of wachtwoord"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Bureaublad"

