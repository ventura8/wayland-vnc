msgid "GNOME Screencast"
msgstr "GNOME-schermopname"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Algemeen"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Voeg in RealVNC Viewer een verbinding naar een van deze adressen toe. Ze werken zolang toegang vanaf het lokale netwerk aanstaat, voor elk apparaat in hetzelfde netwerk. Stuur de poort niet door vanaf het internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installeer het pakket wayland-vnc om de systemd-gebruikersunit te krijgen"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin en de portaalinterfaces voor opname/invoer gedetecteerd."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin vereist beide portaalinterfaces: ScreenCast en RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Sneltoetsen"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Sneltoetsen"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Taal"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Apparaten in dezelfde wifi of hetzelfde LAN laten verbinden. Uit: alleen deze computer."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licentie"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Toegang vanaf het lokale netwerk"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Toegang vanaf het lokale netwerk uitgeschakeld"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Toegang vanaf het lokale netwerk ingeschakeld"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Hoofdmenu"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Maakt dit Wayland-bureaublad bereikbaar vanuit RealVNC Viewer op uw telefoon of een andere computer. Het luistert alleen op deze computer totdat u Toegang vanaf het lokale netwerk inschakelt."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter-opname- en invoerdiensten op afstand gedetecteerd; een privébuild is vereist."

