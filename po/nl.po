#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), authenticatie %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d opname-/invoerinterface(s)"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d bureaubladen"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s ONTBREEKT en dit bureaublad heeft het nodig"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: alleen deze computer. 0.0.0.0: elk netwerk waarmee deze computer verbonden is, zonder verdere afscherming. Poorten van 1024 en lager worden geweigerd."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Een native Wayland-sessie is vereist; terugvallen op X11 is verboden."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Over Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adres"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Aangekondigd"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Alle aanwezig"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Toepassen"

