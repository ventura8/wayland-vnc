msgstr "Дар файли маълумоти эътимод номи корбар ё парол нест"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Мизи корӣ"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Хидматҳои мизи корӣ"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Ташхис"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Ҳар як имкон дар ин ҷо танзимоти воқеӣ ё хидмати насбшударо тағйир медиҳад."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Ҳама чизе, ки ин мизи корӣ ниёз дорад; насб нашудааст: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Сервери GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Демони худи Мизи кории дурдасти GNOME дар ҳар шабака гӯш мекунад; барои идораи ин wayland-vnc-grd-ро насб кунед"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Пахши экрани GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Умумӣ"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Дар RealVNC Viewer пайвастшавӣ ба яке аз ин нишониҳоро илова кунед. Онҳо то даме ки дастрасӣ аз шабакаи маҳаллӣ фаъол аст, барои ҳар дастгоҳ дар ҳамон шабака кор мекунанд. Портро аз Интернет равона накунед."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Барои гирифтани воҳиди корбари systemd бастаи wayland-vnc-ро насб кунед"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin ва интерфейсҳои портали гирифтан/воридот ёфт шуданд."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin ҳар ду интерфейси портал: ScreenCast ва RemoteDesktop-ро талаб мекунад."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Миёнбурҳои клавиатура"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Миёнбурҳои клавиатура"

