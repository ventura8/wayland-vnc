msgid "Language"
msgstr "Забон"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Ба дастгоҳҳои ҳамон Wi-Fi ё LAN иҷозати пайвастшавӣ диҳед. Хомӯш: танҳо ҳамин компютер."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Иҷозатнома"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Дастрасӣ аз шабакаи маҳаллӣ"

