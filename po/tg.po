msgstr "Ҳадафгирифта"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Равзанаи танзимот ба GTK4 ва libadwaita ниёз дорад (python3-gi, gir1.2-gtk-4.0 ва gir1.2-adw-1-ро насб кунед)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Равзанаи танзимот ба libadwaita %(needed)s ё навтар ниёз дорад; ин система %(found)s дорад"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Агар дигареро интихоб накунед, равзана забони мизи кории шуморо пайравӣ мекунад."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Ин мизи корӣ VNC-ро тавассути GNOME Remote Desktop пешниҳод мекунад, ки паролҳои на бештар аз 8 аломатро қабул мекунад"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Қисми пуштибонии ин мизи корӣ ҳамеша танҳо дар ҳамин компютер гӯш мекунад"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Сервери TigerVNC, барои KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Ҷустуҷӯи дигарро санҷед."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Инҳоро дар RealVNC Viewer дар дастгоҳи дигар ворид кунед. Барои нишон додани пароли ҷорӣ чашмро истифода баред. Бо реҷаи 600 захира шудааст."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Номи корбар"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Номи корбар бояд ASCII-и чопшаванда бошад"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Ҳукм"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Маълумоти эътимоди тамошобин"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Пароли тамошобин захира шуд"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Сервери WayVNC, барои композиторҳои wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Протоколҳои Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Ин мизи корӣ чиро эълон мекунад ва ин барои дастрасии дурдаст чӣ маъно дорад."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ҳа"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "ҳар шабакае, ки ин компютер ба он пайваст аст"

