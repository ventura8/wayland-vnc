#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Пайваст шудан аз дастгоҳи дигар"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Ин мошинро ба Wi-Fi ё Ethernet пайваст кунед, сипас дубора кушоед"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Нусхабардорӣ"

