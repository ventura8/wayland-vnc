#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), pagpapatunay %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d interface ng pagkuha/input"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d desktop"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "NAWAWALA ang %s at kailangan ito ng desktop na ito"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: ang computer na ito lamang. 0.0.0.0: lahat ng network na nakakonekta ang computer na ito, nang walang ibang harang. Tinatanggihan ang mga port na 1024 pababa."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Kailangan ng katutubong Wayland session; ipinagbabawal ang pagbalik sa X11."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Tungkol sa Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Address"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Inanunsyo"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Kumpleto lahat"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Ilapat"

