msgid "Confirm Password"
msgstr "Kumpirmahin ang password"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Kumonekta mula sa ibang device"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Ikonekta ang makinang ito sa Wi-Fi o Ethernet, pagkatapos ay buksan muli"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopyahin"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Walang username o password ang file ng mga kredensyal"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Desktop"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Mga serbisyo ng desktop"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostics"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Binabago ng bawat opsyon dito ang totoong configuration o ang naka-install na serbisyo."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Lahat ng kailangan ng desktop na ito; hindi naka-install: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop server"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Ang sariling daemon ng GNOME Remote Desktop ay nakikinig sa lahat ng network; i-install ang wayland-vnc-grd upang makontrol ito"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME screencast"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Pangkalahatan"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Sa RealVNC Viewer, magdagdag ng koneksyon sa isa sa mga address na ito. Gumagana ang mga ito habang naka-on ang access mula sa lokal na network, para sa anumang device sa parehong network. Huwag i-forward ang port mula sa Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "I-install ang package na wayland-vnc para makuha ang systemd user unit"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Natukoy ang KWin at mga interface ng portal ng pagkuha/input."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "Kailangan ng KWin ang parehong portal interface: ScreenCast at RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Mga keyboard shortcut"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Mga keyboard shortcut"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Wika"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Payagang kumonekta ang mga device sa parehong Wi-Fi o LAN. Naka-off: ang computer na ito lamang."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Lisensya"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Access mula sa lokal na network"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Na-off ang access mula sa lokal na network"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Na-on ang access mula sa lokal na network"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Pangunahing menu"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Ginagawang maaabot ang Wayland desktop na ito mula sa RealVNC Viewer sa iyong telepono o ibang computer. Nakikinig lamang ito sa computer na ito hanggang sa buksan mo ang Access mula sa lokal na network."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Natukoy ang mga serbisyo ng Mutter sa pagkuha at malayuang input; kailangan ng pribadong build."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Hindi"

