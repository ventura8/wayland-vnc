msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Natukoy ang mga protocol ng pagkuha, virtual na keyboard, at virtual na pointer."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Isara"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Configuration"

