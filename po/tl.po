#, python-format
msgid "Stored (%s)"
msgstr "Naka-store (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Naka-target"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Kailangan ng settings window ng GTK4 at libadwaita (i-install ang python3-gi, gir1.2-gtk-4.0 at gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Kailangan ng settings window ng libadwaita %(needed)s o mas bago; may %(found)s ang system na ito"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Sumusunod ang window sa wika ng iyong desktop maliban kung pipili ka ng iba."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Naghahain ang desktop na ito ng VNC sa pamamagitan ng GNOME Remote Desktop, na tumatanggap ng mga password na hanggang 8 character lamang"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Ang backend ng desktop na ito ay laging nakikinig sa computer na ito lamang"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC server, para sa KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Sumubok ng ibang paghahanap."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "I-type ang mga ito sa RealVNC Viewer sa kabilang device. Gamitin ang mata para ipakita ang kasalukuyang password. Naka-store na may mode 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Username"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Dapat naipi-print na ASCII ang username"

