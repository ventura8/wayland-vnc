msgstr "Avslutt"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Klar til installering"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, ein klient; ikkje naudsynt for å servera"

