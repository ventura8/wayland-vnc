msgstr "Start ved pålogging"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Status"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Lagra (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Målretta"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Innstillingsvindauget treng GTK4 og libadwaita (installer python3-gi, gir1.2-gtk-4.0 og gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Innstillingsvindauget treng libadwaita %(needed)s eller nyare; dette systemet har %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Vindauget følgjer språket til skrivebordet med mindre du vel eit anna."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Dette skrivebordet serverer VNC via GNOME Remote Desktop, som godtek passord på høgst 8 teikn"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Motoren for dette skrivebordet lyttar alltid berre på denne datamaskina"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC-tenar, for KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Prøv eit anna søk."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Skriv inn desse i RealVNC Viewer på den andre eininga. Bruk auget for å visa gjeldande passord. Lagra med modus 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Brukarnamn"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Brukarnamnet må vera utskrivbar ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Vurdering"

