#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autentisering %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d grensesnitt for opptak/inndata"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d skrivebord"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s MANGLAR, og dette skrivebordet treng det"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: berre denne datamaskina. 0.0.0.0: alle nettverk denne datamaskina er kopla til, utan anna skjerming. Portar på 1024 og lågare vert avviste."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Ei innebygd Wayland-økt er påkravd; tilbakefall til X11 er forbode."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Om Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adresse"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Annonsert"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Alle til stades"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Bruk"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatisk (følg skrivebordet)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Bakende"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Bakende-kandidat"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Bakende på dette skrivebordet"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binærfiler"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Lytteadresse og -port"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adresse og port tekne i bruk"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Avbryt"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Vurdering av funksjonar"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Protokollar for opptak, virtuelt tastatur og virtuell peikar funne."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Lukk"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Oppsett"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Stadfest passord"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Kople til frå ei anna eining"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Kople denne maskina til Wi-Fi eller Ethernet, og opne deretter på nytt"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopier"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Fila med påloggingsinformasjon manglar brukarnamn eller passord"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Skrivebord"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Skrivebordstenester"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostikk"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Kvart val her endrar reelt oppsett eller den installerte tenesta."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Alt dette skrivebordet treng; ikkje installert: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop-tenar"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Den eigne tenesta til GNOME Eksternt skrivebord lyttar på alle nettverk; installer wayland-vnc-grd for å styra dette"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME-skjermkringkasting"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Generelt"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Legg til ei tilkopling til ei av desse adressene i RealVNC Viewer. Dei verkar så lenge tilgang frå lokalt nettverk er på, for alle einingar på same nettverk. Ikkje vidaresend porten frå internett."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installer pakken wayland-vnc for å få systemd-brukareininga"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin og portalgrensesnitt for opptak/inndata funne."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin krev begge portalgrensesnitta: ScreenCast og RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Tastatursnarvegar"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Tastatursnarvegar"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Språk"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Lat einingar på same Wi-Fi eller LAN kopla til. Av: berre denne datamaskina."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Lisens"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Tilgang frå lokalt nettverk"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Tilgang frå lokalt nettverk slått av"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Tilgang frå lokalt nettverk slått på"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Hovudmeny"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Gjer dette Wayland-skrivebordet tilgjengeleg frå RealVNC Viewer på telefonen din eller ei anna datamaskin. Det lyttar berre på denne datamaskina til du slår på Tilgang frå lokalt nettverk."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter-tenester for opptak og fjerninndata funne; privat bygg er påkravd."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Nei"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Ingen resultat funne"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Fann inga lokal nettverksadresse"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Ingen støtta bakende"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Ingen omsetjingar er installerte, så vindauget held fram på engelsk."

