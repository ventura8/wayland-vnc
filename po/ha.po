msgid "Bind Address and Port"
msgstr "Adireshi da tashar saurara"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "An aiwatar da adireshi da tasha"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Soke"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Hukuncin iyawa"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "An gano ka'idojin daukar hoto, madannai na kama-da-wane da alamar linzami ta kama-da-wane."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Rufe"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Saiti"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Tabbatar da kalmar sirri"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Hada daga wata na'ura"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Hada wannan na'ura da Wi-Fi ko Ethernet, sannan ka sake budewa"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kwafa"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Fayil din shaidar ba shi da sunan mai amfani ko kalmar sirri"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Tebur"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Hidimomin tebur"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Bincike"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Kowane zabi anan yana canza ainihin saiti ko hidimar da aka girka."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Duk abin da wannan tebur ke bukata; ba a girka ba: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Uwar garken GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Daemon na GNOME Tebur na Nesa da kansa yana saurara a kowace hanyar sadarwa; shigar da wayland-vnc-grd don sarrafa wannan"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Daukar allon GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Gabaɗaya"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "A cikin RealVNC Viewer, ƙara haɗi zuwa ɗaya daga cikin waɗannan adiresoshin. Suna aiki muddin an kunna shiga daga hanyar sadarwa ta gida, ga kowace na'ura a hanyar sadarwa ɗaya. Kada a tura tashar daga Intanet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Girka kunshin wayland-vnc domin samun sashin mai amfani na systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "An gano KWin da hanyoyin kofar shiga na daukar hoto/shigarwa."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin yana buƙatar duka madogaran ƙofa biyu: ScreenCast da RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Gajerun Hanyoyin Madannai"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Gajerun hanyoyin madannai"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Harshe"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Bari na'urori a Wi-Fi ko LAN ɗaya su haɗu. A kashe: wannan kwamfuta kawai."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Lasisi"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Shiga daga hanyar sadarwa ta gida"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "An kashe shiga daga hanyar sadarwa ta gida"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "An kunna shiga daga hanyar sadarwa ta gida"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Babban Menu"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Yana sa a iya isa ga wannan teburin Wayland daga RealVNC Viewer a wayarka ko wata na'ura. Yana saurare a wannan na'ura kadai har sai ka kunna Shiga daga hanyar sadarwa ta gida."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "An gano hidimomin daukar hoto da shigarwa ta nesa na Mutter; ana bukatar gini na musamman."

