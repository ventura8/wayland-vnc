#, python-format
msgid "Stored (%s)"
msgstr "An ajiye (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "An nufa"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Tagar saituna tana bukatar GTK4 da libadwaita (girka python3-gi, gir1.2-gtk-4.0 da gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Tagar saituna tana bukatar libadwaita %(needed)s ko sabo; wannan tsarin yana da %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Taga na bin harshen teburin ku sai dai idan kun zabi wani."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Wannan tebur yana hidimar VNC ta GNOME Remote Desktop, wanda ke karɓar kalmomin sirri na haruffa 8 a mafi yawa"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Bayan gida na wannan tebur koyaushe yana saurara a wannan kwamfuta kawai"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Uwar garken TigerVNC, don KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Gwada wani nema daban."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Rubuta wadannan a cikin RealVNC Viewer a kan dayan na'urar. Yi amfani da alamar ido don nuna kalmar sirri ta yanzu. An ajiye da yanayin 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Sunan mai amfani"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Sunan mai amfani dole ya kasance ASCII mai bugawa"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Hukunci"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Shaidar mai kallo"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "An ajiye kalmar sirri ta mai kallo"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Uwar garken WayVNC, don masu haɗa wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Ka'idojin Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Abin da wannan tebur ke sanarwa, da ma'anarsa ga shiga daga nesa."

