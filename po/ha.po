#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), tantancewa %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "Hanyoyin daukar hoto/shigarwa %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "Tebura %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s BA YA NAN kuma wannan tebur yana bukatarsa"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: wannan kwamfuta kawai. 0.0.0.0: kowace hanyar sadarwa da wannan kwamfuta ta haɗu da ita, ba tare da wata shinge ba. Ana ƙin tashoshi 1024 da ƙasa."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Ana bukatar zaman Wayland na asali; an haramta komawa zuwa X11."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Game da Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adireshi"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "An sanar"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Duk suna nan"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Aiwatar"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Ta atomatik (bi tebur)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Injin baya"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Dan takarar injin baya"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
