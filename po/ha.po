msgstr "yanayi %s (a bude sosai)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "yanayi 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "wannan na'ura kadai"

