msgstr "এই ডেস্কটপে GNOME Remote Desktop-ৰ জৰিয়তে VNC সেৱা দিয়ে, যি সৰ্বাধিক ৮টা আখৰৰ পাছৱৰ্ড গ্ৰহণ কৰে"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "এই ডেস্কটপৰ বেকএণ্ডে সদায় কেৱল এই কম্পিউটাৰতে শুনে"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC চাৰ্ভাৰ, KDE Plasma-ৰ বাবে"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "অন্য সন্ধান চেষ্টা কৰক।"

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "এইবোৰ অন্য ডিভাইচৰ RealVNC Viewer-ত টাইপ কৰক। বৰ্তমান পাছৱৰ্ড দেখুৱাবলৈ চকু ব্যৱহাৰ কৰক। মোড 600-ৰ সৈতে সংৰক্ষিত।"

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "ব্যৱহাৰকাৰীৰ নাম"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "ব্যৱহাৰকাৰীৰ নাম মুদ্ৰণযোগ্য ASCII হ'ব লাগিব"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "ৰায়"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "ভিউৱাৰ পৰিচয়পত্ৰ"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "ভিউৱাৰ পাছৱৰ্ড সংৰক্ষিত হ'ল"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC চাৰ্ভাৰ, wlroots কম্পোজিটৰৰ বাবে"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland প্ৰ'ট'কল"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "এই ডেস্কটপে কি ঘোষণা কৰে, আৰু দূৰৱৰ্তী প্ৰৱেশৰ বাবে ইয়াৰ অৰ্থ কি।"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "হয়"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "এই কম্পিউটাৰ সংযুক্ত হৈ থকা প্ৰতিটো নেটৱৰ্ক"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "কেৱল স্থানীয় নেটৱৰ্ক"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS নাম"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "মোড %s (অতি মুকলি)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "মোড 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "কেৱল এই মেচিন"

