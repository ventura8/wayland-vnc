#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Σύνδεση από άλλη συσκευή"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Συνδέστε αυτό το μηχάνημα σε Wi-Fi ή Ethernet και ανοίξτε ξανά"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Αντιγραφή"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Από το αρχείο διαπιστευτηρίων λείπει όνομα χρήστη ή κωδικός"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Επιφάνεια εργασίας"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Υπηρεσίες επιφάνειας εργασίας"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Διαγνωστικά"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Κάθε επιλογή εδώ αλλάζει πραγματική διαμόρφωση ή την εγκατεστημένη υπηρεσία."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Ό,τι χρειάζεται αυτή η επιφάνεια εργασίας· δεν είναι εγκατεστημένα: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Διακομιστής GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Ο δικός του δαίμονας του GNOME Απομακρυσμένης επιφάνειας εργασίας ακούει σε κάθε δίκτυο· εγκαταστήστε το wayland-vnc-grd για να το ελέγξετε"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Καταγραφή οθόνης GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Γενικά"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Στο RealVNC Viewer προσθέστε μια σύνδεση σε μία από αυτές τις διευθύνσεις. Λειτουργούν όσο η πρόσβαση από το τοπικό δίκτυο είναι ενεργή, για κάθε συσκευή στο ίδιο δίκτυο. Μην προωθείτε τη θύρα από το Διαδίκτυο."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Εγκαταστήστε το πακέτο wayland-vnc για να αποκτήσετε τη μονάδα χρήστη systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Εντοπίστηκαν το KWin και οι διεπαφές πύλης καταγραφής/εισόδου."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "Το KWin απαιτεί και τις δύο διεπαφές πυλών: ScreenCast και RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Συντομεύσεις πληκτρολογίου"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Συντομεύσεις πληκτρολογίου"

