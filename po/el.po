msgstr "Αποθηκευμένο (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Στοχευμένο"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Το παράθυρο ρυθμίσεων χρειάζεται GTK4 και libadwaita (εγκαταστήστε python3-gi, gir1.2-gtk-4.0 και gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Το παράθυρο ρυθμίσεων χρειάζεται libadwaita %(needed)s ή νεότερη· αυτό το σύστημα έχει %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Το παράθυρο ακολουθεί τη γλώσσα της επιφάνειας εργασίας, εκτός αν επιλέξετε άλλη."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Αυτή η επιφάνεια εργασίας εξυπηρετεί VNC μέσω GNOME Remote Desktop, που δέχεται κωδικούς το πολύ 8 χαρακτήρων"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Το σύστημα υποστήριξης αυτής της επιφάνειας εργασίας ακούει πάντα μόνο σε αυτόν τον υπολογιστή"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Διακομιστής TigerVNC, για το KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Δοκιμάστε μια διαφορετική αναζήτηση."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Πληκτρολογήστε τα στο RealVNC Viewer στην άλλη συσκευή. Χρησιμοποιήστε το μάτι για να αποκαλύψετε τον τρέχοντα κωδικό. Αποθηκευμένο με λειτουργία 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Όνομα χρήστη"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Το όνομα χρήστη πρέπει να είναι εκτυπώσιμο ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Ετυμηγορία"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Διαπιστευτήρια προβολέα"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Ο κωδικός προβολέα αποθηκεύτηκε"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Διακομιστής WayVNC, για συνθέτες wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Πρωτόκολλα Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Τι ανακοινώνει αυτή η επιφάνεια εργασίας και τι σημαίνει για την απομακρυσμένη πρόσβαση."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ναι"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "κάθε δίκτυο στο οποίο είναι συνδεδεμένος αυτός ο υπολογιστής"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "μόνο τοπικό δίκτυο"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "Όνομα mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "λειτουργία %s (πολύ ανοιχτή)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "λειτουργία 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "μόνο αυτό το μηχάνημα"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
