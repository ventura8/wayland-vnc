msgid "Language"
msgstr "Γλώσσα"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Να επιτρέπεται η σύνδεση συσκευών στο ίδιο Wi-Fi ή LAN. Ανενεργό: μόνο αυτός ο υπολογιστής."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Άδεια χρήσης"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Πρόσβαση από το τοπικό δίκτυο"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Η πρόσβαση από το τοπικό δίκτυο απενεργοποιήθηκε"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Η πρόσβαση από το τοπικό δίκτυο ενεργοποιήθηκε"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Κύριο μενού"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Καθιστά αυτή την επιφάνεια εργασίας Wayland προσβάσιμη από το RealVNC Viewer στο τηλέφωνό σας ή σε άλλον υπολογιστή. Ακούει μόνο σε αυτόν τον υπολογιστή μέχρι να ενεργοποιήσετε την «Πρόσβαση από το τοπικό δίκτυο»."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Εντοπίστηκαν οι υπηρεσίες καταγραφής και απομακρυσμένης εισόδου του Mutter· απαιτείται ιδιωτική έκδοση."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Όχι"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Δεν βρέθηκαν αποτελέσματα"

