msgstr "χρησιμοποιείται για τον έλεγχο των πρωτοκόλλων Wayland"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "χρησιμοποιείται για τον έλεγχο των πυλών μέσω D-Bus"

#~ msgid "Qualification"
#~ msgstr "Πιστοποίηση"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "Το 0.0.0.0 κάνει τον διακομιστή προσβάσιμο από συσκευές του τοπικού σας δικτύου· η υπηρεσία εξακολουθεί να αποκλείει το διαδίκτυο. Το 127.0.0.1 τον περιορίζει σε αυτό το μηχάνημα. Θύρες έως και 1024 απορρίπτονται."

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "μόνο τοπικό δίκτυο· το διαδίκτυο αποκλείεται από τη μονάδα"
