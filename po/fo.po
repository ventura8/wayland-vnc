msgid "Server Configuration"
msgstr "Ambætarauppseting"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "Tænasta"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "Seta"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "Setuslag"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "Set loyniorð"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "Set loyniorð hjá sýnara"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "Set fyrst eitt loyniorð hjá sýnara"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "Byrja við innritan"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Støða"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Goymt (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Miðað"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Stillingarvindeygað hevur tørv á GTK4 og libadwaita (installera python3-gi, gir1.2-gtk-4.0 og gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Stillingarvindeygað hevur tørv á libadwaita %(needed)s ella nýggjari; hetta skipanin hevur %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Vindeygað fylgir málinum á tínum skriviborði, uttan so at tú velur eitt annað."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Hetta skriviborðið tænir VNC um GNOME Remote Desktop, sum tekur við loyniorðum við í mesta lagi 8 teknum"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Bakendin hjá hesum skriviborðinum lurtar altíð bert á hesi teldu"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC-ambætari, til KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Royn eina aðra leiting."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Skriva hesi inn í RealVNC Viewer á hinum tólinum. Nýt eygað at vísa núverandi loyniorðið. Goymt við støðu 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Brúkaranavn"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Brúkaranavnið má vera prentandi ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Meting"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Atgongdarupplýsingar hjá sýnara"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Loyniorð hjá sýnara goymt"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC-ambætari, til wlroots-samansetarar"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland-protokollir"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Hvat hetta skriviborðið kunnger, og hvat tað merkir fyri fjaratgongd."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ja"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "øll net, sum hendan teldan er knýtt at"

