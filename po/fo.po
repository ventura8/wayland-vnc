#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), váttan %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d upptøku-/inntaksmarkamót"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d skriviborð"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s VANTAR, og hetta skriviborðið hevur tørv á tí"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: bert hendan telda. 0.0.0.0: øll net, sum hendan teldan er knýtt at, uttan aðra verju. Portur 1024 og lægri verða avvíst."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Ein innbygd Wayland-seta er kravd; at falla aftur til X11 er bannað."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Um Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adressa"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Kunngjørt"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Alt til staðar"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Nýt"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Sjálvvirkið (fylg skriviborðinum)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Bakendi"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Bakendakandidatur"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Bakendi á hesum skriviborðinum"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binerar fílur"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Lurtaradressa og -portur"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adressa og portur nýtt"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Angra"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Meting av førleikum"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Protokollir fyri upptøku, virtuelt knappaborð og virtuellan vísara funnar."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Lat aftur"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Uppseting"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Vátta loyniorð"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Sambind frá einum øðrum tóli"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Sambind hesa maskinuna við Wi-Fi ella Ethernet, og lat so upp aftur"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Avrita"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Fílan við atgongdarupplýsingum vantar brúkaranavn ella loyniorð"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Skriviborð"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Skriviborðstænastur"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostikkur"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Hvørt val her broytir veruliga uppseting ella ta installeraðu tænastuna."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Alt, sum hetta skriviborðið hevur tørv á; ikki installerað: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop-ambætari"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Egni tænastan hjá GNOME Fjarskriviborði lurtar á øllum netum; legg wayland-vnc-grd inn fyri at stýra hesum"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME skíggjaútsending"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Alment"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Legg í RealVNC Viewer eina sambinding afturat til eina av hesum adressum. Tær rigga, meðan atgongd frá lokala netinum er tendrað, fyri hvørja eind á sama neti. Send ikki portrið víðari frá internetinum."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installera pakkan wayland-vnc fyri at fáa systemd-brúkaraeindina"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin og portalmarkamót fyri upptøku/inntak funnin."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin krevur báðar portalmarkamótini: ScreenCast og RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Knappaborðssnarvegir"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Knappaborðssnarvegir"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Mál"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Lat eindir á sama Wi-Fi ella LAN knýta seg. Sløkt: bert hendan telda."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Loyvi"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Atgongd frá lokala netinum"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Atgongd frá lokala netinum er sløkt"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Atgongd frá lokala netinum er tendrað"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Høvuðsvalmynd"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Ger hetta Wayland-skriviborðið atkomuligt frá RealVNC Viewer á tínum telefoni ella einari aðrari teldu. Tað lurtar bert á hesi teldu, til tú tendrar Atgongd frá lokala netinum."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter-tænastur fyri upptøku og fjarinntak funnar; privat bygging er kravd."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Nei"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Eingi úrslit funnin"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Eingin lokal netadressa funnin"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Eingin stuðlaður bakendi"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Eingar týðingar eru installeraðar, so vindeygað verður á enskum."

