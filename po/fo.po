msgstr "mDNS-navn"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "støða %s (ov opin)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "støða 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "bert henda maskinan"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "eindin er ikki installerað"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "ókent"

