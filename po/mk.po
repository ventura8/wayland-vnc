msgid "GNOME Screencast"
msgstr "GNOME емитување на екранот"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Општо"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Во RealVNC Viewer додајте врска до една од овие адреси. Тие работат додека пристапот од локалната мрежа е вклучен, за секој уред на истата мрежа. Не ја проследувајте портата од Интернет."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Инсталирајте го пакетот wayland-vnc за да ја добиете systemd корисничката единица"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Откриени се KWin и интерфејсите на порталот за снимање/внес."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin ги бара двата портални интерфејси: ScreenCast и RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Кратенки на тастатура"

