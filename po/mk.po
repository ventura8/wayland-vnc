msgid "Diagnostics"
msgstr "Дијагностика"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Секоја опција тука менува вистинска конфигурација или инсталиран сервис."

