#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), автентикација %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d интерфејси за снимање/внес"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d работни површини"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s НЕДОСТАСУВА, а оваа работна површина го бара"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: само овој компјутер. 0.0.0.0: сите мрежи на кои е поврзан овој компјутер, без никаква друга заштита. Портите 1024 и пониски се одбиваат."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Потребна е изворна Wayland сесија; враќање на X11 е забрането."

