msgstr "modus %s (for åpen)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "modus 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "kun denne maskinen"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "enheten er ikke installert"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "ukjent"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "brukes til å undersøke Wayland-protokoller"

