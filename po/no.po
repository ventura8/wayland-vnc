msgid "Quit"
msgstr "Avslutt"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Klar til installering"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, en klient; ikke nødvendig for å servere"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Årsak"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Utgivelsesmål"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "RemoteDesktop-portal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Rapporter et problem"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "De nødvendige funksjonene for opptak OG inndata ble ikke funnet."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "Kjører nå"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "Lagre"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "ScreenCast-portal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
msgstr "Søk"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search diagnostics"
msgstr "Søk i diagnostikk"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search languages"
msgstr "Søk etter språk"

#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "Leveres av GNOME Remote Desktop VNC (port 5900); eksponering følger GNOME-innstillinger > Deling"

#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "Tjeneroppsett"

#: src/wayland_vnc/settings_app.py
msgid "Service"
