#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "Angi passord"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "Angi visningspassord"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "Angi et visningspassord først"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "Start ved pålogging"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Status"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Lagret (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Målrettet"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Innstillingsvinduet trenger GTK4 og libadwaita (installer python3-gi, gir1.2-gtk-4.0 og gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Innstillingsvinduet trenger libadwaita %(needed)s eller nyere; dette systemet har %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Vinduet følger skrivebordets språk med mindre du velger et annet."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Dette skrivebordet serverer VNC via GNOME Remote Desktop, som godtar passord på høyst 8 tegn"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Motoren for dette skrivebordet lytter alltid bare på denne datamaskinen"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC-tjener, for KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Prøv et annet søk."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Skriv inn disse i RealVNC Viewer på den andre enheten. Bruk øyet for å vise gjeldende passord. Lagret med modus 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Brukernavn"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Brukernavnet må være utskrivbar ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Vurdering"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Visningspåloggingsinformasjon"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Visningspassord lagret"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC-tjener, for wlroots-kompositorer"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland-protokoller"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Hva dette skrivebordet annonserer, og hva det betyr for fjerntilgang."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ja"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "alle nettverk denne datamaskinen er koblet til"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "bare lokalt nettverk"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS-navn"

#: src/wayland_vnc/settings_app.py
#, python-format
