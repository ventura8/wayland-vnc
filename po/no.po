#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autentisering %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d grensesnitt for opptak/inndata"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d skrivebord"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s MANGLER, og dette skrivebordet trenger det"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: bare denne datamaskinen. 0.0.0.0: alle nettverk denne datamaskinen er koblet til, uten annen skjerming. Porter på 1024 og lavere avvises."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "En innebygd Wayland-økt kreves; tilbakefall til X11 er forbudt."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Om Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adresse"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Annonsert"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Alle til stede"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Bruk"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatisk (følg skrivebordet)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Bakende"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Bakende-kandidat"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Bakende på dette skrivebordet"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binærfiler"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Lytteadresse og -port"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adresse og port tatt i bruk"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Avbryt"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Vurdering av funksjoner"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Protokoller for opptak, virtuelt tastatur og virtuell peker funnet."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Lukk"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Oppsett"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Bekreft passord"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Koble til fra en annen enhet"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Koble denne maskinen til Wi-Fi eller Ethernet, og åpne deretter på nytt"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopier"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Filen med påloggingsinformasjon mangler brukernavn eller passord"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Skrivebord"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Skrivebordstjenester"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostikk"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Hvert valg her endrer reelt oppsett eller den installerte tjenesten."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Alt dette skrivebordet trenger; ikke installert: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop-tjener"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME Eksternt skrivebords egen tjeneste lytter på alle nettverk; installer wayland-vnc-grd for å styre dette"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME-skjermkringkasting"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Generelt"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Legg til en tilkobling til en av disse adressene i RealVNC Viewer. De virker så lenge tilgang fra lokalt nettverk er på, for alle enheter på samme nettverk. Ikke videresend porten fra internett."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installer pakken wayland-vnc for å få systemd-brukerenheten"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin og portalgrensesnitt for opptak/inndata funnet."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin krever begge portalgrensesnittene: ScreenCast og RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Tastatursnarveier"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Tastatursnarveier"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Språk"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "La enheter på samme Wi-Fi eller LAN koble til. Av: bare denne datamaskinen."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Lisens"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Tilgang fra lokalt nettverk"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Tilgang fra lokalt nettverk slått av"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Tilgang fra lokalt nettverk slått på"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Hovedmeny"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Gjør dette Wayland-skrivebordet tilgjengelig fra RealVNC Viewer på telefonen din eller en annen datamaskin. Det lytter bare på denne datamaskinen til du slår på Tilgang fra lokalt nettverk."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter-tjenester for opptak og fjerninndata funnet; privat bygg kreves."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Nei"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Ingen resultater funnet"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Fant ingen lokal nettverksadresse"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Ingen støttet bakende"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Ingen oversettelser er installert, så vinduet forblir på engelsk."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "None"
msgstr "Ingen"

#: src/wayland_vnc/settings.py
msgid "None advertised"
msgstr "Ingen annonsert"

#: src/wayland_vnc/settings.py
msgid "None available"
msgstr "Ingen tilgjengelig"

#: src/wayland_vnc/settings.py
msgid "None checked"
msgstr "Ingen kontrollert"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "None detected"
msgstr "Ingen funnet"

#: src/wayland_vnc/settings.py
