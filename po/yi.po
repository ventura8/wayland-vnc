msgid "Credentials file is missing a username or password"
msgstr "אין דער באַגלויביקונג טעקע פֿעלט אַ באַניצער נאָמען אָדער פּאַראָל"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "דעסקטאָפּ"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "דעסקטאָפּ סערוויסן"

