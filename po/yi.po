msgid "Language"
msgstr "שפּראַך"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "לאָזן מכשירים אויף דעם זעלבן Wi-Fi אָדער LAN זיך פֿאַרבינדן. אויסגעשטעלט: נאָר דער דאָזיקער קאָמפּיוטער."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "ליצענץ"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "צוטריט פֿון דער לאָקאַלער נעץ"

