msgid "Stored (%s)"
msgstr "אויפֿגעהיט (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "געצילט"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "דער אײַנשטעלונגען פֿענצטער דאַרף GTK4 און libadwaita (אינסטאַלירט python3-gi, gir1.2-gtk-4.0 און gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "דער אײַנשטעלונגען פֿענצטער דאַרף libadwaita %(needed)s אָדער נײַער; די סיסטעם האָט %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "דער פֿענצטער גייט נאָך דער שפּראַך פֿון אײַער דעסקטאָפּ, סײַדן איר קלײַבט אַן אַנדערע."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "דער דעסקטאָפּ סערווירט VNC דורך GNOME Remote Desktop, וואָס נעמט אָן פּאַראָלן פֿון העכסטנס 8 צייכנס"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "דער הינטערגרונט־סיסטעם פֿון דעם דעסקטאָפּ הערט שטענדיק נאָר אויף דעם קאָמפּיוטער"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC סערווער, פֿאַר KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "פּרוּווט אַן אַנדער זוך."

#: src/wayland_vnc/settings_dialogs.py
