msgid "Bind Address and Port"
msgstr "Chomlec'h ha porzh selaou"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Arloet eo bet ar chomlec'h hag ar porzh"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Nullañ"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Barn ar barregezhioù"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Kavet eo bet komenadoù pakañ, klavier galloudel ha biz galloudel."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Serriñ"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Kefluniadur"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Kadarnaat ar ger-tremen"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Kennaskañ eus un trevnad all"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Kennaskit an ardivink-mañ ouzh Wi-Fi pe Ethernet, ha digorit en-dro"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Eilañ"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Mankout a ra un anv arveriad pe ur ger-tremen er restr dilesa"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Burev"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Servijoù ar burev"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostik"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Pep dibarzh amañ a gemm ar c'hefluniadur gwir pe ar servij staliet."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Kement tra en deus ezhomm ar burev-mañ; nann staliet: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Dafariad GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Daemon dezhañ e-unan Burev a-bell GNOME a selaou war an holl rouedadoù; staliit wayland-vnc-grd evit mestroniañ an dra-se"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Skignañ skramm GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Hollek"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "E RealVNC Viewer, ouzhpennit ur c'hevreadenn ouzh unan eus ar chomlec'hioù-mañ. Mont a reont en-dro keit ha ma vez enaouet ar moned eus ar rouedad lec'hel, evit pep benveg war an hevelep rouedad. Na adkasit ket ar porzh eus Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Staliit ar pakad wayland-vnc evit kaout unanenn arveriad systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Kavet eo bet KWin ha ketalioù porched pakañ/enankañ."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin en deus ezhomm an div etrefas porched ScreenCast ha RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Berradennoù klavier"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Berradennoù klavier"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Yezh"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Aotren ar binvioù war an hevelep Wi-Fi pe LAN da gevreañ. Lazhet: an urzhiataer-mañ hepken."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Aotre-implijout"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Moned eus ar rouedad lec'hel"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Lazhet eo bet ar moned eus ar rouedad lec'hel"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Enaouet eo bet ar moned eus ar rouedad lec'hel"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Lañser pennañ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Lakaat a ra ar burev Wayland-mañ da vezañ tizhet eus RealVNC Viewer war ho pellgomzer pe un urzhiataer all. Ne selaou nemet war an urzhiataer-mañ betek ma vo enaouet Moned eus ar rouedad lec'hel ganeoc'h."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Kavet eo bet servijoù pakañ hag enankañ a-bell Mutter; ret eo ur savadur prevez."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Ket"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Disoc'h ebet kavet"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Chomlec'h rouedad lec'hel ebet kavet"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Dre-dreñv skoret ebet"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "N'eus troidigezh ebet staliet, neuze e chom ar prenestr e saozneg."

