msgstr "Stad"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Enrollet (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Palet"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Ezhomm en deus prenestr an arventennoù eus GTK4 ha libadwaita (staliit python3-gi, gir1.2-gtk-4.0 ha gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Ezhomm en deus prenestr an arventennoù eus libadwaita %(needed)s pe nevesoc'h; %(found)s en deus ar reizhiad-mañ"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Heuliañ a ra ar prenestr yezh ho purev nemet ma tibabit unan all."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Ar burev-mañ a servij VNC dre GNOME Remote Desktop, hag a zegemer gerioù-tremen a 8 arouezenn d'ar muiañ"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Keflusker ar burev-mañ a selaou atav war an urzhiataer-mañ hepken"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Dafariad TigerVNC, evit KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Klaskit gant ur c'hlask all."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Skrivit ar re-mañ e RealVNC Viewer war an trevnad all. Implijit al lagad evit diskouez ar ger-tremen a-vremañ. Enrollet gant ar mod 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Anv arveriad"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Rankout a ra an anv arveriad bezañ ASCII moulus"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Barn"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Dilesa ar gweler"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Enrollet eo bet ger-tremen ar gweler"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Dafariad WayVNC, evit ar c'hompozerien wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Komenadoù Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Ar pezh a embann ar burev-mañ, ha petra a dalvez evit an haeziñ a-bell."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ya"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "an holl rouedadoù a zo kevreet an urzhiataer-mañ outo"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "ar rouedad lec'hel hepken"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "Anv mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "mod %s (re zigor)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "mod 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "an ardivink-mañ hepken"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "n'eo ket staliet an unanenn"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "dianav"

#: src/wayland_vnc/settings.py
