#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), dilesa %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d ketal pakañ/enankañ"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d burev"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "Mankout a ra %s hag ezhomm en deus ar burev-mañ anezhañ"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: an urzhiataer-mañ hepken. 0.0.0.0: an holl rouedadoù a zo kevreet an urzhiataer-mañ outo, hep gwarez all ebet. Nac'het eo ar porzhioù 1024 hag izeloc'h."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Ret eo un estez Wayland natur; difennet eo distreiñ da X11."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Diwar-benn Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Chomlec'h"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Embannet"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Pep tra a zo"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Arloañ"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Emgefre (hervez ar burev)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Dre-dreñv"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Dre-dreñv kinniget"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Dre-dreñv war ar burev-mañ"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Restroù binarel"

