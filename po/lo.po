#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "ໃຫ້ບໍລິການໂດຍ GNOME Remote Desktop VNC (ພອດ 5900); ການເປີດເຜີຍເປັນໄປຕາມການຕັ້ງຄ່າ GNOME > ການແບ່ງປັນ"

#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "ການຕັ້ງຄ່າເຊີບເວີ"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "ບໍລິການ"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "ເຊດຊັນ"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "ປະເພດເຊດຊັນ"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "ຕັ້ງລະຫັດຜ່ານ"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "ຕັ້ງລະຫັດຜ່ານຜູ້ເບິ່ງ"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "ຕັ້ງລະຫັດຜ່ານຜູ້ເບິ່ງກ່ອນ"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "ເລີ່ມເມື່ອເຂົ້າສູ່ລະບົບ"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "ສະຖານະ"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "ບັນທຶກແລ້ວ (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "ກຳນົດເປົ້າໝາຍແລ້ວ"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "ໜ້າຕ່າງການຕັ້ງຄ່າຕ້ອງການ GTK4 ແລະ libadwaita (ຕິດຕັ້ງ python3-gi, gir1.2-gtk-4.0 ແລະ gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "ໜ້າຕ່າງການຕັ້ງຄ່າຕ້ອງການ libadwaita %(needed)s ຫຼືໃໝ່ກວ່າ; ລະບົບນີ້ມີ %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "ໜ້າຕ່າງໃຊ້ພາສາໜ້າຈໍຂອງທ່ານ ເວັ້ນແຕ່ທ່ານເລືອກພາສາອື່ນ."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "ເດັສທັອບນີ້ໃຫ້ບໍລິການ VNC ຜ່ານ GNOME Remote Desktop ເຊິ່ງຮັບລະຫັດຜ່ານໄດ້ບໍ່ເກີນ 8 ຕົວອັກສອນ"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "ແບັກເອັນຂອງເດັສທັອບນີ້ຮັບຟັງສະເພາະຢູ່ຄອມພິວເຕີເຄື່ອງນີ້ສະເໝີ"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "ເຊີບເວີ TigerVNC ສຳລັບ KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "ລອງຄົ້ນຫາອື່ນ."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "ພິມສິ່ງເຫຼົ່ານີ້ໃນ RealVNC Viewer ໃນອຸປະກອນອື່ນ. ໃຊ້ຕາເພື່ອສະແດງລະຫັດຜ່ານປັດຈຸບັນ. ບັນທຶກດ້ວຍໂໝດ 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "ຊື່ຜູ້ໃຊ້"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "ຊື່ຜູ້ໃຊ້ຕ້ອງເປັນ ASCII ທີ່ພິມໄດ້"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "ຄຳຕັດສິນ"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "ຂໍ້ມູນຢືນຢັນຜູ້ເບິ່ງ"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "ບັນທຶກລະຫັດຜ່ານຜູ້ເບິ່ງແລ້ວ"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "ເຊີບເວີ WayVNC ສຳລັບຕົວປະກອບ wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "ໂປຣໂຕຄອນ Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "ໜ້າຈໍນີ້ປະກາດຫຍັງ, ແລະມັນໝາຍເຖິງຫຍັງສຳລັບການເຂົ້າເຖິງທາງໄກ."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "ແມ່ນ"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "ທຸກເຄືອຂ່າຍທີ່ຄອມພິວເຕີເຄື່ອງນີ້ເຊື່ອມຕໍ່ຢູ່"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "ສະເພາະເຄືອຂ່າຍທ້ອງຖິ່ນ"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "ຊື່ mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "ໂໝດ %s (ເປີດເກີນໄປ)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "ໂໝດ 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "ເຄື່ອງນີ້ເທົ່ານັ້ນ"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "ຫົວໜ່ວຍບໍ່ໄດ້ຕິດຕັ້ງ"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "ບໍ່ຮູ້"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "ໃຊ້ເພື່ອກວດສອບໂປຣໂຕຄອນ Wayland"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "ໃຊ້ເພື່ອກວດສອບປະຕູຜ່ານ D-Bus"

#~ msgid "Qualification"
#~ msgstr "ຄຸນວຸດທິ"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "0.0.0.0 ເຮັດໃຫ້ເຊີບເວີເຂົ້າເຖິງໄດ້ຈາກອຸປະກອນໃນເຄືອຂ່າຍທ້ອງຖິ່ນຂອງທ່ານ; ບໍລິການຍັງບລັອກອິນເຕີເນັດ. 127.0.0.1 ຈຳກັດມັນໄວ້ກັບເຄື່ອງນີ້. ພອດ 1024 ແລະຕ່ຳກວ່າຖືກປະຕິເສດ."

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "ເຄືອຂ່າຍທ້ອງຖິ່ນເທົ່ານັ້ນ; ອິນເຕີເນັດຖືກບລັອກໂດຍຫົວໜ່ວຍ"
