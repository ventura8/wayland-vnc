msgid "Language"
msgstr "ພາສາ"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "ອະນຸຍາດໃຫ້ອຸປະກອນໃນ Wi-Fi ຫຼື LAN ດຽວກັນເຊື່ອມຕໍ່. ປິດ: ສະເພາະຄອມພິວເຕີເຄື່ອງນີ້."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "ໃບອະນຸຍາດ"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "ການເຂົ້າເຖິງຈາກເຄືອຂ່າຍທ້ອງຖິ່ນ"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "ປິດການເຂົ້າເຖິງຈາກເຄືອຂ່າຍທ້ອງຖິ່ນແລ້ວ"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "ເປີດການເຂົ້າເຖິງຈາກເຄືອຂ່າຍທ້ອງຖິ່ນແລ້ວ"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "ເມນູຫຼັກ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "ເຮັດໃຫ້ໜ້າຈໍ Wayland ນີ້ເຂົ້າເຖິງໄດ້ຈາກ RealVNC Viewer ໃນໂທລະສັບ ຫຼືຄອມພິວເຕີເຄື່ອງອື່ນຂອງທ່ານ. ມັນຈະຮັບຟັງສະເພາະໃນຄອມພິວເຕີເຄື່ອງນີ້ ຈົນກວ່າທ່ານຈະເປີດ ການເຂົ້າເຖິງຈາກເຄືອຂ່າຍທ້ອງຖິ່ນ."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "ພົບບໍລິການຈັບພາບ ແລະປ້ອນຂໍ້ມູນທາງໄກຂອງ Mutter; ຕ້ອງການການສ້າງສ່ວນຕົວ."

