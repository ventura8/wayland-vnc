#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autentificacion %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d interfàcias de captura/entrada"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d burèus"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s MANCA e aqueste burèu n'a besonh"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1 : aqueste ordenador solament. 0.0.0.0 : totas las rets a las qualas aqueste ordenador es connectat, sens cap d'autra barrièra. Los pòrts 1024 e inferiors son refusats."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Una session Wayland nativa es requerida; tornar a X11 es interdich."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "A prepaus de Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adreça"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Anonciat"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Tot present"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Aplicar"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatic (segon lo burèu)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Candidat backend"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Backend sus aqueste burèu"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binaris"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Adreça e pòrt d'escota"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adreça e pòrt aplicats"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Anullar"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Verdicte de las capacitats"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Protocòls de captura, clavièr virtual e puntador virtual detectats."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Tampar"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Configuracion"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Confirmar lo senhal"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Se connectar dempuèi un autre aparelh"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Connectatz aquesta maquina al Wi-Fi o a l'Ethernet, puèi dobrissètz tornarmai"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Copiar"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Lo fichièr d'identificants a pas de nom d'utilizaire o de senhal"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Burèu"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Servicis del burèu"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostic"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Cada opcion aicí càmbia la configuracion reala o lo servici installat."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Tot çò qu'aqueste burèu necessita; pas installat: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Servidor GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Lo demòni pròpri del Burèu distant de GNOME escota sus totas las rets ; installatz wayland-vnc-grd per o contrarotlar"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Difusion d'ecran GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "General"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Dins RealVNC Viewer, apondètz una connexion cap a una d'aquestas adreças. Foncionan tant que l'accès dempuèi la ret locala es activat, per tot aparelh de la meteissa ret. Redirigiscatz pas lo pòrt dempuèi Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installatz lo paquet wayland-vnc per obténer l'unitat utilizaire systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin e interfàcias de portal de captura/entrada detectats."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin a besonh de las doas interfàcias de portal : ScreenCast e RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Acorchis de clavièr"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Acorchis de clavièr"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Lenga"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Autorizar los aparelhs del meteis Wi-Fi o LAN a se connectar. Desactivat : aqueste ordenador solament."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licéncia"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Accès dempuèi la ret locala"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Accès dempuèi la ret locala desactivat"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Accès dempuèi la ret locala activat"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menú principal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Rend aqueste burèu Wayland accessible dempuèi RealVNC Viewer sus vòstre telefòn o un autre ordenador. Escota pas que sus aqueste ordenador fins que activetz l'Accès dempuèi la ret locala."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Servicis Mutter de captura e d'entrada distanta detectats; una compilacion privada es requerida."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Non"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Cap de resultat trobat"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Cap d'adreça de ret locala trobada"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Cap de backend pres en carga"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Cap de traduccion es pas installada, alara la fenèstra demòra en anglés."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "None"
msgstr "Cap"

#: src/wayland_vnc/settings.py
msgid "None advertised"
msgstr "Cap d'anonciat"

#: src/wayland_vnc/settings.py
msgid "None available"
msgstr "Cap de disponible"

#: src/wayland_vnc/settings.py
msgid "None checked"
msgstr "Cap de verificat"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "None detected"
msgstr "Cap de detectat"

#: src/wayland_vnc/settings.py
msgid "Not advertised"
msgstr "Pas anonciat"

#: src/wayland_vnc/settings.py
msgid "Not checked"
msgstr "Pas verificat"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Not installed"
msgstr "Pas installat"

#: src/wayland_vnc/settings_app.py
msgid "Not provisioned"
msgstr "Pas preparat"

#: src/wayland_vnc/settings_app.py
msgid "Not set"
msgstr "Pas definit"

#: src/wayland_vnc/settings_app.py
msgid "Open the main menu"
msgstr "Dobrir lo menú principal"

#: src/wayland_vnc/settings_app.py
msgid "PUBLIC ADDRESS - reachable beyond the local network"
msgstr "ADREÇA PUBLICA - accessible al delà de la ret locala"

#: src/wayland_vnc/settings_dialogs.py
msgid "Password"
msgstr "Senhal"

#: src/wayland_vnc/runtime.py
msgid "Password must be 6-64 ASCII characters"
msgstr "Lo senhal deu far 6–64 caractèrs ASCII"

#: src/wayland_vnc/settings_dialogs.py src/wayland_vnc/runtime.py
msgid "Passwords did not match"
msgstr "Los senhals correspondon pas"

#: src/wayland_vnc/settings_dialogs.py
msgid "Port"
msgstr "Pòrt"

#: src/wayland_vnc/runtime.py
msgid "Port must be an unprivileged TCP port"
msgstr "Lo pòrt deu èsser un pòrt TCP sens privilègi"

#: src/wayland_vnc/settings.py
msgid "Portals"
msgstr "Portals"

#: src/wayland_vnc/settings_dialogs.py
msgid "Project Website"
msgstr "Site web del projècte"

#: src/wayland_vnc/settings_app.py
msgid "Quit"
msgstr "Quitar"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Prèst a installar"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, un client ; pas necessari per servir"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Rason"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Ciblas de publicacion"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "Portal RemoteDesktop"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Senhalar un problèma"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "Las capacitats de captura E d'entrada requeridas son pas estadas detectadas."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "En execucion ara"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "Enregistrar"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "Portal ScreenCast"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
msgstr "Cercar"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search diagnostics"
msgstr "Cercar dins lo diagnostic"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search languages"
msgstr "Cercar de lengas"

#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "Servit per GNOME Remote Desktop VNC (pòrt 5900); l'exposicion seguís Paramètres GNOME > Partiment"

#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "Configuracion del servidor"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "Servici"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "Session"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "Tipe de session"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "Definir lo senhal"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "Definir lo senhal del visionador"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "Definissètz d'en primièr un senhal de visionador"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "Aviar a la connexion"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Estat"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Enregistrat (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Ciblat"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "La fenèstra dels paramètres necessita GTK4 e libadwaita (installatz python3-gi, gir1.2-gtk-4.0 e gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "La fenèstra dels paramètres necessita libadwaita %(needed)s o mai recent; aqueste sistèma a %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "La fenèstra seguís la lenga de vòstre burèu levat se ne causissètz una autra."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Aqueste burèu servís VNC via GNOME Remote Desktop, qu'accèpta de senhals de 8 caractèrs al maximum"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Lo motor d'aqueste burèu escota totjorn solament sus aqueste ordenador"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Servidor TigerVNC, per KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Ensajatz una autra recèrca."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Picatz aquò dins RealVNC Viewer sus l'autre aparelh. Utilizatz l'uèlh per afichar lo senhal actual. Enregistrat amb lo mòde 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Nom d'utilizaire"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Lo nom d'utilizaire deu èsser en ASCII imprimible"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Verdicte"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Identificants del visionador"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Senhal del visionador enregistrat"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Servidor WayVNC, pels compositors wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Protocòls Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Çò qu'aqueste burèu anóncia, e çò qu'aquò significa per l'accès distant."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Òc"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "totas las rets a las qualas aqueste ordenador es connectat"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "ret locala solament"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "Nom mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "mòde %s (tròp dobèrt)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "mòde 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "aquesta maquina solament"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "l'unitat es pas installada"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "desconegut"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "utilizat per sondar los protocòls Wayland"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "utilizat per sondar los portals via D-Bus"

