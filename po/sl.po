#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), overjanje %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d vmesnikov za zajem/vnos"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d namizij"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s MANJKA in to namizje ga potrebuje"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: samo ta računalnik. 0.0.0.0: vsa omrežja, s katerimi je ta računalnik povezan, brez druge zaščite. Vrata 1024 in nižja so zavrnjena."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Zahtevana je izvorna seja Wayland; vračanje na X11 je prepovedano."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "O programu Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Naslov"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Objavljeno"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Vsi prisotni"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Uveljavi"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Samodejno (po namizju)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Zaledje"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Kandidat za zaledje"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Zaledje na tem namizju"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binarne datoteke"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Naslov in vrata za poslušanje"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Naslov in vrata uveljavljena"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Prekliči"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Ocena zmožnosti"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Zaznani protokoli za zajem, navidezno tipkovnico in navidezni kazalec."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Zapri"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Nastavitve"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Potrdi geslo"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Poveži z druge naprave"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Povežite ta računalnik z Wi-Fi ali Ethernetom, nato ponovno odprite"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopiraj"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "V datoteki s poverilnicami manjka uporabniško ime ali geslo"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Namizje"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Namizne storitve"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostika"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Vsaka možnost tukaj spremeni dejansko nastavitev ali nameščeno storitev."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Vse, kar to namizje potrebuje; ni nameščeno: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Strežnik GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Lastni demon GNOME Oddaljenega namizja posluša v vseh omrežjih; namestite wayland-vnc-grd, da to nadzorujete"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Oddajanje zaslona GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Splošno"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "V RealVNC Viewer dodajte povezavo do enega od teh naslovov. Delujejo, dokler je dostop iz krajevnega omrežja vklopljen, za vsako napravo v istem omrežju. Vrat ne posredujte iz interneta."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Namestite paket wayland-vnc, da dobite uporabniško enoto systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Zaznan KWin in vmesniki portala za zajem/vnos."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin zahteva oba vmesnika portala: ScreenCast in RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Tipkovne bližnjice"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Tipkovne bližnjice"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Jezik"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Napravam v istem omrežju Wi-Fi ali LAN dovoli povezavo. Izklopljeno: samo ta računalnik."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licenca"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Dostop iz krajevnega omrežja"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Dostop iz krajevnega omrežja je izklopljen"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Dostop iz krajevnega omrežja je vklopljen"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Glavni meni"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Naredi to namizje Wayland dosegljivo iz RealVNC Viewer na vašem telefonu ali drugem računalniku. Dokler ne vklopite možnosti Dostop iz krajevnega omrežja, posluša samo na tem računalniku."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Zaznane storitve Mutter za zajem in oddaljeni vnos; zahtevana je zasebna gradnja."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Ne"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Ni najdenih rezultatov"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Naslov krajevnega omrežja ni bil najden"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Ni podprtega zaledja"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Prevodi niso nameščeni, zato okno ostaja v angleščini."

