#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Pripravljeno za namestitev"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, odjemalec; za streženje ni potreben"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Razlog"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Cilji izdaje"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "Portal RemoteDesktop"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Prijavi težavo"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "Zahtevane zmožnosti zajema IN vnosa niso bile zaznane."

