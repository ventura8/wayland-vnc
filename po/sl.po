msgstr "Zaženi ob prijavi"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Stanje"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Shranjeno (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Ciljano"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Okno z nastavitvami potrebuje GTK4 in libadwaita (namestite python3-gi, gir1.2-gtk-4.0 in gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Okno z nastavitvami potrebuje libadwaita %(needed)s ali novejšo; ta sistem ima %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Okno sledi jeziku vašega namizja, razen če izberete drugega."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "To namizje streže VNC prek GNOME Remote Desktop, ki sprejema gesla z največ 8 znaki"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Zaledje tega namizja vedno posluša samo na tem računalniku"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Strežnik TigerVNC, za KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Poskusite z drugim iskanjem."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Vnesite to v RealVNC Viewer na drugi napravi. Z očesom prikažete trenutno geslo. Shranjeno z načinom 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Uporabniško ime"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Uporabniško ime mora biti natisljiv ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Ocena"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Poverilnice pregledovalnika"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Geslo pregledovalnika shranjeno"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Strežnik WayVNC, za sestavljalnike wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Protokoli Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Kaj to namizje objavlja in kaj to pomeni za oddaljeni dostop."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Da"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "vsa omrežja, s katerimi je ta računalnik povezan"

#: src/wayland_vnc/settings_app.py
