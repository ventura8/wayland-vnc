msgstr "Nič ni objavljeno"

#: src/wayland_vnc/settings.py
msgid "None available"
msgstr "Nič ni na voljo"

#: src/wayland_vnc/settings.py
msgid "None checked"
msgstr "Nič ni preverjeno"

