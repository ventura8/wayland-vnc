msgstr "Diagnóstico"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Cada opción aquí cambia configuración real o el servicio instalado."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Todo lo que este escritorio necesita; no instalado: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Servidor GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "El demonio propio de GNOME Escritorio remoto escucha en todas las redes; instale wayland-vnc-grd para controlarlo"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Captura de pantalla de GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "General"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "En RealVNC Viewer, añada una conexión a una de estas direcciones. Funcionan mientras el acceso desde la red local esté activado, para cualquier dispositivo de la misma red. No reenvíe el puerto desde Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instale el paquete wayland-vnc para obtener la unidad de usuario de systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Detectados KWin y las interfaces de portal de captura/entrada."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin necesita ambas interfaces de portal: ScreenCast y RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Atajos de teclado"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Atajos de teclado"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Idioma"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Permitir que se conecten los dispositivos de la misma Wi-Fi o LAN. Desactivado: solo este equipo."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licencia"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Acceso desde la red local"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Acceso desde la red local desactivado"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Acceso desde la red local activado"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menú principal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Hace que este escritorio Wayland sea accesible desde RealVNC Viewer en su teléfono u otro equipo. Solo escucha en este equipo hasta que active «Acceso desde la red local»."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Detectados los servicios de captura y entrada remota de Mutter; se requiere una compilación privada."

