msgstr "Detectados los protocolos de captura, teclado virtual y puntero virtual."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Cerrar"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Configuración"

