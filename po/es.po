#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autenticación %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d interfaz(ces) de captura/entrada"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d escritorios"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s FALTA y este escritorio lo necesita"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: solo este equipo. 0.0.0.0: todas las redes a las que está conectado este equipo, sin ninguna otra barrera. Se rechazan los puertos 1024 e inferiores."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Se requiere una sesión Wayland nativa; el respaldo en X11 está prohibido."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Acerca de Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Dirección"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Anunciado"

