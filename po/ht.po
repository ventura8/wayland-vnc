#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), otantifikasyon %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d entèfas kaptire/antre"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d biwo"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s MANKE epi biwo sa a bezwen li"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: òdinatè sa a sèlman. 0.0.0.0: tout rezo òdinatè sa a konekte sou yo, san okenn lòt pwoteksyon. Pò 1024 ak pi ba yo refize."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Yon sesyon Wayland natif nesesè; retounen sou X11 entèdi."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Konsènan Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adrès"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Anonse"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Tout la"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Aplike"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Otomatik (suiv biwo a)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Kandida backend"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Backend sou biwo sa a"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Fichye binè"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Adrès ak pò pou koute"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adrès ak pò aplike"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Anile"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Vèdik kapasite"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Yo detekte pwotokòl kaptire, klavye vityèl ak pwentè vityèl."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Fèmen"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Konfigirasyon"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Konfime modpas la"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Konekte depi yon lòt aparèy"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Konekte machin sa a ak Wi-Fi oswa Ethernet, epi reouvri"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopye"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Fichye idantifyan an manke yon non itilizatè oswa yon modpas"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Biwo"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Sèvis biwo"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Dyagnostik"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Chak opsyon isit la chanje konfigirasyon reyèl la oswa sèvis ki enstale a."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Tout sa biwo sa a bezwen; pa enstale: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Sèvè GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Pwòp demon GNOME Biwo a distans lan ap koute sou tout rezo; enstale wayland-vnc-grd pou kontwole sa"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Difizyon ekran GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Jeneral"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Nan RealVNC Viewer, ajoute yon koneksyon ak youn nan adrès sa yo. Yo mache toutotan aksè soti nan rezo lokal la limen, pou nenpòt aparèy sou menm rezo a. Pa voye pò a soti nan Entènèt."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Enstale pakè wayland-vnc pou jwenn inite itilizatè systemd la"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Yo detekte KWin ak entèfas pòtay kaptire/antre."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin bezwen tou de entèfas pòtay yo: ScreenCast ak RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Rakousi klavye"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Rakousi klavye"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Lang"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Kite aparèy sou menm Wi-Fi oswa LAN an konekte. Etenn: òdinatè sa a sèlman."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Lisans"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Aksè soti nan rezo lokal"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Aksè soti nan rezo lokal la etenn"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Aksè soti nan rezo lokal la limen"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Meni prensipal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Fè biwo Wayland sa a aksesib depi RealVNC Viewer sou telefòn ou oswa yon lòt òdinatè. Li koute sèlman sou òdinatè sa a jiskaske ou limen Aksè soti nan rezo lokal."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Yo detekte sèvis kaptire ak antre a distans Mutter; yon konstriksyon prive nesesè."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Non"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Pa jwenn okenn rezilta"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Pa jwenn okenn adrès rezo lokal"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Pa gen backend ki sipòte"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Pa gen tradiksyon enstale, kidonk fenèt la rete an anglè."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "None"
msgstr "Okenn"

#: src/wayland_vnc/settings.py
msgid "None advertised"
msgstr "Okenn pa anonse"

#: src/wayland_vnc/settings.py
msgid "None available"
msgstr "Okenn pa disponib"

#: src/wayland_vnc/settings.py
msgid "None checked"
msgstr "Okenn pa verifye"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "None detected"
msgstr "Okenn pa detekte"

#: src/wayland_vnc/settings.py
msgid "Not advertised"
msgstr "Pa anonse"

#: src/wayland_vnc/settings.py
msgid "Not checked"
msgstr "Pa verifye"

