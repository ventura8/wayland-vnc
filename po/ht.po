msgid "Not installed"
msgstr "Pa enstale"

#: src/wayland_vnc/settings_app.py
msgid "Not provisioned"
msgstr "Pa prepare"

#: src/wayland_vnc/settings_app.py
msgid "Not set"
msgstr "Pa defini"

#: src/wayland_vnc/settings_app.py
msgid "Open the main menu"
msgstr "Ouvri meni prensipal la"

#: src/wayland_vnc/settings_app.py
msgid "PUBLIC ADDRESS - reachable beyond the local network"
msgstr "ADRÈS PIBLIK - aksesib pi lwen pase rezo lokal la"

#: src/wayland_vnc/settings_dialogs.py
msgid "Password"
msgstr "Modpas"

#: src/wayland_vnc/runtime.py
msgid "Password must be 6-64 ASCII characters"
msgstr "Modpas la dwe gen 6–64 karaktè ASCII"

#: src/wayland_vnc/settings_dialogs.py src/wayland_vnc/runtime.py
msgid "Passwords did not match"
msgstr "Modpas yo pa koresponn"

#: src/wayland_vnc/settings_dialogs.py
msgid "Port"
msgstr "Pò"

#: src/wayland_vnc/runtime.py
msgid "Port must be an unprivileged TCP port"
msgstr "Pò a dwe yon pò TCP san privilèj"

#: src/wayland_vnc/settings.py
msgid "Portals"
msgstr "Pòtay"

#: src/wayland_vnc/settings_dialogs.py
msgid "Project Website"
msgstr "Sit entènèt pwojè a"

#: src/wayland_vnc/settings_app.py
msgid "Quit"
msgstr "Kite"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Pare pou enstale"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, yon kliyan; pa nesesè pou sèvi"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Rezon"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Sib piblikasyon"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "Pòtay RemoteDesktop"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Rapòte yon pwoblèm"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "Yo pa detekte kapasite kaptire AK antre ki nesesè yo."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "Ap mache kounye a"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "Sove"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "Pòtay ScreenCast"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
msgstr "Chèche"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search diagnostics"
msgstr "Chèche nan dyagnostik"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search languages"
msgstr "Chèche lang"

#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "Sèvi pa GNOME Remote Desktop VNC (pò 5900); ekspozisyon an suiv Paramèt GNOME > Pataje"

#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "Konfigirasyon sèvè"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "Sèvis"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "Sesyon"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "Tip sesyon"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "Defini modpas"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "Defini modpas vizyonè a"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "Defini yon modpas vizyonè anvan"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "Kòmanse lè w konekte"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Estati"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Sove (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Vize"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Fenèt paramèt la bezwen GTK4 ak libadwaita (enstale python3-gi, gir1.2-gtk-4.0 ak gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Fenèt paramèt la bezwen libadwaita %(needed)s oswa pi nouvo; sistèm sa a gen %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Fenèt la suiv lang biwo ou a sof si ou chwazi yon lòt."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Biwo sa a bay VNC atravè GNOME Remote Desktop, ki aksepte modpas ki gen 8 karaktè oplis"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Motè biwo sa a toujou koute sou òdinatè sa a sèlman"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Sèvè TigerVNC, pou KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Eseye yon lòt rechèch."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Tape sa yo nan RealVNC Viewer sou lòt aparèy la. Sèvi ak je a pou montre modpas aktyèl la. Sove ak mòd 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Non itilizatè"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Non itilizatè a dwe ASCII ki ka enprime"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Vèdik"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Idantifyan vizyonè"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Modpas vizyonè a sove"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Sèvè WayVNC, pou konpozitè wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Pwotokòl Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Sa biwo sa a anonse, ak sa sa vle di pou aksè a distans."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Wi"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "tout rezo òdinatè sa a konekte sou yo"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "rezo lokal sèlman"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "Non mDNS"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "mòd %s (twò ouvè)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "mòd 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "machin sa a sèlman"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "inite a pa enstale"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "enkoni"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "itilize pou sonde pwotokòl Wayland yo"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "itilize pou sonde pòtay yo atravè D-Bus"

