msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Jendela pengaturan memerlukan GTK4 dan libadwaita (pasang python3-gi, gir1.2-gtk-4.0 dan gir1.2-adw-1)"

