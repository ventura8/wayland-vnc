msgstr "ကြည့်ရှုသူ စကားဝှက် သတ်မှတ်ရန်"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "ကြည့်ရှုသူ စကားဝှက်ကို ဦးစွာ သတ်မှတ်ပါ"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "ဝင်ရောက်ချိန်တွင် စတင်ရန်"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "အခြေအနေ"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "သိမ်းဆည်းပြီး (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "ပစ်မှတ်ထားပြီး"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "ဆက်တင် ဝင်းဒိုးတွင် GTK4 နှင့် libadwaita လိုအပ်သည် (python3-gi၊ gir1.2-gtk-4.0 နှင့် gir1.2-adw-1 ထည့်သွင်းပါ)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "ဆက်တင် ဝင်းဒိုးတွင် libadwaita %(needed)s သို့မဟုတ် ပိုသစ်သည် လိုအပ်သည်။ ဤစနစ်တွင် %(found)s ရှိသည်"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "အခြားတစ်ခု မရွေးချယ်ပါက ဝင်းဒိုးသည် သင့်ဒက်စ်တော့၏ ဘာသာစကားအတိုင်း ဖြစ်သည်။"

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "ဤဒက်စ်တော့သည် စာလုံး ၈ လုံးထက် မပိုသော စကားဝှက်များကိုသာ လက်ခံသည့် GNOME Remote Desktop မှတစ်ဆင့် VNC ကို ဝန်ဆောင်မှုပေးသည်"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "ဤဒက်စ်တော့၏ နောက်ကွယ်စနစ်သည် ဤကွန်ပျူတာတွင်သာ အမြဲနားထောင်သည်"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC ဆာဗာ၊ KDE Plasma အတွက်"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "အခြား ရှာဖွေမှု စမ်းကြည့်ပါ။"

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "ဤအရာများကို အခြားစက်ရှိ RealVNC Viewer တွင် ရိုက်ထည့်ပါ။ လက်ရှိ စကားဝှက်ကို ပြရန် မျက်လုံးကို အသုံးပြုပါ။ မုဒ် 600 ဖြင့် သိမ်းဆည်းထားသည်။"

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "အသုံးပြုသူအမည်"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "အသုံးပြုသူအမည်သည် ပုံနှိပ်နိုင်သော ASCII ဖြစ်ရမည်"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "ဆုံးဖြတ်ချက်"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "ကြည့်ရှုသူ အထောက်အထား"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "ကြည့်ရှုသူ စကားဝှက် သိမ်းဆည်းပြီး"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC ဆာဗာ၊ wlroots ပေါင်းစပ်စက်များအတွက်"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland ပရိုတိုကောများ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "ဤဒက်စ်တော့က ဘာကြေညာသည်၊ အဝေးမှ ဝင်ရောက်မှုအတွက် ဘာအဓိပ္ပာယ်ရှိသည်။"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "ဟုတ်ကဲ့"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "ဤကွန်ပျူတာ ချိတ်ဆက်ထားသော ကွန်ရက်အားလုံး"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "ဒေသတွင်းကွန်ရက်သာ"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS အမည်"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "မုဒ် %s (ပွင့်လွန်းသည်)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "မုဒ် 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "ဤစက်သာ"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "ယူနစ် မထည့်သွင်းထားပါ"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "မသိ"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "Wayland ပရိုတိုကောများကို စစ်ဆေးရန် အသုံးပြုသည်"

#: src/wayland_vnc/settings.py
msgid "used to probe portals over D-Bus"
msgstr "D-Bus မှတစ်ဆင့် ပေါ်တယ်များကို စစ်ဆေးရန် အသုံးပြုသည်"

#~ msgid "Qualification"
#~ msgstr "အရည်အချင်း"

#~ msgid "0.0.0.0 makes the server reachable from devices on your local network; the service still blocks the internet. 127.0.0.1 limits it to this machine. Ports at or below 1024 are refused."
#~ msgstr "0.0.0.0 သည် ဆာဗာကို သင့်ဒေသတွင်းကွန်ရက်ရှိ စက်များမှ ရောက်ရှိနိုင်စေသည်။ ဝန်ဆောင်မှုက အင်တာနက်ကို ဆက်လက်ပိတ်ဆို့သည်။ 127.0.0.1 သည် ဤစက်တွင်သာ ကန့်သတ်သည်။ ပို့တ် 1024 နှင့် အောက်ကို ငြင်းပယ်သည်။"

#~ msgid "local network only; internet blocked by the unit"
#~ msgstr "ဒေသတွင်းကွန်ရက်သာ။ အင်တာနက်ကို ယူနစ်က ပိတ်ဆို့ထားသည်"
