msgstr "Credenciais do visualizador"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Palavra-passe do visualizador guardada"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Servidor WayVNC, para compositores wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Protocolos Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "O que este ambiente de trabalho anuncia e o que isso significa para o acesso remoto."

