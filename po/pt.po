msgstr "Estado"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Guardada (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Previsto"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "A janela de definições necessita de GTK4 e libadwaita (instale python3-gi, gir1.2-gtk-4.0 e gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "A janela de definições necessita de libadwaita %(needed)s ou mais recente; este sistema tem %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "A janela segue o idioma do seu ambiente de trabalho, a menos que escolha outro."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Este ambiente serve VNC através do GNOME Remote Desktop, que aceita palavras-passe com no máximo 8 caracteres"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "O backend deste ambiente escuta sempre apenas neste computador"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Servidor TigerVNC, para o KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Experimente outra pesquisa."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Escreva isto no RealVNC Viewer no outro dispositivo. Use o olho para revelar a palavra-passe atual. Guardada com modo 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Nome de utilizador"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "O nome de utilizador tem de ser ASCII imprimível"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Veredicto"

