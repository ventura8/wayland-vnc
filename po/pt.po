msgstr "Guardar"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "Portal ScreenCast"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
msgstr "Pesquisar"

#: src/wayland_vnc/settings_dialogs.py
