msgstr "Pesquisar no diagnóstico"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search languages"
msgstr "Pesquisar idiomas"

#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "Servido pelo GNOME Remote Desktop VNC (porta 5900); a exposição segue Definições do GNOME > Partilha"

