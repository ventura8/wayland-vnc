#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), overenie %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d rozhraní na záznam/vstup"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d plôch"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s CHÝBA a táto plocha ho potrebuje"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: iba tento počítač. 0.0.0.0: každá sieť, ku ktorej je tento počítač pripojený, bez ďalšej ochrany. Porty 1024 a nižšie sú odmietnuté."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Vyžaduje sa natívna relácia Wayland; návrat k X11 je zakázaný."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "O aplikácii Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adresa"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Ohlásené"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Všetko prítomné"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Použiť"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automaticky (podľa plochy)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Kandidát na backend"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Backend na tejto ploche"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binárne súbory"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Adresa a port na počúvanie"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adresa a port boli použité"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Zrušiť"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Verdikt o schopnostiach"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Zistené protokoly na záznam, virtuálnu klávesnicu a virtuálny ukazovateľ."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Zavrieť"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Nastavenie"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Potvrdiť heslo"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Pripojiť z iného zariadenia"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Pripojte tento počítač k Wi-Fi alebo Ethernetu a potom znova otvorte"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopírovať"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "V súbore s prihlasovacími údajmi chýba používateľské meno alebo heslo"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Plocha"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Služby plochy"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostika"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Každá voľba tu mení skutočné nastavenie alebo nainštalovanú službu."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Všetko, čo táto plocha potrebuje; nenainštalované: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Server GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Vlastný démon GNOME Vzdialená plocha počúva v každej sieti; nainštalujte wayland-vnc-grd, aby ste to mohli riadiť"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Zdieľanie obrazovky GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Všeobecné"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "V RealVNC Viewer pridajte pripojenie k jednej z týchto adries. Fungujú, kým je prístup z miestnej siete zapnutý, pre každé zariadenie v rovnakej sieti. Nepresmerúvajte port z internetu."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Nainštalujte balík wayland-vnc, aby ste získali používateľskú jednotku systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Zistený KWin a portálové rozhrania na záznam/vstup."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin vyžaduje obe portálové rozhrania: ScreenCast aj RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Klávesové skratky"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Klávesové skratky"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Jazyk"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Povoliť pripojenie zariadeniam v rovnakej Wi-Fi alebo LAN. Vypnuté: iba tento počítač."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licencia"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Prístup z miestnej siete"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Prístup z miestnej siete vypnutý"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Prístup z miestnej siete zapnutý"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Hlavná ponuka"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Sprístupní túto plochu Wayland z RealVNC Viewer na vašom telefóne alebo inom počítači. Kým nezapnete Prístup z miestnej siete, počúva iba na tomto počítači."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Zistené služby Mutter na záznam a vzdialený vstup; vyžaduje sa súkromné zostavenie."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Nie"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Nenašli sa žiadne výsledky"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Nenašla sa žiadna adresa miestnej siete"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Žiadny podporovaný backend"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Nie sú nainštalované žiadne preklady, okno teda zostáva v angličtine."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "None"
msgstr "Žiadny"

