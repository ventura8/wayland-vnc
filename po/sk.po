#: src/wayland_vnc/settings_app.py
msgid "Quit"
msgstr "Ukončiť"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Pripravené na inštaláciu"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, klient; na poskytovanie nie je potrebný"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Dôvod"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Ciele vydania"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "Portál RemoteDesktop"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Nahlásiť problém"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "Požadované schopnosti záznamu A vstupu neboli zistené."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "Práve beží"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "Uložiť"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "Portál ScreenCast"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
