msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "S'han detectat els protocols de captura, teclat virtual i punter virtual."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Tanca"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Configuració"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Confirma la contrasenya"

