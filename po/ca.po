msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Connecteu aquesta màquina a la Wi-Fi o a Ethernet i torneu a obrir"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Copia"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Al fitxer de credencials li falta un nom d'usuari o una contrasenya"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Escriptori"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Serveis de l'escriptori"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnòstic"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Cada opció aquí canvia la configuració real o el servei instal·lat."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Tot el que aquest escriptori necessita; no instal·lat: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Servidor GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "El dimoni propi de l'Escriptori remot del GNOME escolta a totes les xarxes; instal·leu wayland-vnc-grd per controlar-ho"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Difusió de pantalla del GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "General"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Al RealVNC Viewer, afegiu una connexió a una d'aquestes adreces. Funcionen mentre l'accés des de la xarxa local està activat, per a qualsevol dispositiu de la mateixa xarxa. No redirigiu el port des d'Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instal·leu el paquet wayland-vnc per obtenir la unitat d'usuari del systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "S'han detectat el KWin i les interfícies de portal de captura/entrada."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "El KWin requereix les dues interfícies de portal: ScreenCast i RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Dreceres de teclat"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Dreceres de teclat"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Idioma"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Permet que els dispositius de la mateixa Wi-Fi o LAN es connectin. Desactivat: només aquest ordinador."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Llicència"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Accés des de la xarxa local"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "S'ha desactivat l'accés des de la xarxa local"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "S'ha activat l'accés des de la xarxa local"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menú principal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Fa que aquest escriptori Wayland sigui accessible des del RealVNC Viewer al vostre telèfon o a un altre ordinador. Només escolta en aquest ordinador fins que activeu l'Accés des de la xarxa local."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "S'han detectat els serveis de captura i entrada remota del Mutter; cal una compilació privada."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "No"

#: src/wayland_vnc/settings_dialogs.py
