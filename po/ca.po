msgstr "Emmagatzemada (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Previst"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "La finestra de paràmetres necessita GTK4 i libadwaita (instal·leu python3-gi, gir1.2-gtk-4.0 i gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "La finestra de paràmetres necessita libadwaita %(needed)s o posterior; aquest sistema té %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "La finestra segueix l'idioma del vostre escriptori, tret que en trieu un altre."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Aquest escriptori serveix VNC a través del GNOME Remote Desktop, que accepta contrasenyes de com a màxim 8 caràcters"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "El rerefons d'aquest escriptori sempre escolta només en aquest ordinador"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Servidor TigerVNC, per al KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Proveu una altra cerca."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Escriviu això al RealVNC Viewer de l'altre dispositiu. Feu servir l'ull per mostrar la contrasenya actual. Emmagatzemada amb el mode 600."

