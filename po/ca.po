#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autenticació %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d interfícies de captura/entrada"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d escriptoris"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s FALTA i aquest escriptori el necessita"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: només aquest ordinador. 0.0.0.0: totes les xarxes a què està connectat aquest ordinador, sense cap altra barrera. Els ports 1024 i inferiors es rebutgen."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Cal una sessió Wayland nativa; el retorn a X11 està prohibit."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Quant a Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adreça"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Anunciat"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Tots presents"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Aplica"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automàtic (segons l'escriptori)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Motor"

