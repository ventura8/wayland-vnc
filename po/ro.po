msgstr "Captură de ecran GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "General"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "În RealVNC Viewer, adăugați o conexiune către una dintre aceste adrese. Funcționează cât timp accesul din rețeaua locală este pornit, pentru orice dispozitiv din aceeași rețea. Nu redirecționați portul din Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instalați pachetul wayland-vnc pentru a obține unitatea de utilizator systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Au fost detectate KWin și interfețele de portal pentru captură/intrare."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin necesită ambele interfețe de portal: ScreenCast și RemoteDesktop."

