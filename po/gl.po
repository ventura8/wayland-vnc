msgid "Language"
msgstr "Idioma"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Permitir que os dispositivos da mesma Wi-Fi ou LAN se conecten. Desactivado: só este computador."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licenza"

