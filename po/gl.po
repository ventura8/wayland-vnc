msgid "GNOME Screencast"
msgstr "Captura de pantalla de GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Xeral"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "En RealVNC Viewer, engada unha conexión a un destes enderezos. Funcionan mentres o acceso desde a rede local estea activado, para calquera dispositivo da mesma rede. Non reenvíe o porto desde Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instale o paquete wayland-vnc para obter a unidade de usuario de systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Detectáronse KWin e as interfaces de portal de captura/entrada."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin precisa das dúas interfaces de portal: ScreenCast e RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Atallos de teclado"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Atallos de teclado"

