msgstr "આ ડેસ્કટોપ GNOME Remote Desktop દ્વારા VNC આપે છે, જે વધુમાં વધુ 8 અક્ષરોના પાસવર્ડ સ્વીકારે છે"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "આ ડેસ્કટોપનું બેકએન્ડ હંમેશાં માત્ર આ કમ્પ્યુટર પર જ સાંભળે છે"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC સર્વર, KDE Plasma માટે"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "બીજી શોધ અજમાવો."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "આ બીજા ઉપકરણ પરના RealVNC Viewer માં લખો. હાલનો પાસવર્ડ બતાવવા આંખનો ઉપયોગ કરો. મોડ 600 સાથે સંગ્રહિત."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "વપરાશકર્તા નામ"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "વપરાશકર્તા નામ છાપી શકાય તેવું ASCII હોવું જોઈએ"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "ચુકાદો"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "વ્યૂઅર ઓળખપત્ર"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "વ્યૂઅર પાસવર્ડ સાચવ્યો"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC સર્વર, wlroots કમ્પોઝિટર માટે"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland પ્રોટોકોલ"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "આ ડેસ્કટોપ શું જાહેર કરે છે, અને દૂરસ્થ ઍક્સેસ માટે તેનો અર્થ શું છે."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "હા"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "આ કમ્પ્યુટર જે દરેક નેટવર્ક સાથે જોડાયેલું છે"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "માત્ર સ્થાનિક નેટવર્ક"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS નામ"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "મોડ %s (ખૂબ ખુલ્લું)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "મોડ 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "ફક્ત આ મશીન"

