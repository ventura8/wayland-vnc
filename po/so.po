#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), xaqiijin %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d interface qabasho/gelin"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d desktop"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s WAA MAQAN YAHAY, desktop-kanna wuu u baahan yahay"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: kumbiyuutarkan oo keliya. 0.0.0.0: shabakad kasta oo kumbiyuutarkani ku xiran yahay, iyada oo aan wax xayndaab kale ah jirin. Dekedaha 1024 iyo ka hooseeya waa la diidaa."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Fadhi Wayland asal ah ayaa loo baahan yahay; ku noqoshada X11 waa mamnuuc."

