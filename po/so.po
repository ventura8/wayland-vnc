msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin iyo interface-yada portal-ka qabashada/gelinta waa la helay."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin wuxuu u baahan yahay labada isku-xirka portal-ka: ScreenCast iyo RemoteDesktop."

