msgstr "%s PUUTTUU ja tämä työpöytä tarvitsee sen"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: vain tämä tietokone. 0.0.0.0: kaikki verkot, joihin tämä tietokone on yhteydessä, ilman muuta suojausta. Portit 1024 ja sitä pienemmät hylätään."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Natiivi Wayland-istunto vaaditaan; X11-varajärjestely on kielletty."

