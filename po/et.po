msgid "Bind address and port applied"
msgstr "Aadress ja port rakendatud"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Loobu"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Võimekuse hinnang"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Tuvastati hõive, virtuaalse klaviatuuri ja virtuaalse kursori protokollid."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Sulge"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Seadistus"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Kinnita parool"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Ühenda teisest seadmest"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Ühendage see masin Wi-Fi või Etherneti külge ja avage uuesti"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopeeri"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Mandaadifailist puudub kasutajanimi või parool"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Töölaud"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Töölaua teenused"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostika"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Iga valik siin muudab tegelikku seadistust või paigaldatud teenust."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Kõik, mida see töölaud vajab; paigaldamata: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktopi server"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME Kaugtöölaua oma deemon kuulab kõigis võrkudes; selle juhtimiseks paigalda wayland-vnc-grd"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME ekraaniedastus"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Üldine"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Lisa RealVNC Vieweris ühendus ühele neist aadressidest. Need töötavad seni, kuni kohtvõrgu juurdepääs on sisse lülitatud, iga sama võrgu seadme jaoks. Ära suuna porti Internetist edasi."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Paigaldage pakett wayland-vnc, et saada systemd kasutajaüksus"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Tuvastati KWin ning hõive-/sisendportaali liidesed."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin vajab mõlemat portaaliliidest: ScreenCast ja RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Kiirklahvid"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Kiirklahvid"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Keel"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Luba sama Wi-Fi või kohtvõrgu seadmetel ühenduda. Väljas: ainult see arvuti."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Litsents"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Juurdepääs kohtvõrgust"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Juurdepääs kohtvõrgust on välja lülitatud"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Juurdepääs kohtvõrgust on sisse lülitatud"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Peamenüü"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Teeb selle Wayland-töölaua kättesaadavaks RealVNC Viewerist teie telefonis või teises arvutis. Kuni te ei lülita sisse valikut „Juurdepääs kohtvõrgust“, kuulab see ainult selles arvutis."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Tuvastati Mutteri hõive- ja kaugsisendi teenused; nõutav on privaatne versioon."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Ei"

