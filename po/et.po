#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), autentimine %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d hõive-/sisendliidest"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d töölauda"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s PUUDUB ja see töölaud vajab seda"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: ainult see arvuti. 0.0.0.0: kõik võrgud, millega see arvuti on ühendatud, ilma muu kaitseta. Pordid 1024 ja madalamad lükatakse tagasi."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Nõutav on natiivne Wayland-seanss; X11-le tagasilangemine on keelatud."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Wayland VNC teave"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Aadress"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Teavitatud"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Kõik olemas"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Rakenda"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automaatne (töölaua järgi)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Taustsüsteem"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
