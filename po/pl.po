#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), uwierzytelnianie %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "Interfejsy przechwytywania/wejścia: %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "Pulpity: %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "Brakuje %s, a ten pulpit tego potrzebuje"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: tylko ten komputer. 0.0.0.0: każda sieć, do której ten komputer jest podłączony, bez żadnej innej ochrony. Porty 1024 i niższe są odrzucane."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Wymagana jest natywna sesja Wayland; powrót do X11 jest zabroniony."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "O programie Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adres"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Ogłaszany"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Wszystkie obecne"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Zastosuj"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatycznie (zgodnie z pulpitem)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Kandydat na backend"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Backend na tym pulpicie"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Pliki wykonywalne"

