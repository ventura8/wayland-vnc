msgid "Bind Address and Port"
msgstr "Adres i port nasłuchiwania"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Zastosowano adres i port"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Anuluj"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Ocena możliwości"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Wykryto protokoły przechwytywania, wirtualnej klawiatury i wirtualnego wskaźnika."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Zamknij"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Konfiguracja"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Potwierdź hasło"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Połącz z innego urządzenia"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Podłącz ten komputer do Wi-Fi lub Ethernetu i otwórz ponownie"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopiuj"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "W pliku poświadczeń brakuje nazwy użytkownika lub hasła"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Pulpit"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Usługi pulpitu"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostyka"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Każda opcja tutaj zmienia rzeczywistą konfigurację lub zainstalowaną usługę."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Wszystko, czego ten pulpit potrzebuje; nie zainstalowano: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Serwer GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Własny demon GNOME Zdalny pulpit nasłuchuje w każdej sieci; zainstaluj wayland-vnc-grd, aby to kontrolować"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Przechwytywanie ekranu GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Ogólne"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "W RealVNC Viewer dodaj połączenie z jednym z tych adresów. Działają, gdy dostęp z sieci lokalnej jest włączony, dla każdego urządzenia w tej samej sieci. Nie przekierowuj portu z Internetu."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Zainstaluj pakiet wayland-vnc, aby uzyskać jednostkę użytkownika systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Wykryto KWin oraz interfejsy portalu przechwytywania/wejścia."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin wymaga obu interfejsów portalu: ScreenCast i RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Skróty klawiszowe"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Skróty klawiszowe"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Język"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Pozwól urządzeniom w tej samej sieci Wi-Fi lub LAN na łączenie się. Wyłączone: tylko ten komputer."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licencja"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Dostęp z sieci lokalnej"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Dostęp z sieci lokalnej wyłączony"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Dostęp z sieci lokalnej włączony"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menu główne"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Udostępnia ten pulpit Wayland z poziomu RealVNC Viewer na telefonie lub innym komputerze. Dopóki nie włączysz opcji „Dostęp z sieci lokalnej”, nasłuchuje tylko na tym komputerze."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Wykryto usługi przechwytywania i zdalnego wejścia Mutter; wymagana jest prywatna kompilacja."

