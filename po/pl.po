msgid "No supported backend"
msgstr "Brak obsługiwanego backendu"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Nie zainstalowano tłumaczeń, więc okno pozostaje po angielsku."

