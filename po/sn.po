msgid "Language"
msgstr "Mutauro"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Rega midziyo iri paWi-Fi kana LAN imwe chete ibatane. Yakadzimwa: komputa ino chete."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Rezinesi"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Kupinda kubva pamutandao wemuno"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Kupinda kubva pamutandao wemuno kwadzimwa"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Kupinda kubva pamutandao wemuno kwabatidzwa"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menyu huru"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Inoita kuti dhesikitopu iyi yeWayland isvikike kubva kuRealVNC Viewer pafoni yako kana pane imwe kombiyuta. Inoteerera pakombiyuta ino chete kusvikira wabatidza Kupinda kubva pamutandao wemuno."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Kutora kweMutter nemasevhisi ekupinza kure zvaonekwa; kuvakwa kwakavanzika kunodiwa."

