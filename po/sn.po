msgid "Diagnostics"
msgstr "Kuongorora"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Sarudzo yega yega pano inochinja kugadzirisa chaiko kana sevhisi yakaiswa."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Zvose zvinodiwa nedhesikitopu iyi; zvisina kuiswa: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Seva yeGNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Daemon yeGNOME Desktop Yekure pachayo inoteerera pamitandao yese; isa wayland-vnc-grd kuti udzore izvi"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME Screencast"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Zvakajairika"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "MuRealVNC Viewer, wedzera kubatana kune imwe yekero idzi. Dzinoshanda kana kupinda kubva pamutandao wemuno kwakabatidzwa, kune chero mudziyo pamutandao mumwe chete. Usatumira poti kubva paIndaneti."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Isa pakeji yewayland-vnc kuti uwane yuniti yemushandisi yesystemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin nenzira dzepotari yekutora/yekupinza zvaonekwa."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin inoda maportal interface ese ari maviri: ScreenCast neRemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Nzira dzipfupi dzekiibhodhi"

#: src/wayland_vnc/settings_app.py
