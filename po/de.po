msgid "Everything this desktop needs; not installed: "
msgstr "Alles, was dieser Desktop benötigt; nicht installiert: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME-Remote-Desktop-Server"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Der eigene Dienst von GNOME Remote Desktop lauscht in jedem Netzwerk; installieren Sie wayland-vnc-grd, um das zu steuern"

