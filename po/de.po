#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), Authentifizierung %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d Aufnahme-/Eingabeschnittstelle(n)"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d Desktops"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s FEHLT und wird von diesem Desktop benötigt"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: nur dieser Computer. 0.0.0.0: jedes Netzwerk, mit dem dieser Computer verbunden ist, ohne weitere Absicherung. Ports bis einschließlich 1024 werden abgelehnt."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Eine native Wayland-Sitzung ist erforderlich; ein X11-Rückfall ist untersagt."

