msgstr "%s TRŪKSTA, o šiam darbalaukiui jo reikia"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: tik šis kompiuteris. 0.0.0.0: visi tinklai, prie kurių prijungtas šis kompiuteris, be jokios kitos apsaugos. 1024 ir žemesni prievadai atmetami."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Reikalingas savasis Wayland seansas; grįžimas prie X11 draudžiamas."

