msgstr "Próbáljon másik keresést."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Írja be ezeket a RealVNC Viewerbe a másik eszközön. A szem ikonnal megjelenítheti a jelenlegi jelszót. 600-as móddal tárolva."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Felhasználónév"

#: src/wayland_vnc/runtime.py
