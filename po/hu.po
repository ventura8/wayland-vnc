msgid "GNOME Screencast"
msgstr "GNOME képernyőközvetítés"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Általános"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "A RealVNC Viewerben adjon hozzá kapcsolatot ezen címek egyikéhez. Addig működnek, amíg a helyi hálózati hozzáférés be van kapcsolva, az azonos hálózaton lévő bármely eszköz számára. Ne továbbítsa a portot az internetről."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Telepítse a wayland-vnc csomagot a systemd felhasználói egység eléréséhez"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin és rögzítési/beviteli portálfelületek észlelve."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "A KWin mindkét portálfelületet igényli: ScreenCast és RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Gyorsbillentyűk"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Gyorsbillentyűk"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Nyelv"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Az azonos Wi-Fi- vagy LAN-hálózaton lévő eszközök csatlakozhatnak. Kikapcsolva: csak ez a számítógép."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licenc"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Helyi hálózati hozzáférés"

