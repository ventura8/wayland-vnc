msgid "Diagnostics"
msgstr "Diagnosztika"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Itt minden beállítás valódi konfigurációt vagy a telepített szolgáltatást módosítja."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Minden, amire ennek az asztalnak szüksége van; nincs telepítve: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop kiszolgáló"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "A GNOME Távoli asztal saját démona minden hálózaton figyel; telepítse a wayland-vnc-grd csomagot, hogy ezt szabályozhassa"

