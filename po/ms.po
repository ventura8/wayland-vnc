msgid "Status"
msgstr "Status"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Disimpan (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Disasarkan"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Tetingkap tetapan memerlukan GTK4 dan libadwaita (pasang python3-gi, gir1.2-gtk-4.0 dan gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Tetingkap tetapan memerlukan libadwaita %(needed)s atau lebih baharu; sistem ini mempunyai %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Tetingkap mengikut bahasa desktop anda melainkan anda memilih yang lain."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Desktop ini melayan VNC melalui GNOME Remote Desktop, yang menerima kata laluan paling banyak 8 aksara"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Bahagian belakang desktop ini sentiasa mendengar di komputer ini sahaja"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "Pelayan TigerVNC, untuk KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Cuba carian lain."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Taip ini dalam RealVNC Viewer pada peranti lain. Gunakan mata untuk mendedahkan kata laluan semasa. Disimpan dengan mod 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Nama pengguna"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Nama pengguna mestilah ASCII boleh cetak"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Keputusan"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Kelayakan pemapar"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Kata laluan pemapar disimpan"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "Pelayan WayVNC, untuk komposit wlroots"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Protokol Wayland"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Apa yang desktop ini umumkan, dan maksudnya untuk capaian jauh."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ya"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "semua rangkaian yang disambungkan dengan komputer ini"

#: src/wayland_vnc/settings_app.py
