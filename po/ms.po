#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), pengesahan %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d antara muka tangkapan/input"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d desktop"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s TIADA dan desktop ini memerlukannya"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: komputer ini sahaja. 0.0.0.0: semua rangkaian yang disambungkan dengan komputer ini, tanpa pagar lain. Port 1024 dan ke bawah ditolak."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Sesi Wayland asli diperlukan; kembali kepada X11 dilarang."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Perihal Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Alamat"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Diumumkan"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Semua ada"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Guna"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatik (ikut desktop)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Bahagian belakang"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Calon bahagian belakang"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Bahagian belakang pada desktop ini"

