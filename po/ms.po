msgid "Binaries"
msgstr "Fail binari"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Alamat dan port pendengaran"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Alamat dan port digunakan"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Batal"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Keputusan keupayaan"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Protokol tangkapan, papan kekunci maya dan penuding maya dikesan."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Tutup"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Konfigurasi"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Sahkan kata laluan"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Sambung daripada peranti lain"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Sambungkan mesin ini ke Wi-Fi atau Ethernet, kemudian buka semula"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Salin"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Fail kelayakan tiada nama pengguna atau kata laluan"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Desktop"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Perkhidmatan desktop"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostik"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Setiap pilihan di sini mengubah konfigurasi sebenar atau perkhidmatan yang dipasang."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Semua yang desktop ini perlukan; tidak dipasang: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Pelayan GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Daemon GNOME Desktop Jauh sendiri mendengar di semua rangkaian; pasang wayland-vnc-grd untuk mengawalnya"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Siaran skrin GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Umum"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Dalam RealVNC Viewer, tambah sambungan ke salah satu alamat ini. Ia berfungsi selagi akses rangkaian tempatan dihidupkan, untuk mana-mana peranti dalam rangkaian yang sama. Jangan majukan port dari Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Pasang pakej wayland-vnc untuk mendapatkan unit pengguna systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin dan antara muka portal tangkapan/input dikesan."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin memerlukan kedua-dua antara muka portal: ScreenCast dan RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Pintasan papan kekunci"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Pintasan papan kekunci"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Bahasa"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Benarkan peranti dalam Wi-Fi atau LAN yang sama bersambung. Mati: komputer ini sahaja."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Lesen"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Akses Rangkaian Tempatan"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Akses rangkaian tempatan dimatikan"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Akses rangkaian tempatan dihidupkan"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Menu utama"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Menjadikan desktop Wayland ini boleh dicapai daripada RealVNC Viewer pada telefon anda atau komputer lain. Ia hanya mendengar pada komputer ini sehingga anda menghidupkan Akses Rangkaian Tempatan."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Perkhidmatan tangkapan dan input jauh Mutter dikesan; binaan peribadi diperlukan."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Tidak"

