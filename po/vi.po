msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Hãy kết nối máy này với Wi-Fi hoặc Ethernet rồi mở lại"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Sao chép"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Tệp thông tin đăng nhập thiếu tên người dùng hoặc mật khẩu"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Màn hình nền"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Dịch vụ màn hình nền"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Chẩn đoán"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Mỗi tùy chọn ở đây đều thay đổi cấu hình thật hoặc dịch vụ đã cài."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Mọi thứ màn hình nền này cần; chưa cài: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "Máy chủ GNOME Remote Desktop"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Trình nền riêng của GNOME Màn hình từ xa lắng nghe trên mọi mạng; hãy cài đặt wayland-vnc-grd để kiểm soát điều này"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "Truyền màn hình GNOME"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Chung"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Trong RealVNC Viewer, thêm một kết nối tới một trong các địa chỉ này. Chúng hoạt động khi truy cập từ mạng cục bộ đang bật, cho mọi thiết bị trong cùng mạng. Đừng chuyển tiếp cổng từ Internet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Hãy cài gói wayland-vnc để có unit người dùng systemd"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Đã phát hiện KWin và các giao diện portal thu hình/nhập liệu."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin cần cả hai giao diện portal: ScreenCast và RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Phím tắt"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Phím tắt"

