#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), godkendelse %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d optagelses-/inputgrænseflader"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d skriveborde"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s MANGLER, og dette skrivebord har brug for det"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: kun denne computer. 0.0.0.0: alle netværk, som denne computer er forbundet til, uden anden afskærmning. Porte på 1024 og derunder afvises."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Der kræves en indbygget Wayland-session; tilbagefald til X11 er forbudt."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Om Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adresse"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Annonceret"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Alle til stede"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Anvend"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatisk (følg skrivebordet)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Backend"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Backend-kandidat"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Backend på dette skrivebord"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binære filer"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Lytteadresse og -port"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adresse og port anvendt"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Annullér"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Vurdering af funktioner"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Protokoller til optagelse, virtuelt tastatur og virtuel markør fundet."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Luk"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Konfiguration"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Bekræft adgangskode"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Forbind fra en anden enhed"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Forbind denne maskine til wi-fi eller ethernet, og åbn derefter igen"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopiér"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Filen med legitimationsoplysninger mangler et brugernavn eller en adgangskode"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Skrivebord"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Skrivebordstjenester"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostik"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Alle valg her ændrer reel konfiguration eller den installerede tjeneste."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Alt, hvad dette skrivebord kræver; ikke installeret: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop-server"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME Fjernskrivebords egen dæmon lytter på alle netværk; installér wayland-vnc-grd for at styre dette"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME-skærmoptagelse"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Generelt"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Tilføj i RealVNC Viewer en forbindelse til en af disse adresser. De virker, så længe adgang fra det lokale netværk er slået til, for enhver enhed på samme netværk. Videresend ikke porten fra internettet."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installér pakken wayland-vnc for at få systemd-brugerenheden"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin og portalgrænseflader til optagelse/input fundet."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin kræver begge portalgrænseflader: ScreenCast og RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Tastaturgenveje"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Tastaturgenveje"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Sprog"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Lad enheder på samme Wi-Fi eller LAN forbinde. Fra: kun denne computer."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licens"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Adgang fra lokalt netværk"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Adgang fra lokalt netværk slået fra"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Adgang fra lokalt netværk slået til"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Hovedmenu"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Gør dette Wayland-skrivebord tilgængeligt fra RealVNC Viewer på din telefon eller en anden computer. Den lytter kun på denne computer, indtil du slår Adgang fra lokalt netværk til."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter-tjenester til optagelse og fjerninput fundet; privat version kræves."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Nej"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Ingen resultater fundet"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Ingen lokal netværksadresse fundet"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Ingen understøttet backend"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Der er ikke installeret nogen oversættelser, så vinduet forbliver på engelsk."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "None"
msgstr "Ingen"

#: src/wayland_vnc/settings.py
msgid "None advertised"
msgstr "Ingen annonceret"

#: src/wayland_vnc/settings.py
msgid "None available"
msgstr "Ingen tilgængelige"

#: src/wayland_vnc/settings.py
msgid "None checked"
msgstr "Ingen kontrolleret"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "None detected"
msgstr "Ingen fundet"

#: src/wayland_vnc/settings.py
msgid "Not advertised"
msgstr "Ikke annonceret"

#: src/wayland_vnc/settings.py
msgid "Not checked"
msgstr "Ikke kontrolleret"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Not installed"
msgstr "Ikke installeret"

#: src/wayland_vnc/settings_app.py
msgid "Not provisioned"
msgstr "Ikke klargjort"

#: src/wayland_vnc/settings_app.py
msgid "Not set"
msgstr "Ikke angivet"

#: src/wayland_vnc/settings_app.py
msgid "Open the main menu"
msgstr "Åbn hovedmenuen"

#: src/wayland_vnc/settings_app.py
msgid "PUBLIC ADDRESS - reachable beyond the local network"
msgstr "OFFENTLIG ADRESSE - kan nås uden for det lokale netværk"

#: src/wayland_vnc/settings_dialogs.py
msgid "Password"
msgstr "Adgangskode"

#: src/wayland_vnc/runtime.py
msgid "Password must be 6-64 ASCII characters"
msgstr "Adgangskoden skal være 6-64 ASCII-tegn"

#: src/wayland_vnc/settings_dialogs.py src/wayland_vnc/runtime.py
msgid "Passwords did not match"
msgstr "Adgangskoderne stemte ikke overens"

#: src/wayland_vnc/settings_dialogs.py
msgid "Port"
msgstr "Port"

#: src/wayland_vnc/runtime.py
msgid "Port must be an unprivileged TCP port"
msgstr "Porten skal være en ikke-privilegeret TCP-port"

#: src/wayland_vnc/settings.py
msgid "Portals"
msgstr "Portaler"

#: src/wayland_vnc/settings_dialogs.py
msgid "Project Website"
msgstr "Projektets websted"

#: src/wayland_vnc/settings_app.py
msgid "Quit"
msgstr "Afslut"

#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Klar til installation"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, en klient; ikke nødvendig for at servere"

#: src/wayland_vnc/settings.py
msgid "Reason"
msgstr "Årsag"

#: src/wayland_vnc/settings.py
msgid "Release Targets"
msgstr "Udgivelsesmål"

#: src/wayland_vnc/settings.py
msgid "RemoteDesktop Portal"
msgstr "RemoteDesktop-portal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Report an Issue"
msgstr "Rapportér et problem"

#: src/wayland_vnc/probe.py
msgid "Required capture AND input capabilities were not detected."
msgstr "De krævede optagelses- OG inputfunktioner blev ikke fundet."

#: src/wayland_vnc/settings_app.py
msgid "Running Now"
msgstr "Kører nu"

#: src/wayland_vnc/settings_dialogs.py
msgid "Save"
msgstr "Gem"

#: src/wayland_vnc/settings.py
msgid "ScreenCast Portal"
msgstr "ScreenCast-portal"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search"
msgstr "Søg"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search diagnostics"
msgstr "Søg i diagnostik"

#: src/wayland_vnc/settings_dialogs.py
msgid "Search languages"
msgstr "Søg efter sprog"

#: src/wayland_vnc/settings_app.py
msgid "Served by GNOME Remote Desktop VNC (port 5900); exposure follows GNOME Settings > Sharing"
msgstr "Leveres af GNOME Remote Desktop VNC (port 5900); eksponering følger GNOME Indstillinger > Deling"

#: src/wayland_vnc/settings_app.py
msgid "Server Configuration"
msgstr "Serverkonfiguration"

#: src/wayland_vnc/settings_app.py
msgid "Service"
msgstr "Tjeneste"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Session"
msgstr "Session"

#: src/wayland_vnc/settings.py
msgid "Session Type"
msgstr "Sessionstype"

#: src/wayland_vnc/settings_app.py
msgid "Set Password"
msgstr "Angiv adgangskode"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Set Viewer Password"
msgstr "Angiv fremviseradgangskode"

#: src/wayland_vnc/settings.py
msgid "Set a viewer password first"
msgstr "Angiv først en fremviseradgangskode"

#: src/wayland_vnc/settings_app.py
msgid "Start at Login"
msgstr "Start ved login"

#: src/wayland_vnc/settings_app.py
msgid "Status"
msgstr "Status"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Gemt (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Målrettet"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Indstillingsvinduet kræver GTK4 og libadwaita (installér python3-gi, gir1.2-gtk-4.0 og gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Indstillingsvinduet kræver libadwaita %(needed)s eller nyere; dette system har %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Vinduet følger dit skrivebords sprog, medmindre du vælger et andet."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Dette skrivebord serverer VNC via GNOME Remote Desktop, som accepterer adgangskoder på højst 8 tegn"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Dette skrivebords backend lytter altid kun på denne computer"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC-server, til KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Prøv en anden søgning."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Indtast disse i RealVNC Viewer på den anden enhed. Brug øjet til at vise den nuværende adgangskode. Gemt med tilstand 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Brugernavn"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Brugernavnet skal være udskrivbart ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Vurdering"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Fremviserens legitimationsoplysninger"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Fremviseradgangskode gemt"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC-server, til wlroots-kompositorer"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland-protokoller"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Hvad dette skrivebord annoncerer, og hvad det betyder for fjernadgang."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Ja"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "alle netværk, som denne computer er forbundet til"

#: src/wayland_vnc/settings_app.py
msgid "local network only"
msgstr "kun lokalt netværk"

#: src/wayland_vnc/settings.py
msgid "mDNS name"
msgstr "mDNS-navn"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "mode %s (too open)"
msgstr "tilstand %s (for åben)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "tilstand 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "kun denne maskine"

#: src/wayland_vnc/settings.py
msgid "unit is not installed"
msgstr "enheden er ikke installeret"

#: src/wayland_vnc/settings.py
msgid "unknown"
msgstr "ukendt"

#: src/wayland_vnc/settings.py
msgid "used to probe Wayland protocols"
msgstr "bruges til at undersøge Wayland-protokoller"

#: src/wayland_vnc/settings.py
