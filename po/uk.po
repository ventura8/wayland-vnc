#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), автентифікація %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "Інтерфейсів захоплення/введення: %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "Стільниць: %d"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s ВІДСУТНІЙ, а цій стільниці він потрібен"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: лише цей комп’ютер. 0.0.0.0: усі мережі, до яких під’єднано цей комп’ютер, без жодного іншого захисту. Порти 1024 і нижче відхиляються."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Потрібен рідний сеанс Wayland; повернення до X11 заборонено."

