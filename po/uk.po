msgid "About Wayland VNC"
msgstr "Про Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Адреса"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Оголошено"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Усі наявні"

