#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), provjera %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d sučelja za snimanje/unos"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d radnih površina"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s NEDOSTAJE, a ova radna površina ga treba"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: samo ovo računalo. 0.0.0.0: sve mreže na koje je ovo računalo spojeno, bez ikakve druge zaštite. Portovi 1024 i niži se odbijaju."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "Potrebna je izvorna Wayland sesija; povratak na X11 je zabranjen."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "O programu Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adresa"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Objavljeno"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Sve prisutno"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Primijeni"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Automatski (prema radnoj površini)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Pozadinski sustav"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Kandidat za pozadinski sustav"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Pozadinski sustav na ovoj radnoj površini"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binarne datoteke"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Adresa i priključak za slušanje"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adresa i priključak primijenjeni"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Odustani"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Procjena mogućnosti"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Otkriveni protokoli za snimanje, virtualnu tipkovnicu i virtualni pokazivač."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Zatvori"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Konfiguracija"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Potvrdi lozinku"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Poveži se s drugog uređaja"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Povežite ovo računalo na Wi-Fi ili Ethernet, zatim ponovno otvorite"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopiraj"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "U datoteci vjerodajnica nedostaje korisničko ime ili lozinka"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Radna površina"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Usluge radne površine"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Dijagnostika"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Svaka opcija ovdje mijenja stvarnu konfiguraciju ili instaliranu uslugu."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Sve što ova radna površina treba; nije instalirano: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop poslužitelj"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "Vlastiti demon GNOME Udaljene radne površine osluškuje na svim mrežama; instalirajte wayland-vnc-grd kako biste to kontrolirali"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME emitiranje zaslona"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Općenito"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "U RealVNC Vieweru dodajte vezu na jednu od ovih adresa. Rade dok je pristup iz lokalne mreže uključen, za svaki uređaj na istoj mreži. Ne prosljeđujte port s Interneta."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Instalirajte paket wayland-vnc kako biste dobili systemd korisničku jedinicu"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "Otkriveni KWin i sučelja portala za snimanje/unos."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin zahtijeva oba portalna sučelja: ScreenCast i RemoteDesktop."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Tipkovnički prečaci"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Tipkovnički prečaci"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Jezik"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Dopusti uređajima na istoj Wi-Fi ili LAN mreži da se povežu. Isključeno: samo ovo računalo."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Licenca"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Pristup iz lokalne mreže"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Pristup iz lokalne mreže je isključen"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Pristup iz lokalne mreže je uključen"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Glavni izbornik"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Čini ovu Wayland radnu površinu dostupnom iz RealVNC Viewera na vašem telefonu ili drugom računalu. Sluša samo na ovom računalu dok ne uključite Pristup iz lokalne mreže."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Otkrivene Mutter usluge snimanja i udaljenog unosa; potrebna je privatna izgradnja."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Ne"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Nema rezultata"

#: src/wayland_vnc/settings_app.py
msgid "No local network address found"
msgstr "Nije pronađena adresa lokalne mreže"

#: src/wayland_vnc/settings.py
msgid "No supported backend"
msgstr "Nema podržanog pozadinskog sustava"

#: src/wayland_vnc/settings_app.py
msgid "No translations are installed, so the window stays in English."
msgstr "Nema instaliranih prijevoda, pa prozor ostaje na engleskom."

