#: src/wayland_vnc/settings.py
msgid "Ready to Install"
msgstr "Spremno za instalaciju"

#: src/wayland_vnc/settings.py
msgid "RealVNC Viewer, a client; not needed to serve"
msgstr "RealVNC Viewer, klijent; nije potreban za posluživanje"

