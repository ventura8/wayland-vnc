msgstr "način %s (previše otvoren)"

#: src/wayland_vnc/settings_app.py
msgid "mode 600"
msgstr "način 600"

#: src/wayland_vnc/settings_app.py
msgid "this machine only"
msgstr "samo ovo računalo"

#: src/wayland_vnc/settings.py
