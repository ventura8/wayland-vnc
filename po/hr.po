msgstr "Stanje"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Spremljeno (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Ciljano"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Prozor postavki treba GTK4 i libadwaita (instalirajte python3-gi, gir1.2-gtk-4.0 i gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Prozor postavki treba libadwaita %(needed)s ili noviji; ovaj sustav ima %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Prozor slijedi jezik vaše radne površine, osim ako ne odaberete drugi."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Ova radna površina poslužuje VNC preko GNOME Remote Desktopa, koji prihvaća lozinke od najviše 8 znakova"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Pozadinski sustav ove radne površine uvijek osluškuje samo na ovom računalu"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC poslužitelj, za KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Pokušajte drugačiju pretragu."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Upišite ovo u RealVNC Viewer na drugom uređaju. Okom prikažite trenutnu lozinku. Spremljeno s načinom 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Korisničko ime"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Korisničko ime mora biti ispisivi ASCII"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Procjena"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Vjerodajnice preglednika"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Lozinka preglednika spremljena"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC poslužitelj, za wlroots kompozitore"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland protokoli"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Što ova radna površina objavljuje i što to znači za udaljeni pristup."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "Yes"
msgstr "Da"

#: src/wayland_vnc/settings_app.py
msgid "every network this computer is on"
msgstr "sve mreže na koje je ovo računalo spojeno"

