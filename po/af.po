#: src/wayland_vnc/settings_app.py
#, python-format
msgid "%(address)s:%(port)s (%(scope)s), auth %(auth)s"
msgstr "%(address)s:%(port)s (%(scope)s), verifikasie %(auth)s"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d capture/input interface(s)"
msgstr "%d vaslegging-/toevoerkoppelvlakke"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%d desktops"
msgstr "%d werkskerms"

#: src/wayland_vnc/settings.py
#, python-format
msgid "%s is MISSING and this desktop needs it"
msgstr "%s ONTBREEK en hierdie werkskerm het dit nodig"

#: src/wayland_vnc/settings_dialogs.py
msgid "127.0.0.1: this computer only. 0.0.0.0: every network this computer is on, with no other fence. Ports at or below 1024 are refused."
msgstr "127.0.0.1: net hierdie rekenaar. 0.0.0.0: elke netwerk waaraan hierdie rekenaar gekoppel is, sonder enige ander beskerming. Poorte 1024 en laer word geweier."

#: src/wayland_vnc/probe.py
msgid "A native Wayland session is required; X11 fallback is prohibited."
msgstr "'n Inheemse Wayland-sessie is vereis; terugval na X11 is verbode."

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "About Wayland VNC"
msgstr "Aangaande Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "Address"
msgstr "Adres"

#: src/wayland_vnc/settings.py
msgid "Advertised"
msgstr "Aangekondig"

#: src/wayland_vnc/settings.py
msgid "All present"
msgstr "Almal teenwoordig"

#: src/wayland_vnc/settings_dialogs.py
msgid "Apply"
msgstr "Pas toe"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Automatic (match the desktop)"
msgstr "Outomaties (volg die werkskerm)"

#: src/wayland_vnc/settings_app.py
msgid "Backend"
msgstr "Agterkant"

#: src/wayland_vnc/settings.py
msgid "Backend Candidate"
msgstr "Kandidaat-agterkant"

#: src/wayland_vnc/settings_dialogs.py
msgid "Backend on This Desktop"
msgstr "Agterkant op hierdie werkskerm"

#: src/wayland_vnc/settings.py
msgid "Binaries"
msgstr "Binêre lêers"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Bind Address and Port"
msgstr "Luisteradres en -poort"

#: src/wayland_vnc/settings_app.py
msgid "Bind address and port applied"
msgstr "Adres en poort toegepas"

#: src/wayland_vnc/settings_dialogs.py
msgid "Cancel"
msgstr "Kanselleer"

#: src/wayland_vnc/settings_app.py
msgid "Capability Verdict"
msgstr "Vermoëbevinding"

#: src/wayland_vnc/probe.py
msgid "Capture, virtual keyboard, and virtual pointer protocols detected."
msgstr "Vaslegging-, virtuele sleutelbord- en virtuele wyserprotokolle bespeur."

#: src/wayland_vnc/settings_dialogs.py
msgid "Close"
msgstr "Sluit"

#: src/wayland_vnc/settings_app.py
msgid "Configuration"
msgstr "Konfigurasie"

#: src/wayland_vnc/settings_dialogs.py
msgid "Confirm Password"
msgstr "Bevestig wagwoord"

#: src/wayland_vnc/settings_app.py
msgid "Connect from Another Device"
msgstr "Koppel vanaf 'n ander toestel"

#: src/wayland_vnc/settings_app.py
msgid "Connect this machine to Wi-Fi or Ethernet, then reopen"
msgstr "Koppel hierdie masjien aan Wi-Fi of Ethernet en maak weer oop"

#: src/wayland_vnc/settings_app.py
msgid "Copy"
msgstr "Kopieer"

#: src/wayland_vnc/runtime.py
msgid "Credentials file is missing a username or password"
msgstr "Die geloofsbriewelêer kort 'n gebruikersnaam of wagwoord"

#: src/wayland_vnc/settings.py
msgid "Desktop"
msgstr "Werkskerm"

#: src/wayland_vnc/settings.py
msgid "Desktop Services"
msgstr "Werkskermdienste"

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_dialogs.py
msgid "Diagnostics"
msgstr "Diagnostiek"

#: src/wayland_vnc/settings_app.py
msgid "Every option here changes real configuration or the installed service."
msgstr "Elke opsie hier verander werklike konfigurasie of die geïnstalleerde diens."

#: src/wayland_vnc/settings.py
msgid "Everything this desktop needs; not installed: "
msgstr "Alles wat hierdie werkskerm nodig het; nie geïnstalleer nie: "

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop server"
msgstr "GNOME Remote Desktop-bediener"

#: src/wayland_vnc/settings.py
msgid "GNOME Remote Desktop's own daemon listens on every network; install wayland-vnc-grd to control this"
msgstr "GNOME Afgeleë werkskerm se eie daemon luister op elke netwerk; installeer wayland-vnc-grd om dit te beheer"

#: src/wayland_vnc/settings.py
msgid "GNOME Screencast"
msgstr "GNOME-skermuitsending"

#: src/wayland_vnc/settings_app.py
msgid "General"
msgstr "Algemeen"

#: src/wayland_vnc/settings_app.py
msgid "In RealVNC Viewer, add a connection to one of these. They work while local network access is on, for any device on the same network. Do not forward the port from the Internet."
msgstr "Voeg in RealVNC Viewer 'n verbinding na een van hierdie adresse by. Hulle werk solank toegang vanaf die plaaslike netwerk aan is, vir enige toestel op dieselfde netwerk. Moenie die poort vanaf die internet aanstuur nie."

#: src/wayland_vnc/settings.py
msgid "Install the wayland-vnc package to get the systemd user unit"
msgstr "Installeer die wayland-vnc-pakket om die systemd-gebruikerseenheid te kry"

#: src/wayland_vnc/probe.py
msgid "KWin and capture/input portal interfaces detected."
msgstr "KWin en die vaslegging-/toevoerportaalkoppelvlakke bespeur."

#: src/wayland_vnc/probe.py
msgid "KWin requires both ScreenCast and RemoteDesktop portal interfaces."
msgstr "KWin vereis beide die ScreenCast- en RemoteDesktop-portaalkoppelvlakke."

#: src/wayland_vnc/settings_app.py
msgid "Keyboard Shortcuts"
msgstr "Sleutelbordkortpaaie"

#: src/wayland_vnc/settings_app.py
msgid "Keyboard shortcuts"
msgstr "Sleutelbordkortpaaie"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Language"
msgstr "Taal"

#: src/wayland_vnc/settings_app.py
msgid "Let devices on the same Wi-Fi or LAN connect. Off: this computer only."
msgstr "Laat toestelle op dieselfde Wi-Fi of LAN koppel. Af: net hierdie rekenaar."

#: src/wayland_vnc/settings_dialogs.py
msgid "License"
msgstr "Lisensie"

#: src/wayland_vnc/settings.py
msgid "Local Network Access"
msgstr "Toegang vanaf plaaslike netwerk"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned off"
msgstr "Toegang vanaf plaaslike netwerk afgeskakel"

#: src/wayland_vnc/settings_app.py
msgid "Local network access turned on"
msgstr "Toegang vanaf plaaslike netwerk aangeskakel"

#: src/wayland_vnc/settings_app.py
msgid "Main Menu"
msgstr "Hoofkieslys"

#: src/wayland_vnc/settings_dialogs.py
msgid "Makes this Wayland desktop reachable from RealVNC Viewer on your phone or another computer. It listens on this computer only until you turn on Local Network Access."
msgstr "Maak hierdie Wayland-werkskerm bereikbaar vanaf RealVNC Viewer op u foon of 'n ander rekenaar. Dit luister slegs op hierdie rekenaar totdat u Toegang vanaf plaaslike netwerk aanskakel."

#: src/wayland_vnc/probe.py
msgid "Mutter capture and remote-input services detected; private build required."
msgstr "Mutter se vaslegging- en afstandtoevoerdienste bespeur; 'n private bou is vereis."

#: src/wayland_vnc/settings.py src/wayland_vnc/settings_app.py
msgid "No"
msgstr "Nee"

#: src/wayland_vnc/settings_dialogs.py
msgid "No Results Found"
msgstr "Geen resultate gevind nie"

