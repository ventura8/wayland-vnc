msgstr "Status"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "Stored (%s)"
msgstr "Gestoor (%s)"

#: src/wayland_vnc/settings.py
msgid "Targeted"
msgstr "Geteiken"

#: src/wayland_vnc/settings_app.py
msgid "The settings window needs GTK4 and libadwaita (install python3-gi, gir1.2-gtk-4.0 and gir1.2-adw-1)"
msgstr "Die instellingsvenster benodig GTK4 en libadwaita (installeer python3-gi, gir1.2-gtk-4.0 en gir1.2-adw-1)"

#: src/wayland_vnc/settings_app.py
#, python-format
msgid "The settings window needs libadwaita %(needed)s or newer; this system has %(found)s"
msgstr "Die instellingsvenster benodig libadwaita %(needed)s of nuwer; hierdie stelsel het %(found)s"

#: src/wayland_vnc/settings_app.py
msgid "The window follows your desktop's language unless you choose another."
msgstr "Die venster volg u werkskerm se taal tensy u 'n ander kies."

#: src/wayland_vnc/runtime.py
msgid "This desktop serves VNC through GNOME Remote Desktop, which accepts passwords of at most 8 characters"
msgstr "Hierdie lessenaar bedien VNC deur GNOME Remote Desktop, wat wagwoorde van hoogstens 8 karakters aanvaar"

#: src/wayland_vnc/settings.py
msgid "This desktop's backend always listens on this computer only"
msgstr "Hierdie werkskerm se agterkant luister altyd net op hierdie rekenaar"

#: src/wayland_vnc/settings.py
msgid "TigerVNC server, for KDE Plasma"
msgstr "TigerVNC-bediener, vir KDE Plasma"

#: src/wayland_vnc/settings_dialogs.py
msgid "Try a different search."
msgstr "Probeer 'n ander soektog."

#: src/wayland_vnc/settings_dialogs.py
msgid "Type these into RealVNC Viewer on the other device. Use the eye to reveal the current password. Stored with mode 600."
msgstr "Tik dit in RealVNC Viewer op die ander toestel in. Gebruik die oog om die huidige wagwoord te wys. Gestoor met modus 600."

#: src/wayland_vnc/settings_dialogs.py
msgid "Username"
msgstr "Gebruikersnaam"

#: src/wayland_vnc/runtime.py
msgid "Username must be printable ASCII"
msgstr "Die gebruikersnaam moet drukbare ASCII wees"

#: src/wayland_vnc/settings.py
msgid "Verdict"
msgstr "Bevinding"

#: src/wayland_vnc/settings_app.py src/wayland_vnc/settings_dialogs.py
msgid "Viewer Credential"
msgstr "Kykergeloofsbriewe"

#: src/wayland_vnc/settings_app.py
msgid "Viewer password saved"
msgstr "Kykerwagwoord gestoor"

#: src/wayland_vnc/settings.py
msgid "WayVNC server, for wlroots compositors"
msgstr "WayVNC-bediener, vir wlroots-samestellers"

#: src/wayland_vnc/settings.py
msgid "Wayland Protocols"
msgstr "Wayland-protokolle"

#: src/wayland_vnc/settings_dialogs.py
msgid "Wayland VNC"
msgstr "Wayland VNC"

#: src/wayland_vnc/settings_dialogs.py
msgid "What this desktop advertises, and what it means for remote access."
msgstr "Wat hierdie werkskerm aankondig, en wat dit vir afstandtoegang beteken."

