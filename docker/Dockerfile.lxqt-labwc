FROM ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78
# Development fixture only; package snapshot locking is required before qualification.
RUN apt-get update && apt-get install -y --no-install-recommends \
adwaita-icon-theme dbus-daemon dbus-user-session fonts-dejavu-core gir1.2-gtk-4.0 labwc \
    libgl1-mesa-dri lxqt-panel lxqt-session lxqt-themes lxqt-wayland-session openssl python3 \
    python3-cairo python3-gi python3-gi-cairo qt6-wayland swaylock wayland-utils wayvnc wlr-randr \
    && rm -rf /var/lib/apt/lists/* \
    && usermod --login fixture --home /home/fixture --move-home ubuntu \
    && groupmod --new-name fixture ubuntu \
    && install -d -m 700 -o fixture -g fixture /tmp/wayland-vnc-runtime \
    && chown root:fixture /etc/shadow && chmod 660 /etc/shadow
COPY tests/fixtures /fixture
COPY src/wayland_vnc /fixture/wayland_vnc
# Ubuntu's labwc depends on xwayland and exits without an Xwayland executable, so the
# real binary is replaced by a fail-closed stub: lazy XWayland can never start an X server.
# startlxqtwayland reads the compositor choice from session.conf (labwc, as a user would
# select in Session Settings) and lxqt-session starts the scene through XDG autostart.
RUN install -m 755 /fixture/labwc/Xwayland-disabled /usr/bin/Xwayland \
    && install -m 644 /fixture/autostart/wayland-vnc-scene.desktop /etc/xdg/autostart/ \
    && install -d -m 700 -o fixture -g fixture /home/fixture/.config /home/fixture/.config/lxqt \
    && install -m 644 -o fixture -g fixture /fixture/lxqt/session.conf \
    /home/fixture/.config/lxqt/session.conf
USER fixture
ENV XDG_RUNTIME_DIR=/tmp/wayland-vnc-runtime HOME=/home/fixture \
    XDG_SESSION_TYPE=wayland WLR_BACKENDS=headless WLR_RENDERER=pixman \
    WLR_LIBINPUT_NO_DEVICES=1 GDK_BACKEND=wayland GSK_RENDERER=cairo \
    GTK_A11Y=none QT_QPA_PLATFORM=wayland FIXTURE_COMPOSITOR=lxqt-labwc
ENTRYPOINT ["dbus-run-session", "--", "python3", "/fixture/sway-session.py"]
