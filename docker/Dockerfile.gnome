# Development fixture only; package snapshot locking is required before qualification.
# Stage 1 builds the private LibVNCServer and the patched GNOME Remote Desktop VNC daemon
# from the checksum-verified archives pinned in sources.json, applying the project's
# ordered patch series with zero fuzz. Nothing is installed into the distribution paths.
FROM ubuntu:26.04@sha256:cd21a4f68a617580279d4b091cb18e3af9fa8a87500665f0ae5f7f757d17d367 AS grd-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils patch cmake meson ninja-build gcc make pkg-config zlib1g-dev libjpeg-dev \
    libpng-dev libglib2.0-dev libpipewire-0.3-dev libcairo2-dev libdrm-dev libepoxy-dev \
    libei-dev libnotify-dev libsecret-1-dev libkrb5-dev libtss2-dev libxkbcommon-dev libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/*
COPY patches /patches
# The encoding-parser regression test runs here, against the freshly patched library,
# under the same sanitizers as the rest of the native gate: this stage is the only
# place the private LibVNCServer build exists, so it is the only place it can run.
COPY tests/native/test-encoding.c /build/tests/native/test-encoding.c
COPY scripts/test-encoding.sh /build/scripts/test-encoding.sh
# 1 only when this image is built for another architecture under qemu-user, where
# LeakSanitizer cannot run (scripts/test-encoding.sh); native builds leave it 0.
ARG WAYLAND_VNC_EMULATED=0
ENV WAYLAND_VNC_EMULATED=${WAYLAND_VNC_EMULATED}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /build/libvnc
RUN curl -fsSL -o /tmp/libvncserver.tar.gz \
    https://codeload.github.com/LibVNC/libvncserver/tar.gz/refs/tags/LibVNCServer-0.9.15 \
    && echo "62352c7795e231dfce044beb96156065a05a05c974e5de9e023d688d8ff675d7  /tmp/libvncserver.tar.gz" \
    | sha256sum -c - \
    && tar xzf /tmp/libvncserver.tar.gz --strip-components=1 -C /build/libvnc \
    && for p in /patches/libvncserver/*.patch; do patch --batch --forward --fuzz=0 -p1 -i "$p"; done \
    && cmake -G Ninja -S . -B out -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_SHARED_LIBS=ON \
    -DWITH_EXAMPLES=OFF -DWITH_TESTS=OFF -DWITH_GNUTLS=OFF -DWITH_OPENSSL=OFF -DWITH_SDL=OFF \
    -DWITH_GTK=OFF -DWITH_FFMPEG=OFF -DWITH_SYSTEMD=OFF -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/wayland-vnc/libvnc \
    && cmake --build out -j "$(nproc)" && cmake --install out \
    && bash /build/scripts/test-encoding.sh /build/libvnc /build/libvnc/out
WORKDIR /build/grd
RUN curl -fsSL -o /tmp/grd.tar.xz \
    https://download.gnome.org/sources/gnome-remote-desktop/50/gnome-remote-desktop-50.2.tar.xz \
    && echo "31df628f4113573f136ffc8dc001763aed633cd85bed21e58bc61f8a17df091f  /tmp/grd.tar.xz" \
    | sha256sum -c - \
    && tar xJf /tmp/grd.tar.xz --strip-components=1 -C /build/grd \
    && for p in /patches/gnome-remote-desktop/*.patch; do patch --batch --forward --fuzz=0 -p1 -i "$p"; done \
    && PKG_CONFIG_PATH=/opt/wayland-vnc/libvnc/lib/pkgconfig meson setup out \
    -Dvnc=true -Drdp=false -Dman=false -Dtests=false -Dsystemd=false \
    --prefix=/opt/wayland-vnc/grd -Dc_link_args=-Wl,-rpath,/opt/wayland-vnc/libvnc/lib \
    && meson compile -C out && meson install -C out \
    && glib-compile-schemas /opt/wayland-vnc/grd/share/glib-2.0/schemas

# Stage 2: real headless GNOME Shell (Mutter virtual monitor, software rendering),
# PipeWire, and the private daemon. No GPU, no X11, no host desktop access.
FROM ubuntu:26.04@sha256:cd21a4f68a617580279d4b091cb18e3af9fa8a87500665f0ae5f7f757d17d367
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnome-shell mutter pipewire wireplumber gsettings-desktop-schemas libglib2.0-bin \
    libpipewire-0.3-0t64 libei1 libnotify4 libsecret-1-0 libtss2-esys-3.0.2-0t64 \
    libtss2-mu-4.0.1-0t64 libtss2-rc0t64 libtss2-tctildr0t64 libkrb5-3 libepoxy0 libdrm2 \
    libcairo2 libxkbcommon0 libjpeg8 libpng16-16t64 zlib1g \
    dbus-daemon dbus-user-session python3 python3-gi python3-cairo python3-gi-cairo \
    gir1.2-gtk-4.0 libgl1-mesa-dri fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && usermod --login fixture --home /home/fixture --move-home ubuntu \
    && groupmod --new-name fixture ubuntu \
    && install -d -m 700 -o fixture -g fixture /tmp/wayland-vnc-runtime
COPY --from=grd-build /opt/wayland-vnc /opt/wayland-vnc
COPY tests/fixtures /fixture
COPY src/wayland_vnc /fixture/wayland_vnc
# Xwayland is replaced by the fail-closed stub; the shell is started with --no-x11.
# Without /run/systemd the shell uses its non-systemd login manager instead of
# requiring logind on a system bus that an isolated container does not have.
RUN install -m 755 /fixture/labwc/Xwayland-disabled /usr/bin/Xwayland \
    && rm -rf /run/systemd
USER fixture
ENV XDG_RUNTIME_DIR=/tmp/wayland-vnc-runtime HOME=/home/fixture LANG=C.UTF-8 \
    XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=GNOME GSETTINGS_BACKEND=keyfile \
    GSETTINGS_SCHEMA_DIR=/opt/wayland-vnc/grd/share/glib-2.0/schemas \
    GDK_BACKEND=wayland GSK_RENDERER=cairo GTK_A11Y=none FIXTURE_COMPOSITOR=gnome
ENTRYPOINT ["dbus-run-session", "--", "python3", "/fixture/gnome-session.py"]
