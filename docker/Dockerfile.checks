FROM ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78
# Bootstrap image only; release publication requires a resolved digest and locked packages.
# Package snapshot locking is a release blocker, not a lint exception for release images.
RUN apt-get update && apt-get install -y --no-install-recommends \
ca-certificates gcc git libc6-dev python3 python3-coverage python3-jsonschema python3-pil \
    python3-pip python3-pytest python3-venv shellcheck shfmt systemd \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /project
COPY . .
CMD ["bash", "scripts/build-and-test.sh", "--unit"]
